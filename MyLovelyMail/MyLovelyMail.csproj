<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- SkipAndroidTargets=true drops the Android target framework here and in MainProject. A Windows
         publish passes -r win-x64, a global property, and restore evaluates every target framework with it:
         the Android one, which runs on Mono, then asks NuGet for Microsoft.NETCore.App.Runtime.Mono.win-x64,
         which .NET 10 does not publish, and the Windows publish fails with NU1102. -->
    <TargetFrameworks Condition="'$(SkipAndroidTargets)' != 'true'">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>


    <OutputType>Exe</OutputType>
    <RootNamespace>MyLovelyMail</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>

    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>MyLovelyMail</ApplicationTitle>

    <ApplicationId>com.muhammetozeski.mylovelymail</ApplicationId>

    <!-- Follows the one <Version> in Directory.Build.props. A hard-coded 1.0 here overrode it for the MAUI head only, so MainProject.dll shipped as 1.38.0 - the assembly the settings footer reads - while the exe own Windows file properties still said 1.0. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <!-- Static web asset compression is not used by Blazor Hybrid (loads directly from disk) -->
    <EnableDefaultCompressionFormats>false</EnableDefaultCompressionFormats>
    <PublishCompressionFormats></PublishCompressionFormats>
    <DisableBuildCompression>true</DisableBuildCompression>
  </PropertyGroup>

  <!-- The exe/taskbar/window icon on Windows reuses the same lovely-mail icon as the tray, instead
       of the auto-generated icon from the (still default-purple) MauiIcon SVGs below. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ApplicationIcon>Resources\Raw\trayicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" />

    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#1E1428" BaseSize="128,128" />

    <MauiImage Include="Resources\Images\*" />

    <MauiFont Include="Resources\Fonts\*" />

    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icon is a Windows-only concern; other targets must not restore it. -->
    <PackageReference Include="H.NotifyIcon.Maui" Version="2.4.1" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MainProject\MainProject.csproj" />
  </ItemGroup>

  <!-- =========================================================================================
       MANUEL DAĞITIM FİLTRELERİ (BOYUT VE TEMİZLİK OPTİMİZASYONU)
       
       DİKKAT (AI AJANLARI VE GELİŞTİRİCİLER İÇİN ZORUNLU KURAL):
       Aşağıdaki filtreler, uygulamada doğrudan kullanılmayan monolitik Windows App SDK,
       hata ayıklama/çökme araçları, mağaza (MSIX) varyasyonları ve gereksiz varlıkların
       dağıtım boyutunu ~25 MB küçültmek amacıyla manuel olarak eklenmiştir.
       
       - Bir sorun veya beklenmedik çalışma zamanı hatası oluşması halinde, KULLANICIYA AÇIKÇA
         SÖYLEMEK ŞARTIYLA buradaki kurallar geri alınabilir.
       - Sorunun kesin olarak buradan kaynaklandığından şüphelenilmiyorsa AI ajanı bu kuralları
         KESİNLİKLE kaldırmamalıdır.
       - Bir kural devre dışı bırakılacaksa kuralı SİLMEK YASAKTIR; silmek yerine XML yorum
         etiketi içine alınmalıdır.
       ========================================================================================= -->
  <Target Name="FilterUnwantedPublishFiles" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- 1. Uydu Dil ve Yerelleştirme Dosyaları (MUI & resources.dll) -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.mui'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)' == 'Microsoft.Maui.Controls.resources'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.dll' and $([System.String]::Copy('%(FileName)').EndsWith('.resources'))" />

      <!-- 2. Hata Ayıklama, Profilleme ve Çökme Dökümü Araçları (PDB'ler hariç bırakılmıştır, PDB'ler korunur) -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)%(Extension)' == 'createdump.exe'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)%(Extension)' == 'mscordbi.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)%(Extension)' == 'mscordaccore.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.dll' and $([System.String]::Copy('%(FileName)').StartsWith('mscordaccore_'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)%(Extension)' == 'clrgcexp.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)%(Extension)' == 'clretwrc.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)%(Extension)' == 'Microsoft.DiaSymReader.Native.amd64.dll'" />

      <!-- 3. Kullanılmayan Windows Copilot+ / Windows AI Kütüphaneleri ve İş Yükleri -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.dll' and $([System.String]::Copy('%(FileName)').StartsWith('Microsoft.Windows.AI.'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.dll' and $([System.String]::Copy('%(FileName)').StartsWith('Microsoft.Windows.Workloads'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.json' and $([System.String]::Copy('%(FileName)').StartsWith('workloads'))" />

      <!-- 4. Kullanılmayan Windows 11 Widget Panosu Bileşenleri -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.dll' and $([System.String]::Copy('%(FileName)').StartsWith('Microsoft.Windows.Widgets'))" />

      <!-- 5. MAUI Resizetizer MSIX Mağaza ve Döşeme Görsel Varyasyonları (Paketlenmemiş Masaüstü Exe İçin Gereksiz) -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)%(Extension)' == 'appicon.ico'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(FileName)%(Extension)' == 'WindowsAppRuntime.png'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.png' and $([System.String]::Copy('%(FileName)').StartsWith('appiconLargeTile.'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.png' and $([System.String]::Copy('%(FileName)').StartsWith('appiconMediumTile.'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.png' and $([System.String]::Copy('%(FileName)').StartsWith('appiconSmallTile.'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.png' and $([System.String]::Copy('%(FileName)').StartsWith('appiconWideTile.'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.png' and $([System.String]::Copy('%(FileName)').StartsWith('appiconStoreLogo.'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.png' and $([System.String]::Copy('%(FileName)').StartsWith('splashSplashScreen.'))" />
    </ItemGroup>
  </Target>

</Project>
