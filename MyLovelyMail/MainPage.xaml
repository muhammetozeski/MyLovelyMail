<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MyLovelyMail"
             xmlns:shared="clr-namespace:MyLovelyMail.MainProject.UI;assembly=MainProject"
             x:Class="MyLovelyMail.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid x:Name="RootLayout">
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>

</ContentPage>
