<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- net10.0 is what the Windows and Web heads consume. net10.0-android is the same library plus
         the Platforms\Android folder, and only the Android head consumes it. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- Dropped by SkipAndroidTargets=true, which the Windows publishes pass; see MyLovelyMail.csproj for why. -->
    <TargetFrameworks Condition="'$(SkipAndroidTargets)' != 'true'">$(TargetFrameworks);net10.0-android</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyLovelyMail.MainProject</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- Android 11. Writing into the shared Download folder by path and typed foreground services both
         exist on every version from here on, so the Android code carries no older-version branches. -->
    <SupportedOSPlatformVersion>30.0</SupportedOSPlatformVersion>
    <!-- Resources\Fonts are web fonts for the Blazor UI, not Android resources. -->
    <EnableDefaultAndroidItems>false</EnableDefaultAndroidItems>
  </PropertyGroup>

  <!-- Each platform folder compiles only into its own target: Platforms\Windows into net10.0, which the
       Windows head runs, and Platforms\Android into net10.0-android. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
    <Compile Remove="Platforms\Android\**" />
    <None Include="Platforms\Android\**" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <Compile Remove="Platforms\Windows\**" />
    <None Include="Platforms\Windows\**" />
    <!-- The tor the Android app starts itself; see Platforms\Android\Tor\README.md. -->
    <AndroidNativeLibrary Include="Platforms\Android\Tor\arm64-v8a\libtor.so" Abi="arm64-v8a" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <SupportedPlatform Include="android" />
    <SupportedPlatform Include="windows" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="10.0.90" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Generators\Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
</Project>
