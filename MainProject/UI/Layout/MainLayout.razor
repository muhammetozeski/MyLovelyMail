@inherits LayoutComponentBase
@inject NavigationManager NavManager
@implements IDisposable

<div class="app-page has-bottom-nav">
    <main>
        <article class="content">
            <AppErrorBoundary @ref="mainErrorBoundary" Title="An unexpected error occurred in this view" RetryText="Try Again" ShowReload="true">
                @Body
            </AppErrorBoundary>
        </article>
    </main>

    <AppBottomNav />
</div>

<VaultUnlockOverlay />
<AppModalHost />
<AppContextMenu />
<MainLayoutCss />

@code {
    protected override void OnInitialized()
    {
        Events.MainEvents.OnDataChanged += HandleDataChanged;
        // The layout outlives every page, so it is the right owner of the app-wide navigator.
        Services.NavigationBridge.Navigator = route => InvokeAsync(() => NavManager.NavigateTo(route));
        NavManager.LocationChanged += HandleLocationChanged;
    }

    void HandleDataChanged(string eventName, object? data)
    {
        if (eventName is "OnThemeChanged" or "OnStyleChanged")
        {
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= HandleLocationChanged;
        Events.MainEvents.OnDataChanged -= HandleDataChanged;
        Services.NavigationBridge.Navigator = null;
    }

    AppErrorBoundary? mainErrorBoundary;

    /// <summary>Drops captured menu targets when navigating to a different page.</summary>
    /// <param name="sender">Navigation source.</param>
    /// <param name="args">New route.</param>
    void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        ContextMenuService.Close();
        mainErrorBoundary?.Recover();
    }
}
