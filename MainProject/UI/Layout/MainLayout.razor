@inherits LayoutComponentBase
@inject NavigationManager NavManager
@implements IDisposable
@implements IHandleEvent

<div class="@MainLayoutCssClasses.RootShell"
     @onpointermove="HandleGlobalPointerMove"
     @onpointerup="HandleGlobalPointerUpAsync"
     @onkeydown="HandleGlobalKeyDown">
    <div class="@MainLayoutCssClasses.Page @MainLayoutCssClasses.HasBottomNav">
        <main>
            <article class="@MainLayoutCssClasses.Content">
                <AppErrorBoundary @ref="mainErrorBoundary" Title="An unexpected error occurred in this view" RetryText="Try Again" ShowReload="true">
                    @Body
                </AppErrorBoundary>
            </article>
        </main>

        <AppBottomNav />
    </div>

    <VaultUnlockOverlay />
    <AppModalHost />
    <AppContextMenu />
    <ActionDragGhost />
</div>

<ActionBarCss />
<MainLayoutCss />

@code {
    protected override void OnInitialized()
    {
        Events.MainEvents.OnDataChanged += HandleDataChanged;
        Services.NavigationBridge.Navigator = route => InvokeAsync(() => NavManager.NavigateTo(route));
        NavManager.LocationChanged += HandleLocationChanged;
    }

    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg) =>
        callback.InvokeAsync(arg);

    static void HandleGlobalPointerMove(PointerEventArgs e)
    {
        if ((e.Buttons & 1) == 0)
        {
            ActionDragService.Cancel();
            WorkspaceDragService.Cancel();
            return;
        }
        ActionDragService.UpdatePointer(e.ClientX, e.ClientY);
        WorkspaceDragService.UpdatePointer(e.ClientX, e.ClientY);
    }

    static Task HandleGlobalPointerUpAsync(PointerEventArgs e)
    {
        ActionDragService.UpdatePointer(e.ClientX, e.ClientY);
        ActionDragService.CompleteDrop();
        WorkspaceDragService.UpdatePointer(e.ClientX, e.ClientY);
        return WorkspaceDragService.CompleteDropAsync();
    }

    static void HandleGlobalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ActionDragService.Cancel();
            WorkspaceDragService.Cancel();
        }
    }

    void HandleDataChanged(string eventName, object? data)
    {
        if (eventName is "OnThemeChanged" or "OnStyleChanged")
        {
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= HandleLocationChanged;
        Events.MainEvents.OnDataChanged -= HandleDataChanged;
        Services.NavigationBridge.Navigator = null;
    }

    AppErrorBoundary? mainErrorBoundary;

    /// <summary>Drops captured menu targets when navigating to a different page.</summary>
    void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        ActionDragService.Cancel();
        WorkspaceDragService.Cancel();
        ContextMenuService.Close();
        mainErrorBoundary?.Recover();
    }
}
