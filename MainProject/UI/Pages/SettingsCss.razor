@namespace MyLovelyMail.MainProject.UI.Pages
@inherits ThemedComponentBase

<style>
    .settings-screen {
        max-width: @(AppMeasures.Size.Px420 + AppMeasures.Size.Px200)px;
        margin: 0 auto;
        padding: @(AppMeasures.Space.Medium)px @(AppMeasures.Space.Medium)px @(AppMeasures.Space.Px120)px;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Medium)px;
    }

    .settings-title {
        font-size: @(AppMeasures.Font.Hero)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @AppColors.TextPrimary.ToRgbaHex(true);
        margin: @(AppMeasures.Space.Px12)px 0 0;
    }

    .settings-section {
        text-align: left;
    }

    .settings-section-title {
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        margin-bottom: @(AppMeasures.Space.Px12)px;
    }

    .settings-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px16)px;
        padding: @(AppMeasures.Space.Px10)px 0;
        border-top: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
    }

        .settings-row:first-of-type {
            border-top: none;
        }

    .settings-row-text {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
        min-width: 0;
    }

    .settings-row-label {
        font-size: @(AppMeasures.Font.Medium)px;
        font-weight: @(AppMeasures.Weight.Medium);
        color: @AppColors.TextPrimary.ToRgbaHex(true);
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .settings-row-hint {
        font-size: @(AppMeasures.Font.Small)px;
        color: @AppColors.TextMuted.ToRgbaHex(true);
    }

    .settings-number {
        width: @(AppMeasures.Size.Px100)px;
        flex-shrink: 0;
    }

    .settings-empty-text {
        color: @AppColors.TextMuted.ToRgbaHex(true);
        margin: 0;
    }

    .settings-density {
        display: flex;
        gap: @(AppMeasures.Space.Px6)px;
        flex-shrink: 0;
    }

    .settings-density-option {
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        cursor: pointer;
        font-size: @(AppMeasures.Font.Small)px;
        transition: all @(AppMeasures.Duration.Fast)s ease;
    }

    .settings-density-option--on {
        background: linear-gradient(135deg, @AppColors.Primary.ToRgbaHex(true), @AppColors.Accent.ToRgbaHex(true));
        color: @AppColors.TextOnAccent.ToRgbaHex(true);
        border-color: transparent;
    }

    .settings-vault-switch {
        display: flex;
        gap: @(AppMeasures.Space.Px12)px;
        align-items: center;
        margin-top: @(AppMeasures.Space.Px8)px;
    }

        .settings-vault-switch > :first-child {
            flex: 1;
        }

    .settings-migration-actions {
        display: flex;
        justify-content: flex-end;
        gap: @(AppMeasures.Space.Px8)px;
        margin-top: @(AppMeasures.Space.Px8)px;
    }

    .settings-add-account {
        display: flex;
        justify-content: flex-end;
        margin-top: @(AppMeasures.Space.Px12)px;
    }

    .settings-account-dot {
        width: @(AppMeasures.Size.Px12)px;
        height: @(AppMeasures.Size.Px12)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        display: inline-block;
        flex-shrink: 0;
    }

    .settings-themes {
        display: flex;
        gap: @(AppMeasures.Space.Px12)px;
        flex-wrap: wrap;
    }

    .settings-theme {
        width: @(AppMeasures.Size.Px180)px;
        height: @(AppMeasures.Size.Px110)px;
        border-radius: @(AppMeasures.Radius.Large)px;
        border: @(AppMeasures.Border.Medium)px solid;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px10)px;
        box-sizing: border-box;
        transition: transform @(AppMeasures.Duration.Fast)s ease, box-shadow @(AppMeasures.Duration.Fast)s ease;
    }

    /* Miniature inbox: a sidebar sliver plus three fake mail rows painted from the theme's own tokens. */
    .settings-theme-mini {
        flex: 1;
        display: flex;
        gap: @(AppMeasures.Space.Px4)px;
        min-height: 0;
    }

    .settings-theme-mini-sidebar {
        width: @(AppMeasures.Size.Px12)px;
        border-radius: @(AppMeasures.Radius.Px4)px;
        flex-shrink: 0;
    }

    .settings-theme-mini-list {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px4)px;
        min-width: 0;
    }

    .settings-theme-mini-row {
        flex: 1;
        border-radius: @(AppMeasures.Radius.Px4)px;
        display: flex;
        align-items: center;
        padding-left: @(AppMeasures.Space.Px6)px;
    }

    .settings-theme-mini-unread {
        width: @(AppMeasures.Size.Px5)px;
        height: @(AppMeasures.Size.Px5)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
    }

    .settings-theme:hover .settings-theme-mini-unread {
        animation: mini-unread-pulse @(AppMeasures.Duration.Long)s ease-in-out infinite;
    }

    @@keyframes mini-unread-pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.8); }
    }

        .settings-theme:hover {
            transform: translateY(-@(AppMeasures.Space.Px2)px);
            box-shadow: @AppStyles.ShadowMedium;
        }

    .settings-theme--active {
        box-shadow: @AppStyles.ShadowPrimaryGlow;
    }

    .settings-theme-name {
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Bold);
    }
</style>
