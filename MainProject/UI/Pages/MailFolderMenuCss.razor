@inherits ThemedComponentBase
<style>
    .folder-menu-backdrop { position: fixed; inset: 0; z-index: @(AppMeasures.ZLayer.Popover); }
    .folder-menu {
        position: fixed;
        width: min(@(AppMeasures.Size.Px280)px, calc(100vw - @(AppMeasures.Space.Px16)px));
        max-height: min(@(AppMeasures.Size.Px400)px, calc(100dvh - @(AppMeasures.Space.Px16)px));
        overflow-y: auto;
        box-sizing: border-box;
        padding: @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        @((MarkupString)AppStyles.BuildAcrylicStyle(AcrylicLevel.Strong))
        box-shadow: @AppStyles.ShadowHeavy;
        color: @AppColors.TextPrimary.ToRgbaHex(true);
    }
    .folder-menu button {
        display: block;
        width: 100%;
        padding: @(AppMeasures.Space.Px8)px;
        border: 0;
        border-radius: @(AppMeasures.Radius.Small)px;
        background: transparent;
        color: inherit;
        text-align: left;
        font: inherit;
        cursor: pointer;
    }
    .folder-menu button:hover, .folder-menu button:focus-visible { background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true); }
    .folder-menu button:disabled { color: @AppColors.TextMuted.ToRgbaHex(true); cursor: default; }
    .folder-menu-title { padding: @(AppMeasures.Space.Px8)px; font-weight: @(AppMeasures.Weight.Bold); overflow-wrap: anywhere; }
    .folder-menu-status { padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px8)px; font-size: @(AppMeasures.Font.Small)px; color: @AppColors.TextMuted.ToRgbaHex(true); }
    .folder-menu-split { display: flex; }
    .folder-menu .folder-menu-arrow { flex: 0 0 @(AppMeasures.Size.Px40)px; text-align: center; border-left: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true); }
    .folder-menu-durations { margin-left: @(AppMeasures.Space.Px16)px; border-left: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true); }
    .folder-menu hr { border: 0; border-top: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true); }
</style>
