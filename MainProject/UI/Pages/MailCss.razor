@namespace MyLovelyMail.MainProject.UI.Pages
@inherits MyLovelyMail.MainProject.UI.Layout.Architecture.ThemedComponentBase
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings

@{
    // Row metrics follow the density setting: Cozy = roomy + 2 preview lines, Compact = tight single line.
    (int rowPaddingY, int previewLines, int rowGap) = GlobalSettings.MessageListDensity.Value switch
    {
        "Cozy" => (AppMeasures.Space.Px14, 2, AppMeasures.Space.Px8),
        "Compact" => (AppMeasures.Space.Px4, 0, AppMeasures.Space.Px2),
        _ => (AppMeasures.Space.Px10, 1, AppMeasures.Space.Px6)
    };

    string textPrimary = AppColors.TextPrimary.ToRgbaHex(true);
    string textSecondary = AppColors.TextSecondary.ToRgbaHex(true);
    string textMuted = AppColors.TextMuted.ToRgbaHex(true);
    string primary = AppColors.Primary.ToRgbaHex(true);
    string surfaceTint = AppColors.SurfaceTintPrimary.ToRgbaHex(true);
    string glassBorder = AppColors.GlassBorderDefault.ToRgbaHex(true);
}

<style>
    .mail-screen {
        display: grid;
        grid-template-columns: @(AppMeasures.Size.Px260)px @(AppMeasures.Size.Px360)px 1fr;
        gap: @(AppMeasures.Space.Medium)px;
        padding: @(AppMeasures.Space.Medium)px;
        box-sizing: border-box;
        height: calc(@(AppMeasures.Viewport.Full)vh - @(AppMeasures.Space.Px90)px);
        min-height: 0;
    }

    /* ---- Sidebar ---- */

    .mail-sidebar {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px4)px;
        overflow-y: auto;
        min-height: 0;
    }

    .mail-logo {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @textPrimary;
        padding: @(AppMeasures.Space.Px12)px @(AppMeasures.Space.Px8)px;
    }

    .mail-logo-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mail-welcome-card {
        text-align: center;
    }

    .mail-welcome-icon {
        font-size: @(AppMeasures.Font.Giant)px;
    }

    .mail-welcome-title {
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        margin: @(AppMeasures.Space.Px8)px 0;
    }

    .mail-welcome-text {
        color: @textSecondary;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        margin: 0 0 @(AppMeasures.Space.Px16)px 0;
    }

    .mail-account {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        border: none;
        background: transparent;
        cursor: pointer;
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        font-weight: @(AppMeasures.Weight.Medium);
        color: @textPrimary;
        text-align: left;
        transition: background @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-account:hover,
        .mail-account--active {
            background: @surfaceTint;
        }

    .mail-account-dot {
        width: @(AppMeasures.Size.Px12)px;
        height: @(AppMeasures.Size.Px12)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        flex-shrink: 0;
    }

    .mail-account-name {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-account-unread {
        color: @AppColors.TextOnFilledSurface.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        flex-shrink: 0;
    }

    .mail-folder {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        border: none;
        background: transparent;
        cursor: pointer;
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px24)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        color: @textSecondary;
        font-size: @(AppMeasures.Font.Normal)px;
        text-align: left;
        transition: all @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-folder:hover {
            background: @surfaceTint;
            color: @textPrimary;
        }

    .mail-folder--active {
        background: @surfaceTint;
        color: var(--account-accent, @primary);
        font-weight: @(AppMeasures.Weight.Medium);
    }

    .mail-folder-name {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* ---- Search tools and saved searches ---- */

    .mail-search {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .mail-search-tools {
        display: flex;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .mail-search-toggle {
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @textSecondary;
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        cursor: pointer;
        font-size: @(AppMeasures.Font.Small)px;
        transition: all @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-search-toggle:hover {
            background: @surfaceTint;
            color: @textPrimary;
        }

    .mail-search-toggle--on {
        background: linear-gradient(135deg, @primary, @AppColors.Accent.ToRgbaHex(true));
        color: @AppColors.TextOnAccent.ToRgbaHex(true);
        border-color: transparent;
    }

    .mail-saved-searches {
        display: flex;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px6)px;
        padding: 0 @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px8)px;
    }

    .mail-saved-chip {
        display: inline-flex;
        align-items: center;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        border-radius: @(AppMeasures.Radius.Pill)px;
        overflow: hidden;
    }

    .mail-saved-run,
    .mail-saved-remove {
        border: none;
        background: transparent;
        color: @textSecondary;
        cursor: pointer;
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.XSmall)px;
        max-width: @(AppMeasures.Size.Px180)px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .mail-saved-run:hover,
        .mail-saved-remove:hover {
            background: @surfaceTint;
            color: @textPrimary;
        }

    .mail-row-folder {
        color: var(--account-accent, @primary);
        margin-right: @(AppMeasures.Space.Px6)px;
        font-weight: @(AppMeasures.Weight.Medium);
    }

    /* ---- Message list ---- */

    .mail-list {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px8)px;
        min-height: 0;
    }

    .mail-rows {
        overflow-y: auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: @(rowGap)px;
        padding-right: @(AppMeasures.Space.Px2)px;
    }

    .mail-row {
        display: flex;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px8)px;
        width: @(AppMeasures.Percent.Full)%;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        cursor: pointer;
        text-align: left;
        padding: @(rowPaddingY)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        color: @textPrimary;
        transition: all @(AppMeasures.Duration.Fast)s ease;
        box-sizing: border-box;
    }

        .mail-row:hover {
            background: @surfaceTint;
            transform: translateY(-@(AppMeasures.Size.Px1)px);
        }

    .mail-row--active {
        background: @surfaceTint;
        border-color: var(--account-accent, @primary);
    }

    /* Keyboard-focused row: a soft accent outline distinct from the opened (active) row. */
    .mail-row--focused {
        outline: @(AppMeasures.Border.Medium)px solid @AppColors.Accent.ToRgbaHex(true);
        outline-offset: -@(AppMeasures.Border.Medium)px;
    }

    .mail-rows:focus {
        outline: none;
    }

    .mail-shortcuts {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px8)px;
        text-align: left;
    }

    .mail-shortcuts-title {
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        margin-bottom: @(AppMeasures.Space.Px8)px;
        text-align: center;
    }

    .mail-shortcuts-row {
        display: flex;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px16)px;
    }

    .mail-shortcuts-keys {
        font-weight: @(AppMeasures.Weight.Heavy);
        color: @primary;
        min-width: @(AppMeasures.Size.Px80)px;
    }

    .mail-shortcuts-action {
        color: @textSecondary;
    }

    .mail-bulk-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        border: @(AppMeasures.Border.Thin)px solid var(--account-accent, @primary);
        background: @surfaceTint;
    }

    .mail-bulk-count {
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        color: var(--account-accent, @primary);
        margin-right: @(AppMeasures.Space.Px4)px;
    }

    .mail-row-check {
        font-size: @(AppMeasures.Font.Medium)px;
        color: @textMuted;
        flex-shrink: 0;
        cursor: pointer;
        line-height: @(AppMeasures.LineHeight.None);
    }

        .mail-row-check:hover {
            color: @textPrimary;
        }

    .mail-row-check--on {
        color: var(--account-accent, @primary);
    }

    .mail-row-avatar {
        width: @(GlobalSettings.MessageListDensity.Value == "Compact" ? AppMeasures.Size.Px24 : AppMeasures.Size.Px32)px;
        height: @(GlobalSettings.MessageListDensity.Value == "Compact" ? AppMeasures.Size.Px24 : AppMeasures.Size.Px32)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: @AppColors.TextOnFilledSurface.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        flex-shrink: 0;
        box-shadow: @AppStyles.ShadowSoft;
    }

    /* Unread: an accent ring around the avatar reinforces the dot without shouting. */
    .mail-row-avatar--unread {
        outline: @(AppMeasures.Border.Medium)px solid var(--account-accent, @primary);
        outline-offset: @(AppMeasures.Border.Thin)px;
    }

    .mail-row-dot {
        width: @(AppMeasures.Size.Px5)px;
        height: @(AppMeasures.Size.Px5)px;
        margin-top: @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        flex-shrink: 0;
        background: transparent;
    }

    .mail-row--unread .mail-row-dot {
        background: var(--account-accent, @primary);
    }

    /* One-shot arrival bloom: the row unfolds from slightly small with a petal-like accent glow. */
    .mail-row--bloom {
        animation: mail-bloom @(AppMeasures.Duration.Slow)s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes mail-bloom {
        0% {
            transform: scale(0.92);
            opacity: 0;
            box-shadow: 0 0 0 0 var(--account-accent, @primary);
        }

        45% {
            transform: scale(1.02);
            opacity: 1;
            box-shadow: 0 0 @(AppMeasures.Space.Px24)px @(AppMeasures.Space.Px2)px @AppColors.Primary.WithAlpha(0.35f).ToRgbaHex(true);
        }

        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 transparent;
        }
    }

    .mail-row--unread .mail-row-from,
    .mail-row--unread .mail-row-subject {
        font-weight: @(AppMeasures.Weight.Heavy);
    }

    .mail-row-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
    }

    .mail-row-top {
        display: flex;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .mail-row-from {
        font-size: @(AppMeasures.Font.Normal)px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-row-date {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textMuted;
        flex-shrink: 0;
    }

    .mail-row-subject {
        font-size: @(AppMeasures.Font.Normal)px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-row-flag {
        margin-right: @(AppMeasures.Space.Px4)px;
    }

    .mail-row-preview {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textMuted;
        overflow: hidden;
        @if (previewLines == 0)
        {
            @("display: none;")
        }
        else if (previewLines == 1)
        {
            @("text-overflow: ellipsis; white-space: nowrap;")
        }
        else
        {
            @($"display: -webkit-box; -webkit-line-clamp: {previewLines}; -webkit-box-orient: vertical; white-space: normal;")
        }
    }

    .mail-row-attach {
        margin-right: @(AppMeasures.Space.Px4)px;
    }

    /* ---- Reader ---- */

    .mail-reader {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Medium)px;
        min-height: 0;
        overflow-y: auto;
    }

    .mail-reader-header {
        display: flex;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px12)px;
    }

    .mail-reader-titles {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px4)px;
        min-width: 0;
    }

    /* Remounted per message via @@key, so the open animation replays on every switch. */
    .mail-reader-content {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Medium)px;
        min-height: 0;
        flex: 1;
        animation: reader-open @(AppMeasures.Duration.Medium)s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes reader-open {
        from {
            opacity: 0;
            transform: translateX(@(AppMeasures.Space.Px24)px) scale(0.985);
        }

        to {
            opacity: 1;
            transform: translateX(0) scale(1);
        }
    }

    /* No gradient-clipped ink here: background-clip:text crushes color emoji in subjects into
       tinted silhouettes. Solid text + a gradient underline carries the accent instead. */
    .mail-reader-subject {
        padding-bottom: @(AppMeasures.Space.Px4)px;
        font-size: @(AppMeasures.Font.Title)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @textPrimary;
        line-height: @(AppMeasures.LineHeight.Tight);
        border-image: linear-gradient(90deg, var(--account-accent, @primary), @AppColors.Accent.ToRgbaHex(true)) 1;
        border-bottom: @(AppMeasures.Border.Medium)px solid;
    }

    .mail-reader-meta {
        display: flex;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.Small)px;
        color: @textSecondary;
    }

    .mail-reader-to {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textMuted;
    }

    .mail-reader-body {
        flex: 1;
    }

    .mail-reader-frame {
        width: @(AppMeasures.Percent.Full)%;
        flex: 1;
        min-height: @(AppMeasures.Size.Px300)px;
        border: none;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: #ffffff;
    }

    .mail-body-loading {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: @(AppMeasures.Size.Px200)px;
    }

    .mail-reader-preview,
    .mail-reader-nobody {
        margin: 0;
        text-align: left;
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @textPrimary;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .mail-reader-nobody {
        color: @textMuted;
        font-style: italic;
    }

    /* ---- Compose ---- */

    .mail-compose-button {
        margin-bottom: @(AppMeasures.Space.Px8)px;
    }

    .mail-compose-card {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px10)px;
        text-align: left;
        flex: 1;
    }

    .mail-compose-fields {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px10)px;
        flex: 1;
        min-height: 0;
    }

    .mail-compose-saved {
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @textMuted;
        margin-left: auto;
        flex-shrink: 0;
    }

    .mail-compose-from {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textSecondary;
    }

    .mail-compose-body {
        flex: 1;
        min-height: @(AppMeasures.Size.Px200)px;
        resize: vertical;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: @AppColors.Background.ToRgbaHex(true);
        color: @textPrimary;
        padding: @(AppMeasures.Space.Px12)px;
        font-size: @(AppMeasures.Font.Normal)px;
        font-family: inherit;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        outline: none;
        box-sizing: border-box;
    }

    .mail-compose-error {
        margin: 0;
        color: @AppColors.TextDanger.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
        word-break: break-word;
    }

    .mail-compose-actions {
        display: flex;
        justify-content: flex-end;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .mail-reader-actions {
        display: flex;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .mail-attachments {
        display: flex;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .mail-attachment-chip {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @textPrimary;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        cursor: pointer;
        font-size: @(AppMeasures.Font.Small)px;
        max-width: @(AppMeasures.Size.Px300)px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: all @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-attachment-chip:hover {
            background: @surfaceTint;
            transform: translateY(-@(AppMeasures.Size.Px1)px);
        }

    .mail-attachment-chip--all {
        border-color: var(--account-accent, @primary);
        color: var(--account-accent, @primary);
        font-weight: @(AppMeasures.Weight.Medium);
    }

    .mail-attachment-size {
        color: @textMuted;
        font-size: @(AppMeasures.Font.XSmall)px;
    }

    .mail-tag-chip {
        display: inline-flex;
        align-items: center;
        color: @AppColors.TextOnFilledSurface.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Medium);
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: none;
        margin-right: @(AppMeasures.Space.Px4)px;
        white-space: nowrap;
    }

    .mail-tag-chip--action {
        cursor: pointer;
        transition: transform @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-tag-chip--action:hover {
            transform: translateY(-@(AppMeasures.Size.Px1)px);
        }

    .mail-tag-chip--off {
        opacity: @(AppMeasures.Opacity.Disabled);
    }

    .mail-tag-picker {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .mail-tag-input {
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @textPrimary;
        border-radius: @(AppMeasures.Radius.Pill)px;
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px10)px;
        font-size: @(AppMeasures.Font.Small)px;
        outline: none;
        width: @(AppMeasures.Size.Px120)px;
    }

    .mail-image-banner {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.Small)px;
        color: @textSecondary;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        border-radius: @(AppMeasures.Radius.Medium)px;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px10)px;
    }

    .mail-save-status {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textSecondary;
        word-break: break-all;
    }

    /* ---- Shared empty state ---- */

    .mail-empty {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: @(AppMeasures.Space.Px8)px;
        color: @textMuted;
        min-height: @(AppMeasures.Size.Px200)px;
