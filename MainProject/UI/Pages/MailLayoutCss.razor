@namespace MyLovelyMail.MainProject.UI.Pages
@inherits ThemedComponentBase
@using System.Globalization
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings

@{
    string textPrimary = AppColors.TextPrimary.ToRgbaHex(true);
    string textSecondary = AppColors.TextSecondary.ToRgbaHex(true);
    string textMuted = AppColors.TextMuted.ToRgbaHex(true);
    string primary = AppColors.Primary.ToRgbaHex(true);
    string surfaceTint = AppColors.SurfaceTintPrimary.ToRgbaHex(true);
    string splitterColor = AppStyles.ResolvedScrollbarColorHex();
    string paneHeight = $"calc({AppMeasures.Viewport.Full}vh - {AppMeasures.Space.Px90 + AppMeasures.Space.Medium * 2}px)";
    string sidebarPct = GlobalSettings.SidebarColumnPercent.Value.ToString("0.######", CultureInfo.InvariantCulture);
    string listPct = GlobalSettings.ListColumnPercent.Value.ToString("0.######", CultureInfo.InvariantCulture);
    string readerPct = GlobalSettings.ReaderColumnPercent.Value.ToString("0.######", CultureInfo.InvariantCulture);
}

<style>
    .@(MailCssClasses.Screen) {
        --col-sidebar-pct: @(sidebarPct)%;
        --col-list-pct: @(listPct)%;
        --col-reader-pct: @(readerPct)%;
        display: grid;
        grid-template-columns: minmax(@(AppMeasures.Size.Px180)px, var(--col-sidebar-pct)) @(AppMeasures.Space.Medium)px minmax(@(AppMeasures.Size.Px260)px, var(--col-list-pct)) @(AppMeasures.Space.Medium)px minmax(@(AppMeasures.Size.Px280)px, 1fr);
        gap: 0;
        padding: @(AppMeasures.Space.Medium)px;
        box-sizing: border-box;
        min-height: calc(@(AppMeasures.Viewport.Full)vh - @(AppMeasures.Space.Px90)px);
        align-items: start;
    }

    .@(MailCssClasses.ScreenResizing),
    .@(MailCssClasses.ScreenResizing) * {
        user-select: none !important;
        cursor: col-resize !important;
    }

    /* Invisible until hovered or actively dragged; sits in the 16px column gap between panes. */
    .@(MailCssClasses.ColumnSplitter) {
        width: @(AppMeasures.Space.Medium)px;
        height: @paneHeight;
        position: sticky;
        top: @(AppMeasures.Space.Medium)px;
        cursor: col-resize;
        display: flex;
        align-items: stretch;
        justify-content: center;
        background: transparent;
        user-select: none;
        z-index: @(AppMeasures.ZLayer.Dropdown + AppMeasures.Size.Px5);
    }

    .@(MailCssClasses.ColumnSplitterGrip) {
        display: none;
    }

    .@(MailCssClasses.ColumnSplitter)::after {
        content: "";
        width: @(AppMeasures.Border.Thick)px;
        background: @splitterColor;
        opacity: 0;
        border-radius: @(AppMeasures.Radius.Pill)px;
        transition: opacity @(AppMeasures.Duration.Fast)s ease, width @(AppMeasures.Duration.Fast)s ease, box-shadow @(AppMeasures.Duration.Fast)s ease;
    }

    .@(MailCssClasses.ColumnSplitter):hover::after,
    .@(MailCssClasses.ColumnSplitter):active::after,
    .@(MailCssClasses.ColumnSplitterDragging)::after {
        opacity: @(AppMeasures.Opacity.Bright);
        width: @(AppMeasures.Size.Px4)px;
        box-shadow: 0 0 @(AppMeasures.Space.Px8)px @splitterColor;
    }

    /* ---- Sidebar ---- */

    .@(MailCssClasses.Sidebar) {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px4)px;
        overflow-y: auto;
        min-height: 0;
        position: sticky;
        top: @(AppMeasures.Space.Medium)px;
        height: @paneHeight;
    }

    .@(MailCssClasses.SidebarNav) {
        display: contents;
    }

    .@(MailCssClasses.Logo) {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @textPrimary;
        padding: @(AppMeasures.Space.Px12)px @(AppMeasures.Space.Px8)px;
    }

    .@(MailCssClasses.LogoText) {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .@(MailCssClasses.DragEscapeBanner) {
        position: fixed;
        left: @(AppMeasures.Space.Px16)px;
        bottom: @(AppMeasures.Size.BottomNavHeight + AppMeasures.Space.Px10)px;
        z-index: @(AppMeasures.ZLayer.Toast);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: @AppColors.TooltipBackground.ToRgbaHex(true);
        border: @(AppMeasures.Border.Thin)px dashed @primary;
        box-shadow: @AppStyles.ShadowMedium;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @textPrimary;
    }

    .@(MailCssClasses.WelcomeCard) {
        text-align: center;
    }

    .@(MailCssClasses.WelcomeIcon) {
        font-size: @(AppMeasures.Font.Giant)px;
    }

    .@(MailCssClasses.WelcomeTitle) {
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        margin: @(AppMeasures.Space.Px8)px 0;
    }

    .@(MailCssClasses.WelcomeText) {
        color: @textSecondary;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        margin: 0 0 @(AppMeasures.Space.Px16)px 0;
    }

    .@(MailCssClasses.Account) {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        border: none;
        background: transparent;
        cursor: pointer;
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        font-weight: @(AppMeasures.Weight.Medium);
        color: @textPrimary;
        text-align: left;
        transition: background @(AppMeasures.Duration.Fast)s ease;
    }

        .@(MailCssClasses.Account):hover,
        .@(MailCssClasses.AccountActive) {
            background: @surfaceTint;
        }

    .@(MailCssClasses.AccountDot) {
        width: @(AppMeasures.Size.Px12)px;
        height: @(AppMeasures.Size.Px12)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        flex-shrink: 0;
    }

    .@(MailCssClasses.AccountPaused) {
        opacity: @(AppMeasures.Opacity.Muted);
    }

        .@(MailCssClasses.AccountPaused) .@(MailCssClasses.AccountDot) {
            filter: grayscale(1);
        }

    .@(MailCssClasses.AccountFailing),
    .@(MailCssClasses.AccountPausedIcon) {
        flex-shrink: 0;
        font-size: @(AppMeasures.Font.Small)px;
    }

    .@(MailCssClasses.AccountOrdinal) {
        flex-shrink: 0;
        min-width: @(AppMeasures.Size.Px16)px;
        text-align: center;
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @AppColors.TextMuted.ToRgbaHex(true);
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        border-radius: @(AppMeasures.Radius.Px4)px;
        padding: 0 @(AppMeasures.Space.Px2)px;
    }

    .@(MailCssClasses.AccountName) {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(MailCssClasses.AccountUnread) {
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        flex-shrink: 0;
    }

    .@(MailCssClasses.FolderRow) {
        display: flex;
        align-items: center;
        padding-left: calc(@(AppMeasures.Space.Px6)px + var(--folder-depth, 0) * @(AppMeasures.Space.Px12)px);
        border-radius: @(AppMeasures.Radius.Medium)px;
        transition: background @(AppMeasures.Duration.Fast)s ease;
    }

        .@(MailCssClasses.FolderRow):hover {
            background: @surfaceTint;
        }

    .@(MailCssClasses.FolderGutter) {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: @(AppMeasures.Space.Px2)px;
        min-width: @(AppMeasures.Size.Px16)px;
        flex-shrink: 0;
    }

    .@(MailCssClasses.FolderChevron) {
        border: none;
        background: transparent;
        color: @textMuted;
        cursor: pointer;
        padding: 0 @(AppMeasures.Space.Px2)px;
        font-size: @(AppMeasures.Font.XSmall)px;
        line-height: @(AppMeasures.LineHeight.None);
    }

        .@(MailCssClasses.FolderChevron):hover {
            color: @primary;
        }

    .@(MailCssClasses.FolderMutedGutter) {
        font-size: @(AppMeasures.Font.XSmall)px;
        line-height: @(AppMeasures.LineHeight.None);
        flex-shrink: 0;
    }

    .@(MailCssClasses.FolderRow) > .@(MailCssClasses.Folder) {
        flex: 1;
        min-width: 0;
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px4)px;
    }

    .@(MailCssClasses.FolderHoverActions),
    .@(MailCssClasses.FolderHoverActions).@(MyLovelyMail.MainProject.UI.Elements.Buttons.ActionBarCssClasses.Bar) {
        display: none;
        align-items: center;
        gap: @(AppMeasures.Space.Px2)px;
        flex-shrink: 0;
    }

    .@(MailCssClasses.FolderRow):hover .@(MailCssClasses.FolderHoverActions),
    .@(MailCssClasses.FolderRow):focus-within .@(MailCssClasses.FolderHoverActions),
    .@(MailCssClasses.AccountFolderRow):hover .@(MailCssClasses.FolderHoverActions),
    .@(MailCssClasses.AccountFolderRow):focus-within .@(MailCssClasses.FolderHoverActions),
    .@(MailCssClasses.FolderHoverActions).@(MyLovelyMail.MainProject.UI.Elements.Buttons.ActionBarCssClasses.BarDropReady) {
        display: inline-flex;
    }

    .@(MailCssClasses.FolderAction) {
        flex-shrink: 0;
        border: none;
        background: transparent;
        cursor: pointer;
        opacity: @(AppMeasures.Opacity.Muted);
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Small)px;
        font-size: @(AppMeasures.Font.Small)px;
        color: @textSecondary;
        transition: opacity @(AppMeasures.Duration.Fast)s ease, background @(AppMeasures.Duration.Fast)s ease;
    }

        .@(MailCssClasses.FolderAction):hover {
            opacity: 1;
            color: @textPrimary;
            background: @surfaceTint;
        }

    .@(MailCssClasses.Folder) {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        border: none;
        background: transparent;
        cursor: pointer;
        padding: @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        color: @textSecondary;
        font-size: @(AppMeasures.Font.Normal)px;
        text-align: left;
        transition: all @(AppMeasures.Duration.Fast)s ease;
    }

        .@(MailCssClasses.Folder):hover {
            color: @textPrimary;
        }

    .@(MailCssClasses.FolderActive) {
        background: @surfaceTint;
        color: var(--account-accent, @primary);
        font-weight: @(AppMeasures.Weight.Medium);
    }

    .@(MailCssClasses.FolderIcon) {
        flex-shrink: 0;
    }

    .@(MailCssClasses.FolderName) {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(MailCssClasses.AccountFolderRow) {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
        padding-left: calc(var(--acc-folder-depth, 0) * @(AppMeasures.Space.Px12)px);
        border-radius: @(AppMeasures.Radius.Medium)px;
        transition: background @(AppMeasures.Duration.Fast)s ease;
    }

        .@(MailCssClasses.AccountFolderRow):hover {
            background: @surfaceTint;
        }

    .@(MailCssClasses.AccountFolderToggle) {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        border: none;
        background: transparent;
        cursor: pointer;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px8)px;
        color: @textSecondary;
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Bold);
        text-align: left;
    }

    .@(MailCssClasses.AccountFolderChevron) {
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @textMuted;
        width: @(AppMeasures.Size.Px12)px;
        text-align: center;
    }

    .@(MailCssClasses.AccountFolderName) {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(MailCssClasses.AccountFolderAction) {
        opacity: @(AppMeasures.Opacity.Muted);
    }

    .@(MailCssClasses.Account) *,
    .@(MailCssClasses.Folder) *,
    .@(MailCssClasses.AccountFolderToggle) *,
    .@(MailCssClasses.FolderMutedGutter) {
        pointer-events: none;
    }

    .@(MailCssClasses.SidebarWorkspaceDragging) .@(MailCssClasses.FolderHoverActions) {
        display: none;
        pointer-events: none;
    }

    .@(MailCssClasses.DropTarget) {
        outline: @(AppMeasures.Border.Medium)px dashed @primary;
        background: @surfaceTint;
    }

    .@(MailCssClasses.DropBefore) {
        box-shadow: inset 0 @(AppMeasures.Border.Thick)px 0 0 @primary;
        background: @surfaceTint;
    }

    .@(MailCssClasses.DropAfter) {
        box-shadow: inset 0 -@(AppMeasures.Border.Thick)px 0 0 @primary;
        background: @surfaceTint;
    }
</style>
