@namespace MyLovelyMail.MainProject.UI.Pages
@inherits ThemedComponentBase
@using System.Globalization
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings

@{
    string splitterColor = AppStyles.ResolvedScrollbarColorHex();
    string sidebarPct = GlobalSettings.SidebarColumnPercent.Value.ToString("0.######", CultureInfo.InvariantCulture);
    string listPct = GlobalSettings.ListColumnPercent.Value.ToString("0.######", CultureInfo.InvariantCulture);
    string readerPct = GlobalSettings.ReaderColumnPercent.Value.ToString("0.######", CultureInfo.InvariantCulture);
}

<style>
    /* Three-column layout with double-precision percentage widths and thin scrollbar-colored splitters. */
    .mail-screen {
        --col-sidebar-pct: @(sidebarPct)%;
        --col-list-pct: @(listPct)%;
        --col-reader-pct: @(readerPct)%;
        display: flex;
        align-items: stretch;
        width: 100%;
        height: calc(100vh - @(AppMeasures.Space.Px90)px);
        gap: 0;
        position: relative;
    }

        .mail-screen > .mail-sidebar {
            width: var(--col-sidebar-pct);
            min-width: 150px;
            flex-shrink: 0;
        }

        .mail-screen > .mail-list,
        .mail-screen > .mail-main {
            width: var(--col-list-pct);
            min-width: 220px;
            flex-shrink: 0;
        }

        .mail-screen > .mail-reader,
        .mail-screen > .mail-compose,
        .mail-screen > .mail-person {
            flex: 1 1 var(--col-reader-pct);
            min-width: 260px;
        }

    /* Thin vertical splitter next to the scrollbar between columns, bound to the scrollbar color. */
    .mail-column-splitter {
        width: 6px;
        flex-shrink: 0;
        cursor: col-resize;
        position: relative;
        z-index: 15;
        display: flex;
        align-items: stretch;
        justify-content: center;
        background: transparent;
        user-select: none;
    }

        .mail-column-splitter::after {
            content: "";
            width: 2px;
            background: @splitterColor;
            opacity: 0.55;
            border-radius: 999px;
            transition: opacity 0.15s ease, width 0.15s ease, box-shadow 0.15s ease;
        }

        .mail-column-splitter:hover::after,
        .mail-column-splitter:active::after {
            width: 4px;
            opacity: 1;
            box-shadow: 0 0 8px @splitterColor;
        }

    .mail-splitter-snap-badge {
        position: fixed;
        top: 12px;
        left: 50%;
        transform: translateX(-50%);
        z-index: @(AppMeasures.ZLayer.Toast);
        display: none;
        align-items: center;
        padding: 4px 12px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: @AppColors.TooltipBackground.ToRgbaHex(true);
        border: 1px solid @splitterColor;
        color: @AppColors.TextPrimary.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Bold);
        box-shadow: @AppStyles.ShadowMedium;
        pointer-events: none;
    }

    .mail-sidebar {
        padding: @(AppMeasures.Space.Medium)px @(AppMeasures.Space.Px10)px;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Medium)px;
        overflow-y: auto;
        box-sizing: border-box;
        @((MarkupString)AppStyles.BuildAcrylicStyle(AcrylicLevel.Subtle, AppMeasures.Blur.Normal))
        border-top: none;
        border-bottom: none;
        border-left: none;
    }

    .mail-sidebar-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .mail-brand {
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @AppColors.TextPrimary.ToRgbaHex(true);
    }

    .mail-drag-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
        padding: 6px 8px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        border: 1px dashed @splitterColor;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @AppColors.TextPrimary.ToRgbaHex(true);
    }

    .mail-drag-cancel-btn {
        border: none;
        background: transparent;
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        cursor: pointer;
        font-size: @(AppMeasures.Font.XSmall)px;
        padding: 0 4px;
    }

    .mail-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Bold);
        letter-spacing: 0.08em;
        color: @AppColors.TextMuted.ToRgbaHex(true);
        padding: 0 @(AppMeasures.Space.Px4)px;
    }

    .sidebar-add {
        background: transparent;
        border: none;
        color: @AppColors.Primary.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Large)px;
        cursor: pointer;
        padding: 0 @(AppMeasures.Space.Px4)px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .sidebar-add--fast {
        padding: 0 @(AppMeasures.Space.Px2)px;
        border-radius: @(AppMeasures.Radius.Small)px;
        transition: transform @(AppMeasures.Duration.Fast)s ease, filter @(AppMeasures.Duration.Fast)s ease;
    }

        .sidebar-add--fast:hover {
            transform: scale(1.1);
            filter: brightness(1.08);
        }

    .mail-account-header-actions {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
    }

    .mail-acc-folder {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px2)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px4)px;
        transition: background @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-acc-folder:hover {
            background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        }

    .mail-drop-target {
        outline: 2px dashed @splitterColor;
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true) !important;
    }

    .mail-acc-folder-toggle {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        border: none;
        background: transparent;
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Bold);
        padding: @(AppMeasures.Space.Px4)px;
        cursor: pointer;
        text-align: left;
    }

    .mail-acc-folder-chevron {
        font-size: @(AppMeasures.Font.XSmall)px;
        width: @(AppMeasures.Size.Px12)px;
        display: inline-block;
        text-align: center;
        color: @AppColors.TextMuted.ToRgbaHex(true);
    }

    .mail-acc-folder-name {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-acc-folder-actions {
        display: none;
        align-items: center;
        gap: @(AppMeasures.Space.Px2)px;
    }

    .mail-acc-folder:hover .mail-acc-folder-actions {
        display: inline-flex;
    }

    .mail-account-title-tag {
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @AppColors.TextMuted.ToRgbaHex(true);
        font-weight: @(AppMeasures.Weight.Normal);
        margin-left: @(AppMeasures.Space.Px4)px;
    }

    .mail-accounts, .mail-folders {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
    }

    .mail-new-folder {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px6)px;
    }

    .mail-new-folder-actions {
        display: flex;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .mail-account-row {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px2)px;
    }

    .mail-account-gear {
        background: transparent;
        border: none;
        color: @AppColors.TextMuted.ToRgbaHex(true);
        cursor: pointer;
        padding: @(AppMeasures.Space.Px4)px;
        border-radius: @(AppMeasures.Radius.Small)px;
        font-size: @(AppMeasures.Font.Small)px;
        display: none;
        transition: color @(AppMeasures.Duration.Fast)s ease;
    }

    .mail-account-row:hover .mail-account-gear {
        display: inline-flex;
    }

        .mail-account-gear:hover {
            color: @AppColors.Primary.ToRgbaHex(true);
        }

    .mail-account-warn {
        font-size: @(AppMeasures.Font.Small)px;
        flex-shrink: 0;
    }

    .mail-account-tor {
        font-size: @(AppMeasures.Font.XSmall)px;
        flex-shrink: 0;
    }

    .mail-account, .mail-folder {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px8)px;
        border: none;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: transparent;
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
        cursor: pointer;
        text-align: left;
        transition: background @(AppMeasures.Duration.Fast)s ease, color @(AppMeasures.Duration.Fast)s ease;
    }

    .mail-account {
        flex: 1;
        min-width: 0;
    }

        .mail-account:hover, .mail-folder:hover {
            background: @AppColors.SurfaceNormal.ToRgbaHex(true);
            color: @AppColors.TextPrimary.ToRgbaHex(true);
        }

    .mail-account--active, .mail-folder--active {
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        color: @AppColors.Primary.ToRgbaHex(true);
        font-weight: @(AppMeasures.Weight.Bold);
    }

    .mail-folder-row {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px2)px;
        position: relative;
        width: 100%;
    }

        .mail-folder-row > .mail-folder {
            flex: 1;
            min-width: 0;
            padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px6)px;
            gap: @(AppMeasures.Space.Px4)px;
        }

    /* Left gutter before the folder icon holds the expand chevron and the muted bell icon (2.png fix). */
    .mail-folder-gutter {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 2px;
        min-width: 16px;
        flex-shrink: 0;
    }

    .mail-folder-chevron-btn {
        border: none;
        background: transparent;
        color: @AppColors.TextMuted.ToRgbaHex(true);
        cursor: pointer;
        padding: 0 2px;
        font-size: @(AppMeasures.Font.XSmall)px;
        line-height: 1;
    }

        .mail-folder-chevron-btn:hover {
            color: @AppColors.Primary.ToRgbaHex(true);
        }

    .mail-folder-muted {
        font-size: 11px;
        flex-shrink: 0;
        opacity: 0.88;
        line-height: 1;
    }

    .mail-folder-main-btn {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        border: none;
        background: transparent;
        color: inherit;
        font: inherit;
        padding: 2px 0;
        cursor: pointer;
        text-align: left;
    }

    .mail-folder-icon {
        flex-shrink: 0;
    }

    /* Hover actions take ZERO width when not hovered so folder names and unread counts use the full row width (2.png fix). */
    .mail-folder-hover-actions {
        display: none;
        align-items: center;
        gap: 2px;
        flex-shrink: 0;
    }

    .mail-folder-row:hover .mail-folder-hover-actions,
    .mail-folder-row:focus-within .mail-folder-hover-actions,
    .mail-account-folder-row:hover .mail-folder-hover-actions,
    .mail-account-folder-row:focus-within .mail-folder-hover-actions {
        display: inline-flex;
    }

    .mail-folder-action {
        flex-shrink: 0;
        border: @(AppMeasures.Border.Thin)px solid transparent;
        background: transparent;
        color: @AppColors.TextMuted.ToRgbaHex(true);
        border-radius: @(AppMeasures.Radius.Small)px;
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px5)px;
        font-size: @(AppMeasures.Font.XSmall)px;
        cursor: pointer;
        transition: color @(AppMeasures.Duration.Fast)s ease, border-color @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-folder-action:hover {
            color: @AppColors.Primary.ToRgbaHex(true);
            border-color: @AppColors.GlassBorderDefault.ToRgbaHex(true);
        }

    .mail-folder-row--noselect .mail-folder {
        cursor: default;
        opacity: 0.7;
    }

    .mail-account-dot {
        width: @(AppMeasures.Size.Px10)px;
        height: @(AppMeasures.Size.Px10)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        flex-shrink: 0;
    }

    .mail-account-name, .mail-folder-name {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-unread-badge {
        background: @AppColors.Primary.ToRgbaHex(true);
        color: @AppColors.TextOnAccent.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Tiny)px;
        font-weight: @(AppMeasures.Weight.Bold);
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        margin-left: auto;
        flex-shrink: 0;
    }

    .mail-empty-cta {
        padding: @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        border: @(AppMeasures.Border.Thin)px dashed @AppColors.Primary.ToRgbaHex(true);
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        color: @AppColors.Primary.ToRgbaHex(true);
        font-weight: @(AppMeasures.Weight.Bold);
        cursor: pointer;
    }
</style>
