@namespace MyLovelyMail.MainProject.UI.Pages
@inherits ThemedComponentBase
@using System.Globalization
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings

@{
    string textPrimary = AppColors.TextPrimary.ToRgbaHex(true);
    string textSecondary = AppColors.TextSecondary.ToRgbaHex(true);
    string textMuted = AppColors.TextMuted.ToRgbaHex(true);
    string primary = AppColors.Primary.ToRgbaHex(true);
    string surfaceTint = AppColors.SurfaceTintPrimary.ToRgbaHex(true);
    string splitterColor = AppStyles.ResolvedScrollbarColorHex();
    string paneHeight = $"calc({AppMeasures.Viewport.Full}vh - {AppMeasures.Space.Px90 + AppMeasures.Space.Medium * 2}px)";
    string sidebarPct = GlobalSettings.SidebarColumnPercent.Value.ToString("0.######", CultureInfo.InvariantCulture);
    string listPct = GlobalSettings.ListColumnPercent.Value.ToString("0.######", CultureInfo.InvariantCulture);
    string readerPct = GlobalSettings.ReaderColumnPercent.Value.ToString("0.######", CultureInfo.InvariantCulture);
}

<style>
    .@(MailCssClasses.Screen) {
        --col-sidebar-pct: @(sidebarPct)%;
        --col-list-pct: @(listPct)%;
        --col-reader-pct: @(readerPct)%;
        display: grid;
        grid-template-columns: minmax(180px, var(--col-sidebar-pct)) @(AppMeasures.Space.Medium)px minmax(260px, var(--col-list-pct)) @(AppMeasures.Space.Medium)px minmax(280px, 1fr);
        gap: 0;
        padding: @(AppMeasures.Space.Medium)px;
        box-sizing: border-box;
        min-height: calc(@(AppMeasures.Viewport.Full)vh - @(AppMeasures.Space.Px90)px);
        align-items: start;
    }

    .@(MailCssClasses.ScreenResizing),
    .@(MailCssClasses.ScreenResizing) * {
        user-select: none !important;
        cursor: col-resize !important;
    }

    /* Invisible until hovered or actively dragged; sits in the 16px column gap between panes. */
    .@(MailCssClasses.ColumnSplitter) {
        width: @(AppMeasures.Space.Medium)px;
        height: @paneHeight;
        position: sticky;
        top: @(AppMeasures.Space.Medium)px;
        cursor: col-resize;
        display: flex;
        align-items: stretch;
        justify-content: center;
        background: transparent;
        user-select: none;
        z-index: 15;
    }

    .@(MailCssClasses.ColumnSplitterGrip) {
        display: none;
    }

    .@(MailCssClasses.ColumnSplitter)::after {
        content: "";
        width: 3px;
        background: @splitterColor;
        opacity: 0;
        border-radius: 999px;
        transition: opacity @(AppMeasures.Duration.Fast)s ease, width @(AppMeasures.Duration.Fast)s ease, box-shadow @(AppMeasures.Duration.Fast)s ease;
    }

    .@(MailCssClasses.ColumnSplitter):hover::after,
    .@(MailCssClasses.ColumnSplitter):active::after,
    .@(MailCssClasses.ColumnSplitterDragging)::after {
        opacity: 0.9;
        width: 4px;
        box-shadow: 0 0 8px @splitterColor;
    }

    /* ---- Sidebar ---- */

    .mail-sidebar {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px4)px;
        overflow-y: auto;
        min-height: 0;
        position: sticky;
        top: @(AppMeasures.Space.Medium)px;
        height: @paneHeight;
    }

    .mail-sidebar-nav {
        display: contents;
    }

    .mail-logo {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @textPrimary;
        padding: @(AppMeasures.Space.Px12)px @(AppMeasures.Space.Px8)px;
    }

    .mail-logo-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mail-drag-escape-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: @surfaceTint;
        border: @(AppMeasures.Border.Thin)px dashed @primary;
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @textPrimary;
    }

    .mail-welcome-card {
        text-align: center;
    }

    .mail-welcome-icon {
        font-size: @(AppMeasures.Font.Giant)px;
    }

    .mail-welcome-title {
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        margin: @(AppMeasures.Space.Px8)px 0;
    }

    .mail-welcome-text {
        color: @textSecondary;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        margin: 0 0 @(AppMeasures.Space.Px16)px 0;
    }

    .mail-account {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        border: none;
        background: transparent;
        cursor: pointer;
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        font-weight: @(AppMeasures.Weight.Medium);
        color: @textPrimary;
        text-align: left;
        transition: background @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-account:hover,
        .mail-account--active {
            background: @surfaceTint;
        }

    .mail-account-dot {
        width: @(AppMeasures.Size.Px12)px;
        height: @(AppMeasures.Size.Px12)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        flex-shrink: 0;
    }

    .mail-account--paused {
        opacity: @(AppMeasures.Opacity.Muted);
    }

        .mail-account--paused .mail-account-dot {
            filter: grayscale(1);
        }

    .mail-account-failing,
    .mail-account-paused {
        flex-shrink: 0;
        font-size: @(AppMeasures.Font.Small)px;
    }

    .mail-account-ordinal {
        flex-shrink: 0;
        min-width: @(AppMeasures.Size.Px16)px;
        text-align: center;
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @AppColors.TextMuted.ToRgbaHex(true);
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        border-radius: @(AppMeasures.Radius.Px4)px;
        padding: 0 @(AppMeasures.Space.Px2)px;
    }

    .mail-account-name {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-account-unread {
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        flex-shrink: 0;
    }

    /* Folder row with left indentation gutter (chevron + muted bell) and zero-width-until-hovered action strip (2.png fix). */
    .mail-folder-row {
        display: flex;
        align-items: center;
        padding-left: calc(@(AppMeasures.Space.Px6)px + var(--folder-depth, 0) * @(AppMeasures.Space.Px12)px);
        border-radius: @(AppMeasures.Radius.Medium)px;
        transition: background @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-folder-row:hover {
            background: @surfaceTint;
        }

    .mail-folder-gutter {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 2px;
        min-width: @(AppMeasures.Size.Px16)px;
        flex-shrink: 0;
    }

    .mail-folder-chevron {
        border: none;
        background: transparent;
        color: @textMuted;
        cursor: pointer;
        padding: 0 2px;
        font-size: @(AppMeasures.Font.XSmall)px;
        line-height: 1;
    }

        .mail-folder-chevron:hover {
            color: @primary;
        }

    .mail-folder-muted-gutter {
        font-size: @(AppMeasures.Font.XSmall)px;
        line-height: 1;
        flex-shrink: 0;
    }

    .mail-folder-row > .mail-folder {
        flex: 1;
        min-width: 0;
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px4)px;
    }

    .mail-folder-hover-actions {
        display: none;
        align-items: center;
        gap: 2px;
        flex-shrink: 0;
    }

    .mail-folder-row:hover .mail-folder-hover-actions,
    .mail-folder-row:focus-within .mail-folder-hover-actions,
    .mail-account-folder-row:hover .mail-folder-hover-actions,
    .mail-account-folder-row:focus-within .mail-folder-hover-actions {
        display: inline-flex;
    }

    .mail-folder-action {
        flex-shrink: 0;
        border: none;
        background: transparent;
        cursor: pointer;
        opacity: @(AppMeasures.Opacity.Muted);
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Small)px;
        font-size: @(AppMeasures.Font.Small)px;
        color: @textSecondary;
        transition: opacity @(AppMeasures.Duration.Fast)s ease, background @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-folder-action:hover {
            opacity: 1;
            color: @textPrimary;
            background: @surfaceTint;
        }

    .mail-folder {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        border: none;
        background: transparent;
        cursor: pointer;
        padding: @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        color: @textSecondary;
        font-size: @(AppMeasures.Font.Normal)px;
        text-align: left;
        transition: all @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-folder:hover {
            color: @textPrimary;
        }

    .mail-folder--active {
        background: @surfaceTint;
        color: var(--account-accent, @primary);
        font-weight: @(AppMeasures.Weight.Medium);
    }

    .mail-folder-icon {
        flex-shrink: 0;
    }

    .mail-folder-name {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-account-folder-row {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
        padding-left: calc(var(--acc-folder-depth, 0) * @(AppMeasures.Space.Px12)px);
        border-radius: @(AppMeasures.Radius.Medium)px;
        transition: background @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-account-folder-row:hover {
            background: @surfaceTint;
        }

    .mail-account-folder-toggle {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        border: none;
        background: transparent;
        cursor: pointer;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px8)px;
        color: @textSecondary;
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Bold);
        text-align: left;
    }

    .mail-account-folder-chevron {
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @textMuted;
        width: @(AppMeasures.Size.Px12)px;
        text-align: center;
    }

    .mail-account-folder-name {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-account-folder-action {
        opacity: @(AppMeasures.Opacity.Muted);
    }

    .mail-drop-target {
        outline: @(AppMeasures.Border.Medium)px dashed @primary;
        background: @surfaceTint;
    }

</style>
