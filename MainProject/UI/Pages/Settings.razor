@attribute [Route(NavigationConstants.Settings.Link)]
@inherits MyLovelyMail.MainProject.UI.Layout.Architecture.PageBase
@implements IDisposable
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings
<PageTitle>Settings — My Lovely Mail</PageTitle>

<div class="settings-screen">
    <h1 class="settings-title">⚙️ Settings</h1>

    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">🎨 Appearance</div>
        <div class="settings-themes">
            @foreach (var theme in AppThemes.All)
            {
                <button class="settings-theme @(ThemeManager.Current == theme ? "settings-theme--active" : "")"
                        style="@ThemePreviewStyle(theme)"
                        @onclick="() => ApplyTheme(theme)">
                    <span class="settings-theme-mini">
                        <span class="settings-theme-mini-sidebar" style="background:@theme.Primary.WithAlpha(0.8f).ToRgbaHex(true)"></span>
                        <span class="settings-theme-mini-list">
                            <span class="settings-theme-mini-row" style="background:@theme.SurfaceStrong.ToRgbaHex(true)">
                                <span class="settings-theme-mini-unread" style="background:@theme.Accent.ToRgbaHex(true)"></span>
                            </span>
                            <span class="settings-theme-mini-row" style="background:@theme.SurfaceNormal.ToRgbaHex(true)"></span>
                            <span class="settings-theme-mini-row" style="background:@theme.Secondary.WithAlpha(0.35f).ToRgbaHex(true)"></span>
                        </span>
                    </span>
                    <span class="settings-theme-name" style="color:@theme.TextPrimary.ToRgbaHex(true)">@theme.Name</span>
                </button>
            }
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Follow the @PlatformFeatures.SystemName theme</span>
                <span class="settings-row-hint">Picks the light or dark palette automatically instead of the one chosen above</span>
            </div>
            <CoreToggle Checked="@GlobalSettings.FollowSystemTheme.Value" CheckedChanged="@SetFollowSystemTheme" />
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Follow the @PlatformFeatures.SystemName animation setting</span>
                <span class="settings-row-hint">Takes the answer below from @PlatformFeatures.SystemName instead of the switch</span>
            </div>
            <CoreToggle Checked="@GlobalSettings.FollowSystemMotion.Value" CheckedChanged="@SetFollowSystemMotion" />
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Calm motion</span>
                <span class="settings-row-hint">Stops the looping animations — the aurora, the sync heart and the pulses</span>
            </div>
            <CoreToggle Checked="@GlobalSettings.ReduceMotion.Value"
                        Disabled="@GlobalSettings.FollowSystemMotion.Value"
                        CheckedChanged="@SetReduceMotion" />
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Interface scale (%)</span>
                <span class="settings-row-hint">Scales the whole interface; 100 is the design size</span>
            </div>
            <div class="settings-number">
                <CoreInput Type="number" Value="@GlobalSettings.UiScalePercent.Value.ToString()" ValueChanged="@SetUiScale" />
            </div>
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Unread count badges</span>
                <span class="settings-row-hint">Shows the number of unread messages on accounts and folders</span>
            </div>
            <CoreToggle Checked="@GlobalSettings.ShowUnreadBadge.Value" CheckedChanged="@(v => SetAndSave(GlobalSettings.ShowUnreadBadge, v))" />
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Message list density</span>
                <span class="settings-row-hint">Cozy shows two preview lines; Compact fits the most rows</span>
            </div>
            <div class="settings-density">
                @foreach (var density in DensityOptions)
                {
                    <button class="settings-density-option @(GlobalSettings.MessageListDensity.Value == density ? "settings-density-option--on" : "")"
                            @onclick="() => SetDensity(density)">@density</button>
                }
            </div>
        </div>
    </GlassCard>

    @* The tray, a minimized start and the sign-in autostart belong to a desktop window. On a phone the
       app starts with the system on its own and has no window to hide. *@
    @if (PlatformFeatures.HasDesktopWindow)
    {
    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">🪟 Window &amp; startup</div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Close to tray</span>
                <span class="settings-row-hint">Closing the window hides the app instead of exiting</span>
            </div>
            <CoreToggle Checked="@GlobalSettings.CloseToTray.Value" CheckedChanged="@(v => SetAndSave(GlobalSettings.CloseToTray, v))" />
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Start minimized</span>
                <span class="settings-row-hint">Open hidden in the tray at launch</span>
            </div>
            <CoreToggle Checked="@GlobalSettings.StartMinimized.Value" CheckedChanged="@(v => SetAndSave(GlobalSettings.StartMinimized, v))" />
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Start with Windows</span>
                <span class="settings-row-hint">Launch automatically when you sign in</span>
            </div>
            <CoreToggle Checked="@GlobalSettings.StartWithWindows.Value" CheckedChanged="@(v => SetAndSave(GlobalSettings.StartWithWindows, v))" />
        </div>
    </GlassCard>
    }

    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">🔔 Notifications</div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Notify on new mail</span>
                <span class="settings-row-hint">Show a notification when mail arrives</span>
            </div>
            <CoreToggle Checked="@GlobalSettings.NotifyOnNewMail.Value" CheckedChanged="@(v => SetAndSave(GlobalSettings.NotifyOnNewMail, v))" />
        </div>
    </GlassCard>

    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">🔄 Sync</div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Sync interval (minutes)</span>
                <span class="settings-row-hint">How often accounts check for new mail</span>
            </div>
            <div class="settings-number">
                <CoreInput Type="number" Value="@GlobalSettings.SyncIntervalMinutes.Value.ToString()" ValueChanged="@SetSyncInterval" />
            </div>
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Other folders refreshed per sync</span>
                <span class="settings-row-hint">Keeps folders you rarely open findable by search; 0 syncs the inbox only</span>
            </div>
            <div class="settings-number">
                <CoreInput Type="number" Value="@GlobalSettings.BackgroundFolderRefreshCount.Value.ToString()" ValueChanged="@SetBackgroundFolderRefresh" />
            </div>
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Instant push (IMAP IDLE)</span>
                <span class="settings-row-hint">Keep a live connection so mail arrives immediately</span>
            </div>
            <CoreToggle Checked="@GlobalSettings.UseImapIdle.Value" CheckedChanged="@(v => SetAndSave(GlobalSettings.UseImapIdle, v))" />
        </div>
    </GlassCard>

    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">📖 Reading</div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Fold quoted history</span>
                <span class="settings-row-hint">Collapses the older thread under a "Show quoted text" line in the reader</span>
            </div>
            <CoreToggle Checked="@GlobalSettings.FoldQuotedText.Value" CheckedChanged="@(v => SetAndSave(GlobalSettings.FoldQuotedText, v))" />
        </div>
    </GlassCard>

    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">✍️ Composing</div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Quote the original in replies</span>
                <span class="settings-row-hint">Trimmed keeps the head and drops the history the message was already carrying</span>
            </div>
            <div class="settings-density">
                @foreach (var style in Enum.GetValues<QuoteStyle>())
                {
                    <button class="settings-density-option @(GlobalSettings.ReplyQuoteStyle.Value == style ? "settings-density-option--on" : "")"
                            @onclick="() => SetAndSave(GlobalSettings.ReplyQuoteStyle, style)">@style</button>
                }
            </div>
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Undo send window (seconds)</span>
                <span class="settings-row-hint">A sent message waits this long behind an Undo bar; 0 sends immediately</span>
            </div>
            <div class="settings-number">
                <CoreInput Type="number" Value="@GlobalSettings.UndoSendSeconds.Value.ToString()" ValueChanged="@SetUndoSendSeconds" />
            </div>
        </div>
    </GlassCard>

    @* Its own card, not a row inside Composing: a signature is content the user writes, and it
       needs an editor and a preview rather than a one-line field. *@
    <GlassCard CustomClass="settings-section">
        <SignatureEditor Value="@GlobalSettings.Signature.Value"
                         ValueChanged="@(value => SetAndSave(GlobalSettings.Signature, value))" />
    </GlassCard>

    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">🧹 Filters</div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Mail filters</span>
                <span class="settings-row-hint">@FilterRuleStore.Rules.Count rule(s) — sort, tag, mute and move incoming mail automatically</span>
            </div>
            <SecondaryButton OnClick="@(() => NavManager.NavigateTo(UI.Pages.FilterRules.RoutePath))">🧹 Manage</SecondaryButton>
        </div>
    </GlassCard>

    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">📦 Data &amp; migration</div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Migration bundle</span>
                <span class="settings-row-hint">One file with settings, accounts, filters, tags and passwords, encrypted as a whole under the passphrase. Mail re-syncs on the new machine.</span>
            </div>
        </div>
        <div class="settings-vault-switch">
            <CoreInput Placeholder="Bundle path (e.g. D:\lovely-backup)" @bind-Value="BundlePath" />
            <CoreInput Type="password" Placeholder="Passphrase" @bind-Value="BundlePassphrase" />
        </div>
        <div class="settings-migration-actions">
            <SecondaryButton OnClick="@ExportBundle" Disabled="@(BundlePath.Trim().Length == 0 || BundlePassphrase.Length == 0)">⬆️ Export</SecondaryButton>
            <SecondaryButton OnClick="@ImportBundle" Disabled="@(BundlePath.Trim().Length == 0 || BundlePassphrase.Length == 0)">⬇️ Import</SecondaryButton>
        </div>
        @if (MigrationStatus != null)
        {
            <p class="settings-empty-text">@MigrationStatus</p>
        }
    </GlassCard>

    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">🧰 Diagnostics</div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Enable logging</span>
                <span class="settings-row-hint">Buffers app logs in memory for the log viewer</span>
            </div>
            <CoreToggle Checked="@GlobalSettings.EnableLogging.Value" CheckedChanged="@SetLogging" />
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Log viewer</span>
                <span class="settings-row-hint">Inspect, filter and export buffered logs</span>
            </div>
            <SecondaryButton OnClick="@(() => NavManager.NavigateTo(UI.Pages.Logs.RoutePath))">🧾 Open</SecondaryButton>
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Cached mail check</span>
                <span class="settings-row-hint">@StoreCheckLine</span>
            </div>
            <SecondaryButton OnClick="@RunStoreCheck" Disabled="@StoreCheckRunning">
                @if (StoreCheckRunning)
                {
                    <CoreSpinner SizePx="18" BorderWidthPx="2" Color="@AppColors.TextPrimary" />
                }
                🔎 Scan
            </SecondaryButton>
        </div>
    </GlassCard>

    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">🔐 Vault protection</div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Current mode: @(GlobalSettings.CredentialVaultMode.Value == VaultMode.DeviceBound ? DeviceProtection.DisplayName : "Master password (AES)")</span>
                <span class="settings-row-hint">@(GlobalSettings.CredentialVaultMode.Value == VaultMode.DeviceBound ? DeviceProtection.Description : "Portable, but asks for the master password.")</span>
            </div>
            @if (GlobalSettings.CredentialVaultMode.Value == VaultMode.MasterPassword && CredentialVault.IsUnlocked)
            {
                <SecondaryButton OnClick="@CredentialVault.LockNow">🔒 Lock now</SecondaryButton>
            }
        </div>
        @if (!CredentialVault.IsUnlocked)
        {
            <p class="settings-empty-text">Unlock the vault to change its protection mode.</p>
        }
        else if (GlobalSettings.CredentialVaultMode.Value == VaultMode.DeviceBound)
        {
            <div class="settings-row">
                <div class="settings-row-text">
                    <span class="settings-row-label">Switch to a master password</span>
                    <span class="settings-row-hint">Re-encrypts stored passwords under a password you choose</span>
                </div>
            </div>
            <div class="settings-vault-switch">
                <CoreInput Type="password" Placeholder="New master password" Icon="🗝️" @bind-Value="NewMasterPassword" />
                <PrimaryButton OnClick="@SwitchVaultToMaster" Disabled="@(NewMasterPassword.Length == 0)">🔁 Switch</PrimaryButton>
            </div>
        }
        else
        {
            <div class="settings-row">
                <div class="settings-row-text">
                    <span class="settings-row-label">Switch back to @DeviceProtection.DisplayName</span>
                    <span class="settings-row-hint">No more password prompts on this device</span>
                </div>
                <SecondaryButton OnClick="@SwitchVaultToDeviceBound">🔁 Switch</SecondaryButton>
            </div>
        }
    </GlassCard>

    @* How to REACH Tor lives here; whether an account may only use it is that account's own
       switch, on its settings page — it belongs to the mailbox, not to this machine. *@
    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">🛡️ Tor</div>
        <p class="settings-empty-text">
            @if (TorOnlyAccounts.Count == 0)
            {
                <text>No account is set to Tor-only yet. Turn it on for an account under its ⚙️ Settings; these values are how this app finds Tor.</text>
            }
            else
            {
                <text>Used by @string.Join(", ", TorOnlyAccounts). Those accounts never connect any other way.</text>
            }
        </p>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">SOCKS proxy</span>
                <span class="settings-row-hint">
                    Where Tor listens. 9050 is the tor daemon's port and 9150 a running Tor Browser's; both are
                    tried even when the value here is neither. Keep it on loopback — traffic to a proxy elsewhere
                    would leave this machine before Tor ever saw it.
                </span>
            </div>
            <div class="settings-vault-switch">
                <CoreInput Value="@GlobalSettings.TorSocksHost.Value" ValueChanged="@SetTorHost" />
                <CoreInput Type="number" Value="@GlobalSettings.TorSocksPort.Value.ToString()" ValueChanged="@SetTorPort" />
            </div>
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Start Tor when none is running</span>
                <span class="settings-row-hint">@TorAutoStartHint</span>
            </div>
            <CoreToggle Checked="@GlobalSettings.TorAutoStart.Value" CheckedChanged="@(v => SetAndSave(GlobalSettings.TorAutoStart, v))" />
        </div>
        @* Only where the app searches for a tor. The Android app runs the one inside its own package,
           and no path typed here could point at anything Android would let it execute. *@
        @if (TorProcess.BundledExecutablePath == null)
        {
            <div class="settings-row">
                <div class="settings-row-text">
                    <span class="settings-row-label">Tor executable</span>
                    <span class="settings-row-hint">Empty searches PATH, the app folder and the usual Tor Browser locations. @TorExecutableLine</span>
                </div>
                <div class="settings-number settings-number--wide">
                    <CoreInput Placeholder="(searched automatically)" Value="@GlobalSettings.TorExecutablePath.Value" ValueChanged="@SetTorExecutable" />
                </div>
            </div>
        }
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Bridges</span>
                <span class="settings-row-hint">
                    One per line, as bridges.torproject.org gives them. For a network that blocks Tor itself; empty uses the public network. @TorBridgeLine
                </span>
            </div>
        </div>
        <div class="settings-vault-switch">
            <textarea class="wizard-select settings-bridge-input" rows="3" spellcheck="false"
                      placeholder="obfs4 10.0.0.1:443 FINGERPRINT cert=... iat-mode=0"
                      value="@BridgeText" @onchange="@(e => SetBridges(e.Value?.ToString() ?? string.Empty))"></textarea>
        </div>
        <div class="settings-row">
            <div class="settings-row-text">
                <span class="settings-row-label">Route</span>
                @* polite, not assertive: this line changes several times during a bootstrap and a
                   screen reader should finish the sentence it is on before taking the next one. *@
                <span class="settings-row-hint" aria-live="polite">@TorRouteLine</span>
            </div>
        </div>
        <div class="settings-migration-actions">
            <SecondaryButton OnClick="@CheckTorAsync" Disabled="@TorBusy">
                @if (TorBusy)
                {
                    <CoreSpinner SizePx="18" BorderWidthPx="2" Color="@AppColors.TextPrimary" />
                }
                🛡️ Check the Tor route
            </SecondaryButton>
            @if (TorProcess.IsRunning)
            {
                <SecondaryButton OnClick="@StopTor">🛑 Stop the app's tor</SecondaryButton>
            }
        </div>
        @if (TorMessage != null)
        {
            <p class="settings-empty-text">@TorMessage</p>
        }
    </GlassCard>

    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">🗄️ Everything else</div>
        <p class="settings-empty-text">
            Registered settings without a card of their own above. They are edited raw — the name is
            the field name — but they are reachable, and a setting added later shows up here by
            itself instead of shipping invisible.
        </p>
        @foreach (var setting in UncardedSettings)
        {
            <SettingEditorRow Setting="@setting" OnSaved="@SettingsManager.SaveSettings" />
        }
    </GlassCard>

    <GlassCard CustomClass="settings-section">
        <div class="settings-section-title">👤 Accounts</div>
        @if (AccountStore.Accounts.Count == 0)
        {
            <p class="settings-empty-text">No accounts yet.</p>
        }
        else
        {
            @foreach (var account in AccountStore.Accounts)
            {
                <div class="settings-row">
                    <div class="settings-row-text">
                        <span class="settings-row-label">
                            <span class="settings-account-dot" style="background:@account.ColorHex"></span>
                            @account.EmailAddress
                        </span>
                        <span class="settings-row-hint">@account.Protocol · @account.IncomingHost · @SyncHealthLine(account.Id)</span>
                    </div>
                    @* The rail order is also the Ctrl+1..9 order, so this is where that mapping is chosen. *@
                    <button class="settings-account-move" title="Move up" @onclick="() => AccountStore.Move(account.Id, -1)">▲</button>
                    <button class="settings-account-move" title="Move down" @onclick="() => AccountStore.Move(account.Id, 1)">▼</button>
                    <SecondaryButton OnClick="@(() => NavManager.NavigateTo(UI.Pages.AccountSettingsPage.RouteFor(account.Id)))">⚙️ Settings</SecondaryButton>
                    <DangerButton OnClick="@(() => RemoveAccount(account.Id))">🗑️ Remove</DangerButton>
                </div>
            }
        }
        <div class="settings-add-account">
            <PrimaryButton OnClick="@(() => NavManager.NavigateTo(UI.Pages.AccountWizard.RoutePath))">➕ Add account</PrimaryButton>
        </div>
    </GlassCard>

    <FolderSettingsPanel />
    <p class="settings-version">@AppConstants.AppNameHumanReadable @AppConstants.AppVersion</p>
</div>

<SettingsCss />

