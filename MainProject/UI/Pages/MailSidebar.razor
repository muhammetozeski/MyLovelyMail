@namespace MyLovelyMail.MainProject.UI.Pages
@inherits MailPageSection
@implements IDisposable
@inject NavigationManager Navigation
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings
@using System.IO
@using MyLovelyMail.MainProject.DataModels.Mail
@using MyLovelyMail.MainProject.Services
@using MyLovelyMail.MainProject.Services.Mail
@using MyLovelyMail.MainProject.Storage
@using MyLovelyMail.MainProject.Stores

    @* ---- Left: accounts + folders ---- *@
    <aside class="@MailCssClasses.Sidebar @(WorkspaceDragService.IsDragging ? MailCssClasses.SidebarWorkspaceDragging : "")" tabindex="-1" @onkeydown="HandleSidebarKeyDown">
        <div class="@MailCssClasses.Logo">
            <AppNavToggle />
            💌<span class="@MailCssClasses.LogoText">My Lovely Mail</span>
            <SyncHeart />
        </div>

        <CustomizableActionBar SurfaceId="@UiSurfaceIds.SidebarTop"
                               PairedMenuSurfaceId="@UiSurfaceIds.AccountContextMenu"
                               DefaultActions="@View.BuildSidebarTopActions()"
                               AddedActionResolver="@(id => View.ResolveToolbarAddedAction(UiSurfaceIds.SidebarTop, id))"
                               CustomClass="@MailCssClasses.SidebarTopBar"
                               Wrap="true" />

        @if (quickMailError != null)
        {
            <p class="@MailCssClasses.WizardTest @MailCssClasses.WizardTestFail" role="alert">@quickMailError</p>
        }

        @if (WorkspaceDragService.IsDragging)
        {
            <div class="@MailCssClasses.DragEscapeBanner">
                <span>🎯 @WorkspaceDragService.TargetHint — <kbd>Esc</kbd></span>
                <button type="button" class="@MailCssClasses.FolderAction" title="Cancel drag (Esc)" @onclick="() => WorkspaceDragService.Cancel()">✕</button>
            </div>
        }

        @if (Mail.SavedSearchList.Count > 0)
        {
            <div class="@MailCssClasses.SavedSearches">
                @foreach (var saved in Mail.SavedSearchList)
                {
                    <span class="@MailCssClasses.SavedChip"
                          @onmouseup="e => HandleSavedSearchSideMouse(saved, e)"
                          @onmouseup:stopPropagation="true"
                          @oncontextmenu="e => View.OpenSavedSearchMenu(saved, e)"
                          @oncontextmenu:preventDefault="true"
                          @oncontextmenu:stopPropagation="true">
                        <button class="@MailCssClasses.SavedRun" @onclick="() => View.RunSavedSearch(saved)">🔎 @saved</button>
                        <button class="@MailCssClasses.SavedRemove" @onclick="() => Mail.RemoveSavedSearch(saved)">✕</button>
                    </span>
                }
            </div>
        }

        <nav class="@MailCssClasses.SidebarNav">
            @foreach (var rootFolder in AccountFolderStore.GetRootFolders())
            {
                @RenderAccountFolderTree(rootFolder, 0)
            }
            @if (DeletedFolderStore.GetAccountGroups() is { Count: > 0 } deletedGroups)
            {
                bool groupBinActive = MailUiState.IsViewingDeletedFolders && MailUiState.DeletedFoldersAccountFilter == null;
                <div class="@MailCssClasses.AccountFolderRow @MailCssClasses.DeletedFoldersBin @(groupBinActive ? MailCssClasses.DeletedFoldersBinActive : "")"
                     data-deleted-account-groups="true"
                     @oncontextmenu="e => View.OpenDeletedFoldersMenu(null, e)"
                     @oncontextmenu:preventDefault="true"
                     @oncontextmenu:stopPropagation="true">
                    <button class="@MailCssClasses.AccountFolderToggle"
                            type="button"
                            title="Deleted account group folders — right-click for auto-delete settings"
                            @onclick="() => MailUiState.SelectDeletedFoldersBin(null)">
                        <span class="@MailCssClasses.AccountFolderIcon">🗑️</span>
                        <span class="@MailCssClasses.AccountFolderName">Group Trash (@deletedGroups.Count)</span>
                        <span class="@MailCssClasses.FolderRetentionTag">@TrashRetentionService.BuildDeletedFoldersBadge()</span>
                    </button>
                </div>
            }
        </nav>

        @if (AccountStore.Accounts.Count == 0)
        {
            <GlassCard Level="AcrylicLevel.Normal" CustomClass="@MailCssClasses.WelcomeCard">
                <div class="@MailCssClasses.WelcomeIcon">🌸</div>
                <div class="@MailCssClasses.WelcomeTitle">Welcome!</div>
                <p class="@MailCssClasses.WelcomeText">Add your first mail account and your inbox will bloom here.</p>
                <PrimaryButton IsFullWidth="true" OnClick="@(() => ModalService.OpenAddAccount(AccountFolderStore.DefaultFolderId))">
                    ➕ Add account
                </PrimaryButton>
            </GlassCard>
        }

        @if (View.FolderActionStatus != null)
        {
            <div class="@MailCssClasses.SidebarStatus">@View.FolderActionStatus</div>
        }
        else if (SyncScheduler.IsSyncing && !string.IsNullOrWhiteSpace(SyncScheduler.ActiveSyncSummary))
        {
            <div class="@MailCssClasses.SidebarStatus" title="@SyncScheduler.ActiveSyncSummary">🔄 @SyncScheduler.ActiveSyncSummary</div>
        }
    </aside>

@code {
    readonly HashSet<string> quickMailPending = [];
    string? quickMailError;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        View.TryCancelSidebarDrag = WorkspaceDragService.Cancel;
        WorkspaceDragService.OnStateChanged += HandleDragStateChanged;
        DeletedFolderStore.OnChanged += HandleDragStateChanged;
        TrashRetentionService.OnRetentionChanged += HandleDragStateChanged;
        FolderSettingsStore.OnChanged += HandleDragStateChanged;
    }

    void HandleDragStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        WorkspaceDragService.OnStateChanged -= HandleDragStateChanged;
        DeletedFolderStore.OnChanged -= HandleDragStateChanged;
        TrashRetentionService.OnRetentionChanged -= HandleDragStateChanged;
        FolderSettingsStore.OnChanged -= HandleDragStateChanged;
        if (View?.TryCancelSidebarDrag == WorkspaceDragService.Cancel)
            View.TryCancelSidebarDrag = null;
    }

    static void HandleSidebarKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            WorkspaceDragService.Cancel();
    }

    void HandleSavedSearchSideMouse(string saved, MouseEventArgs e)
    {
        if (e.Button == 3) Mail.RemoveSavedSearch(saved);
        else if (e.Button == 4) View.RunSavedSearch(saved);
    }

    Task HandleAccountSideMouseAsync(MailAccountData account, MouseEventArgs e)
    {
        if (e.Button == 3) { View.OpenAccountMenu(account, e); return Task.CompletedTask; }
        if (e.Button == 4) return MouseActionService.RunAsync(MouseActionService.AccountSyncAction, account.Id);
        return Task.CompletedTask;
    }

    Task HandleFolderSideMouseAsync(MailFolderData folder, MouseEventArgs e)
    {
        if (e.Button == 3) { View.OpenFolderMenu(folder, e); return Task.CompletedTask; }
        if (e.Button == 4) return MouseActionService.ReadFolderAsync(folder);
        return Task.CompletedTask;
    }

    async Task CreateQuickMailAsync(string folderId)
    {
        if (!quickMailPending.Add(folderId)) return;
        quickMailError = null;
        try
        {
            var account = await Services.Mail.FastMail.FastMailAccountService.CreateMailTmAsync(folderId);
            MailUiState.SelectAccount(account);
            _ = Services.Mail.SyncScheduler.SyncNowAsync(accountId: account.Id);
        }
        catch (Exception ex)
        {
            quickMailError = ex.Message;
            Log($"One-click Mail.tm creation failed: {ex.GetType().Name}.", LogLevel.Error);
        }
        finally { quickMailPending.Remove(folderId); }
    }

    static string DropClassOf(WorkspaceDropPosition pos) => pos switch
    {
        WorkspaceDropPosition.Before => MailCssClasses.DropBefore,
        WorkspaceDropPosition.After => MailCssClasses.DropAfter,
        WorkspaceDropPosition.Into => MailCssClasses.DropTarget,
        _ => string.Empty
    };

    static void BeginAccountFolderPointerDown(AccountFolderData folder, PointerEventArgs e)
    {
        if (e.Button != 0) return;
        WorkspaceDragService.BeginAccountFolderCandidate(folder, e.ClientX, e.ClientY);
    }

    static void MoveAccountFolderPointer(AccountFolderData folder, PointerEventArgs e)
    {
        if ((e.Buttons & 1) == 0)
        {
            WorkspaceDragService.Cancel();
            return;
        }
        WorkspaceDragService.UpdatePointer(e.ClientX, e.ClientY);
        if (WorkspaceDragService.IsDragging)
            WorkspaceDragService.HoverAccountFolder(folder, e.OffsetY);
    }

    static Task EndAccountFolderPointerAsync(AccountFolderData folder, PointerEventArgs e)
    {
        if (!WorkspaceDragService.IsDragging) return Task.CompletedTask;
        return WorkspaceDragService.CompleteDropAsync();
    }

    static void BeginAccountPointerDown(MailAccountData account, PointerEventArgs e)
    {
        if (e.Button != 0) return;
        WorkspaceDragService.BeginAccountCandidate(account, e.ClientX, e.ClientY);
    }

    static void MoveAccountPointer(MailAccountData account, PointerEventArgs e)
    {
        if ((e.Buttons & 1) == 0)
        {
            WorkspaceDragService.Cancel();
            return;
        }
        WorkspaceDragService.UpdatePointer(e.ClientX, e.ClientY);
        if (WorkspaceDragService.IsDragging)
            WorkspaceDragService.HoverAccount(account, e.OffsetY);
    }

    static Task EndAccountPointerAsync(MailAccountData account, PointerEventArgs e)
    {
        if (!WorkspaceDragService.IsDragging) return Task.CompletedTask;
        return WorkspaceDragService.CompleteDropAsync();
    }

    static void HandleAccountClick(MailAccountData account)
    {
        if (WorkspaceDragService.ConsumeSuppressedClick()) return;
        MailUiState.SelectAccount(account, restoreFolder: true);
    }

    static void HandleAccountFolderClick(string folderId)
    {
        if (WorkspaceDragService.ConsumeSuppressedClick()) return;
        AccountFolderStore.ToggleExpanded(folderId);
    }

    static void BeginMailFolderPointerDown(MailFolderData folder, PointerEventArgs e)
    {
        if (e.Button != 0) return;
        WorkspaceDragService.BeginMailFolderCandidate(folder, e.ClientX, e.ClientY);
    }

    static void MoveMailFolderPointer(MailFolderData folder, PointerEventArgs e)
    {
        if ((e.Buttons & 1) == 0)
        {
            WorkspaceDragService.Cancel();
            return;
        }
        WorkspaceDragService.UpdatePointer(e.ClientX, e.ClientY);
        if (WorkspaceDragService.IsDragging)
            WorkspaceDragService.HoverMailFolder(folder, e.OffsetY);
    }

    static Task EndMailFolderPointerAsync(MailFolderData folder, PointerEventArgs e)
    {
        if (!WorkspaceDragService.IsDragging) return Task.CompletedTask;
        return WorkspaceDragService.CompleteDropAsync();
    }

    static void HandleMailFolderClick(MailFolderData folder)
    {
        if (WorkspaceDragService.ConsumeSuppressedClick()) return;
        MailUiState.SelectFolder(folder);
    }

    static int OrdinalOfAccount(MailAccountData account)
    {
        for (int i = 0; i < AccountStore.Accounts.Count; i++)
        {
            if (AccountStore.Accounts[i].Id == account.Id)
                return i;
        }
        return 99;
    }

    RenderFragment RenderAccountFolderTree(AccountFolderData accFolder, int depth) => __builder =>
    {
        var childFolders = AccountFolderStore.GetChildFolders(accFolder.Id);
        var folderAccounts = AccountStore.GetAccountsInFolder(accFolder.Id);
        string folderDropClass = DropClassOf(WorkspaceDragService.GetAccountFolderDropIndicator(accFolder.Id));

        <div class="@MailCssClasses.AccountFolderRow @folderDropClass"
             data-account-folder-id="@accFolder.Id"
             style="--acc-folder-depth:@depth"
             @onpointerdown="e => BeginAccountFolderPointerDown(accFolder, e)"
             @onpointerdown:stopPropagation="true"
             @onpointermove="e => MoveAccountFolderPointer(accFolder, e)"
             @onpointerup="e => EndAccountFolderPointerAsync(accFolder, e)"
             @oncontextmenu="e => View.OpenAccountFolderMenu(accFolder, e)"
             @oncontextmenu:preventDefault="true"
             @oncontextmenu:stopPropagation="true">

            <button class="@MailCssClasses.AccountFolderToggle"
                    type="button"
                    title="@(accFolder.IsExpanded ? "Collapse folder (drag to reorder)" : "Expand folder (drag to reorder)")"
                    @onclick="() => HandleAccountFolderClick(accFolder.Id)">
                <span class="@MailCssClasses.AccountFolderChevron">@(accFolder.IsExpanded ? "▾" : "▸")</span>
                <span class="@MailCssClasses.AccountFolderIcon">@(accFolder.IsExpanded ? "📂" : "📁")</span>
                <span class="@MailCssClasses.AccountFolderName">@accFolder.Name</span>
            </button>

            <CustomizableActionBar SurfaceId="@UiSurfaceIds.SidebarAccountFolderHover"
                                   PairedMenuSurfaceId="@UiSurfaceIds.AccountFolderContextMenu"
                                   DefaultActions="@View.BuildSidebarAccountFolderHoverActions(accFolder, () => CreateQuickMailAsync(accFolder.Id), quickMailPending.Contains(accFolder.Id), quickMailError)"
                                   AddedActionResolver="@(id => View.ResolveToolbarAddedAction(UiSurfaceIds.SidebarAccountFolderHover, id, accountFolderContext: accFolder))"
                                   Compact="true"
                                   StopClickPropagation="true"
                                   CustomClass="@MailCssClasses.FolderHoverActions" />
        </div>

        @if (accFolder.IsExpanded)
        {
            @foreach (var sub in childFolders)
            {
                @RenderAccountFolderTree(sub, depth + 1)
            }

            @foreach (var account in folderAccounts)
            {
                int accountIndex = OrdinalOfAccount(account);
                string accountDropClass = DropClassOf(WorkspaceDragService.GetAccountDropIndicator(account.Id));

                <button class="@MailCssClasses.Account @(MailUiState.SelectedAccount?.Id == account.Id ? MailCssClasses.AccountActive : "") @(account.Enabled ? "" : MailCssClasses.AccountPaused) @accountDropClass"
                        type="button"
                        data-account-id="@account.Id"
                        style="padding-left: calc(12px + @(depth + 1) * 12px);"
                        title="@Mail.SyncHealthTooltip(account)"
                        @onpointerdown="e => BeginAccountPointerDown(account, e)"
                        @onpointerdown:stopPropagation="true"
                        @onpointermove="e => MoveAccountPointer(account, e)"
                        @onpointerup="e => EndAccountPointerAsync(account, e)"
                        @onmouseup="e => HandleAccountSideMouseAsync(account, e)"
                        @onmouseup:stopPropagation="true"
                        @oncontextmenu="e => View.OpenAccountMenu(account, e)"
                        @oncontextmenu:preventDefault="true"
                        @oncontextmenu:stopPropagation="true"
                        @onclick="() => HandleAccountClick(account)">
                    <span class="@MailCssClasses.AccountDot" style="background:@account.ColorHex"></span>
                    @if (account.Protocol == IncomingProtocol.FastMail)
                    {
                        <span class="@MailCssClasses.AccountPausedIcon" title="Fast Mail (Tor-only)">⚡</span>
                    }
                    @if (!account.Enabled)
                    {
                        <span class="@MailCssClasses.AccountPausedIcon" title="Paused — not syncing">⏸️</span>
                    }
                    @if (SyncHealthService.For(account.Id).IsFailing)
                    {
                        <span class="@MailCssClasses.AccountFailing" title="@Mail.SyncHealthTooltip(account)">⚠️</span>
                    }
                    @if (accountIndex < 9)
                    {
                        <span class="@MailCssClasses.AccountOrdinal">@(accountIndex + 1)</span>
                    }
                    <span class="@MailCssClasses.AccountName">@(string.IsNullOrWhiteSpace(account.DisplayName) ? (string.IsNullOrWhiteSpace(account.Title) ? account.EmailAddress : $"{account.Title} ({account.EmailAddress})") : account.DisplayName)</span>
                    @if (GlobalSettings.ShowUnreadBadge.Value && Mail.AccountUnreadCount(account.Id) is > 0 and var accountUnread)
                    {
                        <span class="@MailCssClasses.AccountUnread" style="background:@account.ColorHex;color:@AppColors.InkOn(account.ColorHex).ToRgbaHex(true)">@accountUnread</span>
                    }
                </button>

                @if (MailUiState.SelectedAccount?.Id == account.Id)
                {
                    @foreach (var node in View.Folders)
                    {
                        var folder = node.Folder;
                        string mailFolderDropClass = DropClassOf(WorkspaceDragService.GetMailFolderDropIndicator(folder.AccountId, folder.FullName));
                        bool isMuted = FolderSettingsStore.IsMuted(folder);
                        <div class="@MailCssClasses.FolderRow @mailFolderDropClass"
                             data-mail-folder="@folder.FullName"
                             style="--folder-depth:@(node.Depth + depth + 1)"
                             @onpointerdown="e => BeginMailFolderPointerDown(folder, e)"
                             @onpointerdown:stopPropagation="true"
                             @onpointermove="e => MoveMailFolderPointer(folder, e)"
                             @onpointerup="e => EndMailFolderPointerAsync(folder, e)"
                             @onmouseup="e => HandleFolderSideMouseAsync(folder, e)"
                             @onmouseup:stopPropagation="true"
                             @oncontextmenu="e => View.OpenFolderMenu(folder, e)"
                             @oncontextmenu:preventDefault="true"
                             @oncontextmenu:stopPropagation="true">

                            <span class="@MailCssClasses.FolderGutter">
                                @if (node.HasChildren)
                                {
                                    <button type="button" class="@MailCssClasses.FolderChevron"
                                            title="@(node.IsExpanded ? "Collapse subfolders" : "Expand subfolders")"
                                            @onpointerdown:stopPropagation="true"
                                            @onclick="() => View.ToggleMailFolderExpanded(folder)"
                                            @onclick:stopPropagation="true">
                                        @(node.IsExpanded ? "▾" : "▸")
                                    </button>
                                }
                                @if (isMuted)
                                {
                                    <span class="@MailCssClasses.FolderMutedGutter" title="New-mail notifications muted" aria-label="New-mail notifications muted">🔕</span>
                                }
                            </span>

                            <button class="@MailCssClasses.Folder @(!MailUiState.IsViewingDeletedFolders && MailUiState.SelectedFolder?.FullName == folder.FullName ? MailCssClasses.FolderActive : "")"
                                    type="button"
                                    disabled="@(!folder.Selectable)"
                                    title="@(folder.Selectable ? (folder.FullName == folder.DisplayName || folder.IsLocal ? Mail.FolderFreshness(folder) : $"{folder.FullName} — {Mail.FolderFreshness(folder)}") : $"{folder.FullName} — This folder only holds other folders")"
                                    @onclick="() => HandleMailFolderClick(folder)">
                                <span class="@MailCssClasses.FolderIcon">@Mail.FolderIcon(folder)</span>
                                <span class="@MailCssClasses.FolderName">@Mail.FolderLabel(folder)</span>
                                @if (folder.Role == FolderRole.Trash)
                                {
                                    <span class="@MailCssClasses.FolderRetentionTag">@TrashRetentionService.BuildSidebarTrashBadge(folder)</span>
                                }
                                @if (folder.UnreadCount > 0 && GlobalSettings.ShowUnreadBadge.Value && FolderSettingsStore.ShowsUnreadCount(folder))
                                {
                                    <CoreChip Text="@folder.UnreadCount.ToString()"
                                              Background="@AppColors.Primary"
                                              TextColor="@AppColors.TextOnAccent"
                                              FontSize="@AppMeasures.Font.XSmall"
                                              PaddingX="8" PaddingY="2" />
                                }
                            </button>

                            <CustomizableActionBar SurfaceId="@UiSurfaceIds.SidebarFolderHover"
                                                   PairedMenuSurfaceId="@UiSurfaceIds.FolderContextMenu"
                                                   DefaultActions="@View.BuildSidebarFolderHoverActions(account, folder)"
                                                   AddedActionResolver="@(id => View.ResolveToolbarAddedAction(UiSurfaceIds.SidebarFolderHover, id, folderContext: folder))"
                                                   Compact="true"
                                                   StopClickPropagation="true"
                                                   CustomClass="@MailCssClasses.FolderHoverActions" />
                        </div>
                    }

                    @if (DeletedFolderStore.GetForAccount(account.Id) is { Count: > 0 } deletedMailFolders)
                    {
                        bool binActive = MailUiState.IsViewingDeletedFolders && MailUiState.DeletedFoldersAccountFilter == account.Id;
                        <div class="@MailCssClasses.FolderRow @MailCssClasses.DeletedFoldersBin"
                             data-deleted-folders-bin="@account.Id"
                             style="--folder-depth:@(depth + 1)"
                             @oncontextmenu="e => View.OpenDeletedFoldersMenu(account.Id, e)"
                             @oncontextmenu:preventDefault="true"
                             @oncontextmenu:stopPropagation="true">
                            <span class="@MailCssClasses.FolderGutter"></span>
                            <button class="@MailCssClasses.Folder @(binActive ? MailCssClasses.FolderActive : "")"
                                    type="button"
                                    title="Deleted mail folders for @account.EmailAddress — right-click for auto-delete settings"
                                    @onclick="() => MailUiState.SelectDeletedFoldersBin(account.Id)">
                                <span class="@MailCssClasses.FolderIcon">🗑️</span>
                                <span class="@MailCssClasses.FolderName">Folder Trash</span>
                                <span class="@MailCssClasses.FolderRetentionTag">@TrashRetentionService.BuildDeletedFoldersBadge(account.Id)</span>
                                <CoreChip Text="@deletedMailFolders.Count.ToString()"
                                          Background="@AppColors.SurfaceStrong"
                                          TextColor="@AppColors.TextSecondary"
                                          FontSize="@AppMeasures.Font.XSmall"
                                          PaddingX="7" PaddingY="2" />
                            </button>
                        </div>
                    }
                }
            }
        }
    };
}
