@namespace MyLovelyMail.MainProject.UI.Pages
@inherits MailPageSection
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings
@using System.IO
@using MyLovelyMail.MainProject.DataModels.Mail
@using MyLovelyMail.MainProject.Services
@using MyLovelyMail.MainProject.Services.Mail
@using MyLovelyMail.MainProject.Storage
@using MyLovelyMail.MainProject.Stores

    @* ---- Left: accounts + folders ---- *@
    <aside class="mail-sidebar">
        <div class="mail-logo">
            💌<span class="mail-logo-text">My Lovely Mail</span>
            <button class="mail-folder-action mail-account-folder-action" title="New account folder"
                    @onclick="() => ModalService.OpenCreateFolder()">📁+</button>
            <SyncHeart />
        </div>
        @if (quickMailError != null)
        {
            <p class="wizard-test wizard-test--fail" role="alert">@quickMailError</p>
        }

        @if (IsAnyDragActive)
        {
            <div class="mail-drag-escape-banner">
                <span>🎯 Drop on target — press <kbd>Esc</kbd> to cancel</span>
                <button type="button" class="mail-folder-action" title="Cancel drag (Esc)" @onclick="CancelActiveDrag">✕</button>
            </div>
        }

        @if (MailUiState.SelectedAccount != null)
        {
            <PrimaryButton IsFullWidth="true" OnClick="@(() => MouseActionService.RunAsync(MouseActionService.ComposeAction, string.Empty))" CustomClass="mail-compose-button">✏️ Compose</PrimaryButton>
        }

        @if (Mail.SavedSearchList.Count > 0)
        {
            <div class="mail-saved-searches">
                @foreach (var saved in Mail.SavedSearchList)
                {
                    <span class="mail-saved-chip" data-context-menu="true" data-mouse4="click" data-mouse4-selector=".mail-saved-remove" data-mouse5="click" data-mouse5-selector=".mail-saved-run"
                          @oncontextmenu="e => View.OpenSavedSearchMenu(saved, e)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
                        <button class="mail-saved-run" @onclick="() => View.RunSavedSearch(saved)">🔎 @saved</button>
                        <button class="mail-saved-remove" @onclick="() => Mail.RemoveSavedSearch(saved)">✕</button>
                    </span>
                }
            </div>
        }

        <nav class="mail-sidebar-nav">
            @foreach (var rootFolder in AccountFolderStore.GetRootFolders())
            {
                @RenderAccountFolderTree(rootFolder, 0)
            }
        </nav>

        @if (AccountStore.Accounts.Count == 0)
        {
            <GlassCard Level="AcrylicLevel.Normal" CustomClass="mail-welcome-card">
                <div class="mail-welcome-icon">🌸</div>
                <div class="mail-welcome-title">Welcome!</div>
                <p class="mail-welcome-text">Add your first mail account and your inbox will bloom here.</p>
                <PrimaryButton IsFullWidth="true" OnClick="@(() => ModalService.OpenAddAccount(AccountFolderStore.DefaultFolderId))">
                    ➕ Add account
                </PrimaryButton>
            </GlassCard>
        }

        @if (View.FolderActionStatus != null)
        {
            <div class="mail-sidebar-status">@View.FolderActionStatus</div>
        }
    </aside>

@code {
    readonly HashSet<string> quickMailPending = [];
    string? quickMailError;
    DotNetObjectReference<MailSidebar>? dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("myLovelyMailSidebarDrag.register", dotNetRef);
            }
            catch
            {
                // Ignore if page is tearing down.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("myLovelyMailSidebarDrag.unregister");
        }
        catch { }
        dotNetRef?.Dispose();
    }

    async Task CreateQuickMailAsync(string folderId)
    {
        if (!quickMailPending.Add(folderId)) return;
        quickMailError = null;
        try
        {
            var account = await Services.Mail.FastMail.FastMailAccountService.CreateMailTmAsync(folderId);
            MailUiState.SelectAccount(account);
            _ = Services.Mail.SyncScheduler.SyncNowAsync(accountId: account.Id);
        }
        catch (Exception ex)
        {
            quickMailError = ex.Message;
            Log($"One-click Mail.tm creation failed: {ex.GetType().Name}.", LogLevel.Error);
        }
        finally { quickMailPending.Remove(folderId); }
    }

    string? draggedAccountId;
    string? draggedFolderId;
    string? draggedMailFolderFullName;
    string? dragOverFolderId;
    string? dragOverAccountId;
    string? dragOverMailFolderFullName;
    bool dragCancelledByEscape;

    bool IsAnyDragActive => !dragCancelledByEscape && (
        draggedAccountId != null ||
        draggedFolderId != null ||
        draggedMailFolderFullName != null ||
        View.DraggedMessages.Length > 0);

    [JSInvokable]
    public void CancelActiveDragFromJs() => CancelActiveDrag();

    void CancelActiveDrag()
    {
        dragCancelledByEscape = true;
        draggedAccountId = null;
        draggedFolderId = null;
        draggedMailFolderFullName = null;
        dragOverFolderId = null;
        dragOverAccountId = null;
        dragOverMailFolderFullName = null;
        View.EndMessageDrag();
        MouseActionService.ReportStatus("Drag cancelled.");
        StateHasChanged();
    }

    void StartAccountDrag(string accountId)
    {
        dragCancelledByEscape = false;
        draggedAccountId = accountId;
        draggedFolderId = null;
        draggedMailFolderFullName = null;
    }

    void StartFolderDrag(string folderId)
    {
        dragCancelledByEscape = false;
        draggedFolderId = folderId;
        draggedAccountId = null;
        draggedMailFolderFullName = null;
    }

    void StartMailFolderDrag(string folderFullName)
    {
        dragCancelledByEscape = false;
        draggedMailFolderFullName = folderFullName;
        draggedAccountId = null;
        draggedFolderId = null;
    }

    void EndDrag()
    {
        dragCancelledByEscape = false;
        draggedAccountId = null;
        draggedFolderId = null;
        draggedMailFolderFullName = null;
        dragOverFolderId = null;
        dragOverAccountId = null;
        dragOverMailFolderFullName = null;
    }

    void DropOnFolder(AccountFolderData targetFolder)
    {
        if (dragCancelledByEscape)
        {
            EndDrag();
            return;
        }
        string? acct = draggedAccountId;
        string? fld = draggedFolderId;
        EndDrag();

        if (!string.IsNullOrWhiteSpace(acct))
        {
            AccountFolderStore.SetExpanded(targetFolder.Id, true);
            AccountStore.MoveToFolder(acct, targetFolder.Id);
            MouseActionService.ReportStatus($"Moved account into '{targetFolder.Name}'.");
        }
        else if (!string.IsNullOrWhiteSpace(fld) && !string.Equals(fld, targetFolder.Id, StringComparison.OrdinalIgnoreCase))
        {
            AccountFolderStore.SetExpanded(targetFolder.Id, true);
            AccountFolderStore.MoveFolder(fld, targetFolder.Id);
            MouseActionService.ReportStatus($"Moved folder into '{targetFolder.Name}'.");
        }
    }

    void DropOnAccount(MailAccountData targetAccount)
    {
        if (dragCancelledByEscape)
        {
            EndDrag();
            return;
        }
        string? acct = draggedAccountId;
        string? fld = draggedFolderId;
        EndDrag();

        if (!string.IsNullOrWhiteSpace(acct) && !string.Equals(acct, targetAccount.Id, StringComparison.OrdinalIgnoreCase))
        {
            AccountStore.MoveToFolder(acct, targetAccount.FolderId, insertBeforeAccountId: targetAccount.Id);
            MouseActionService.ReportStatus($"Reordered account before '{targetAccount.EmailAddress}'.");
        }
        else if (!string.IsNullOrWhiteSpace(fld))
        {
            AccountFolderStore.MoveFolder(fld, targetAccount.FolderId);
        }
    }

    async Task DropOnMailFolderAsync(MailFolderData targetMailFolder)
    {
        if (dragCancelledByEscape)
        {
            EndDrag();
            View.EndMessageDrag();
            return;
        }
        string? srcMailFolder = draggedMailFolderFullName;
        var draggedMsgs = View.DraggedMessages;
        EndDrag();
        View.EndMessageDrag();

        if (draggedMsgs.Length > 0 && targetMailFolder.Selectable)
        {
            await MouseActionService.RunMessagesAsync(MailMessageCommand.Move, draggedMsgs, targetMailFolder.FullName, includeSelection: false);
            return;
        }

        if (!string.IsNullOrWhiteSpace(srcMailFolder)
            && !string.Equals(srcMailFolder, targetMailFolder.FullName, StringComparison.OrdinalIgnoreCase))
        {
            MessageStore.ReorderFolder(targetMailFolder.AccountId, srcMailFolder, targetMailFolder.FullName);
            View.RefreshSidebarFolders();
            MouseActionService.ReportStatus($"Reordered '{targetMailFolder.DisplayName}'.");
        }
    }

    int OrdinalOfAccount(MailAccountData account)
    {
        for (int i = 0; i < AccountStore.Accounts.Count; i++)
        {
            if (AccountStore.Accounts[i].Id == account.Id)
                return i;
        }
        return 99;
    }

    RenderFragment RenderAccountFolderTree(AccountFolderData accFolder, int depth) => __builder =>
    {
        var childFolders = AccountFolderStore.GetChildFolders(accFolder.Id);
        var folderAccounts = AccountStore.GetAccountsInFolder(accFolder.Id);
        bool isDropTarget = dragOverFolderId == accFolder.Id;

        <div class="mail-account-folder-row @(isDropTarget ? "mail-drop-target" : "")"
             style="--acc-folder-depth:@depth"
             draggable="true"
             @ondragstart="() => StartFolderDrag(accFolder.Id)"
             @ondragstart:stopPropagation="true"
             @ondragend="EndDrag"
             @ondragover="() => dragOverFolderId = accFolder.Id"
             @ondragover:preventDefault="true"
             @ondrop="() => DropOnFolder(accFolder)"
             @ondrop:stopPropagation="true"
             data-context-menu="true"
             @oncontextmenu="e => View.OpenAccountFolderMenu(accFolder, e)"
             @oncontextmenu:preventDefault="true"
             @oncontextmenu:stopPropagation="true">

            <button class="mail-account-folder-toggle"
                    title="@(accFolder.IsExpanded ? "Collapse folder" : "Expand folder")"
                    @onclick="() => AccountFolderStore.ToggleExpanded(accFolder.Id)">
                <span class="mail-account-folder-chevron">@(accFolder.IsExpanded ? "▾" : "▸")</span>
                <span class="mail-account-folder-icon">@(accFolder.IsExpanded ? "📂" : "📁")</span>
                <span class="mail-account-folder-name">@accFolder.Name</span>
            </button>

            <span class="mail-folder-hover-actions">
                <button class="mail-folder-action mail-account-folder-action"
                        title="Add account to @accFolder.Name"
                        @onclick="() => ModalService.OpenAddAccount(accFolder.Id)">➕</button>

                <button class="mail-folder-action mail-account-folder-action" type="button"
                        title="@(quickMailError ?? "Create a Mail.tm account here")" aria-label="Create a Mail.tm account here"
                        disabled="@quickMailPending.Contains(accFolder.Id)" @onclick="() => CreateQuickMailAsync(accFolder.Id)">
                    @if (quickMailPending.Contains(accFolder.Id)) { <CoreSpinner SizePx="16" BorderWidthPx="2" Color="@AppColors.TextPrimary" /> }
                    else { <FastMailAddIcon /> }
                </button>

                <button class="mail-folder-action mail-account-folder-action"
                        title="Folder options"
                        @onclick="e => View.OpenAccountFolderMenu(accFolder, e)">⋯</button>
            </span>
        </div>

        @if (accFolder.IsExpanded)
        {
            @foreach (var sub in childFolders)
            {
                @RenderAccountFolderTree(sub, depth + 1)
            }

            @foreach (var account in folderAccounts)
            {
                int accountIndex = OrdinalOfAccount(account);
                bool isAccountDropTarget = dragOverAccountId == account.Id;

                <button class="mail-account @(MailUiState.SelectedAccount?.Id == account.Id ? "mail-account--active" : "") @(account.Enabled ? "" : "mail-account--paused") @(isAccountDropTarget ? "mail-drop-target" : "")"
                        style="padding-left: calc(12px + @(depth + 1) * 12px);"
                        title="@Mail.SyncHealthTooltip(account)"
                        draggable="true"
                        @ondragstart="() => StartAccountDrag(account.Id)"
                        @ondragstart:stopPropagation="true"
                        @ondragend="EndDrag"
                        @ondragover="() => dragOverAccountId = account.Id"
                        @ondragover:preventDefault="true"
                        @ondrop="() => DropOnAccount(account)"
                        @ondrop:stopPropagation="true"
                        data-context-menu="true" @oncontextmenu="e => View.OpenAccountMenu(account, e)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"
                        data-mouse4="menu" data-mouse5="@MouseActionService.AccountSyncAction" data-mouse5-value="@account.Id"
                        @onclick="() => MailUiState.SelectAccount(account, restoreFolder: true)">
                    <span class="mail-account-dot" style="background:@account.ColorHex"></span>
                    @if (account.Protocol == IncomingProtocol.FastMail)
                    {
                        <span class="mail-account-paused" title="Fast Mail (Tor-only)">⚡</span>
                    }
                    @if (!account.Enabled)
                    {
                        <span class="mail-account-paused" title="Paused — not syncing">⏸️</span>
                    }
                    @if (SyncHealthService.For(account.Id).IsFailing)
                    {
                        <span class="mail-account-failing" title="@Mail.SyncHealthTooltip(account)">⚠️</span>
                    }
                    @if (accountIndex < 9)
                    {
                        <span class="mail-account-ordinal">@(accountIndex + 1)</span>
                    }
                    <span class="mail-account-name">@(string.IsNullOrWhiteSpace(account.DisplayName) ? (string.IsNullOrWhiteSpace(account.Title) ? account.EmailAddress : $"{account.Title} ({account.EmailAddress})") : account.DisplayName)</span>
                    @if (GlobalSettings.ShowUnreadBadge.Value && Mail.AccountUnreadCount(account.Id) is > 0 and var accountUnread)
                    {
                        <span class="mail-account-unread" style="background:@account.ColorHex;color:@AppColors.InkOn(account.ColorHex).ToRgbaHex(true)">@accountUnread</span>
                    }
                </button>

                @if (MailUiState.SelectedAccount?.Id == account.Id)
                {
                    @foreach (var node in View.Folders)
                    {
                        var folder = node.Folder;
                        bool isMailFolderDrop = dragOverMailFolderFullName == folder.FullName;
                        bool isMuted = FolderSettingsStore.IsMuted(folder);
                        <div class="mail-folder-row @(isMailFolderDrop ? "mail-drop-target" : "")"
                             style="--folder-depth:@(node.Depth + depth + 1)"
                             draggable="true"
                             @ondragstart="() => StartMailFolderDrag(folder.FullName)"
                             @ondragstart:stopPropagation="true"
                             @ondragend="EndDrag"
                             @ondragover="() => dragOverMailFolderFullName = folder.FullName"
                             @ondragover:preventDefault="true"
                             @ondrop="() => DropOnMailFolderAsync(folder)"
                             @ondrop:stopPropagation="true"
                             data-context-menu="true"
                             data-mouse4="menu" data-mouse5="@MouseActionService.FolderReadAction"
                             data-mouse5-value="@JsonSerializer.Serialize(new MailMessageIdentity(folder.AccountId, folder.FullName, 0))"
                             @oncontextmenu="e => View.OpenFolderMenu(folder, e)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">

                            <span class="mail-folder-gutter">
                                @if (node.HasChildren)
                                {
                                    <button type="button" class="mail-folder-chevron"
                                            title="@(node.IsExpanded ? "Collapse subfolders" : "Expand subfolders")"
                                            @onclick="() => View.ToggleMailFolderExpanded(folder)"
                                            @onclick:stopPropagation="true">
                                        @(node.IsExpanded ? "▾" : "▸")
                                    </button>
                                }
                                @if (isMuted)
                                {
                                    <span class="mail-folder-muted-gutter" title="New-mail notifications muted" aria-label="New-mail notifications muted">🔕</span>
                                }
                            </span>

                            <button class="mail-folder @(MailUiState.SelectedFolder?.FullName == folder.FullName ? "mail-folder--active" : "")"
                                    data-mouse5="@MouseActionService.FolderReadAction"
                                    data-mouse5-value="@JsonSerializer.Serialize(new MailMessageIdentity(folder.AccountId, folder.FullName, 0))"
                                    disabled="@(!folder.Selectable)"
                                    title="@(folder.Selectable ? Mail.FolderFreshness(folder) : "This folder only holds other folders")"
                                    @onclick="() => MailUiState.SelectFolder(folder)">
                                <span class="mail-folder-icon">@Mail.FolderIcon(folder)</span>
                                <span class="mail-folder-name">@Mail.FolderLabel(folder)</span>
                                @if (folder.UnreadCount > 0 && GlobalSettings.ShowUnreadBadge.Value && FolderSettingsStore.ShowsUnreadCount(folder))
                                {
                                    <CoreChip Text="@folder.UnreadCount.ToString()"
                                              Background="@AppColors.Primary"
                                              TextColor="@AppColors.TextOnAccent"
                                              FontSize="@AppMeasures.Font.XSmall"
                                              PaddingX="8" PaddingY="2" />
                                }
                            </button>

                            <span class="mail-folder-hover-actions">
                                @if (folder.UnreadCount > 0 && folder.Role != FolderRole.Trash)
                                {
                                    <button class="mail-folder-action" title="Mark all @folder.UnreadCount as read"
                                            @onclick="() => MouseActionService.ReadFolderAsync(folder)">✓✓</button>
                                }
                                <button class="mail-folder-action" title="Export this folder as one .mbox file"
                                        @onclick="() => View.ExportFolderMailbox(folder)">📦</button>
                                @if (!folder.IsLocal && account.Protocol != IncomingProtocol.FastMail)
                                {
                                    <button class="mail-folder-action" title="Redownload this folder (newest 300 messages)"
                                            @onclick="() => View.ResyncFolder(folder)">🔄</button>
                                }
                                <button class="mail-folder-action mail-folder-menu-trigger" title="Folder actions" aria-label="Folder actions" aria-haspopup="menu"
                                        @onclick="e => View.OpenFolderMenu(folder, e)">⋯</button>
                            </span>
                        </div>
                    }
                }
            }
        }
    };
}
