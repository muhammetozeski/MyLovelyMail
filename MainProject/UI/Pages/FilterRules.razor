@attribute [Route(RoutePath)]
@inherits MyLovelyMail.MainProject.UI.Layout.Architecture.PageBase
@inject NavigationManager Navigation
<PageTitle>Filters — My Lovely Mail</PageTitle>

<div class="filters-screen" @oninput="ClearPreview" @onchange="ClearPreview">
    <div class="filters-header">
        <BackButton OnClick="@(() => Navigation.NavigateTo(NavigationConstants.Settings.Link))" />
        <h1 class="filters-title">🧹 Mail filters</h1>
        <PrimaryButton OnClick="@StartNewRule">➕ New rule</PrimaryButton>
    </div>

    @if (EditingRule is { } rule)
    {
        <GlassCard CustomClass="filters-card">
            <div class="filters-section-title">@(IsNewRule ? "New rule" : $"Edit: {rule.Name}")</div>

            <div class="filters-field">
                <span class="filters-label">Rule name</span>
                <CoreInput Placeholder="e.g. Newsletters to archive" @bind-Value="rule.Name" />
            </div>

            <div class="filters-grid">
                <div class="filters-field">
                    <span class="filters-label">Scope</span>
                    <select class="filters-select" @bind="EditingScope">
                        @foreach (string scope in ScopeNames)
                        {
                            <option value="@scope">@scope</option>
                        }
                    </select>
                </div>
                @if (EditingScope is "Account" or "Mailbox folder" or "Sender")
                {
                    <div class="filters-field">
                        <span class="filters-label">Account</span>
                        <select class="filters-select" @bind="rule.AccountId">
                            <option value="">@(EditingScope == "Sender" ? "All accounts" : "Choose account")</option>
                            @foreach (var account in AccountStore.Accounts)
                            {
                                <option value="@account.Id">@account.EmailAddress</option>
                            }
                        </select>
                    </div>
                }
                @if (EditingScope == "Account folder")
                {
                    <div class="filters-field">
                        <span class="filters-label">Account folder and descendants</span>
                        <select class="filters-select" @bind="rule.AccountFolderId">
                            <option value="">Choose account folder</option>
                            @foreach (var (container, depth) in AccountFolderStore.GetFlattenedTree())
                            {
                                <option value="@container.Id">@(new string('—', depth)) @container.Name</option>
                            }
                        </select>
                    </div>
                }
                @if (EditingScope == "Mailbox folder")
                {
                    <div class="filters-field">
                        <span class="filters-label">Source mailbox folder</span>
                        <select class="filters-select" @bind="rule.FolderFullName">
                            <option value="">Choose mailbox folder</option>
                            @foreach (var folder in MessageStore.GetFolders(rule.AccountId).Where(f => f.Selectable))
                            {
                                <option value="@folder.FullName">@folder.DisplayName (@folder.FullName)</option>
                            }
                        </select>
                    </div>
                }
                @if (EditingScope == "Sender")
                {
                    <div class="filters-field">
                        <span class="filters-label">Exact sender address</span>
                        <input class="filters-input" placeholder="sender@example.com" @bind="rule.SenderAddress" />
                    </div>
                }
                <div class="filters-field">
                    <span class="filters-label">Conditions must match</span>
                    <select class="filters-select" @bind="rule.MatchMode">
                        <option value="@FilterMatchMode.All">ALL (and)</option>
                        <option value="@FilterMatchMode.Any">ANY (or)</option>
                    </select>
                </div>
                <div class="filters-field filters-field--toggle">
                    <span class="filters-label">Stop after this match</span>
                    <CoreToggle Checked="@rule.StopProcessing" CheckedChanged="@(v => rule.StopProcessing = v)" />
                </div>
            </div>

            <p class="filters-rule-summary">Priority: sender → account → mailbox folder → account folder (nearest first) → application. Within a priority, the first matching action wins. Stop also skips all lower priorities.</p>
            <div class="filters-section-title">Conditions</div>
            <p class="filters-rule-summary">Scoped rules may have no conditions to match everything in their scope.</p>
            @foreach (var condition in rule.Conditions)
            {
                <div class="filters-rowline">
                    <select class="filters-select" @bind="condition.Field" @bind:after="() => NormalizeCondition(condition)">
                        @foreach (var field in Enum.GetValues<FilterField>())
                        {
                            <option value="@field">@FieldLabel(field)</option>
                        }
                    </select>
                    <select class="filters-select" @bind="condition.Operator">
                        @foreach (var op in OperatorsFor(condition.Field))
                        {
                            <option value="@op">@OperatorLabel(op)</option>
                        }
                    </select>
                    @if (condition.Field == FilterField.HasAttachment)
                    {
                        <select class="filters-select" @bind="condition.Value"><option value="true">Has attachment</option><option value="false">No attachment</option></select>
                    }
                    else
                    {
                        <input class="filters-input" placeholder="@(condition.Field == FilterField.SizeKb ? "Size in KB" : "Value")" @bind="condition.Value" />
                    }
                    <button class="filters-remove" @onclick="() => rule.Conditions.Remove(condition)">✕</button>
                </div>
            }
            <button class="filters-add" @onclick="() => rule.Conditions.Add(new FilterCondition())">➕ Add condition</button>

            <div class="filters-section-title">Actions</div>
            @foreach (var action in rule.Actions)
            {
                @* A move target used to be free text. The user typed a folder name that was close
                   but not the server's path, and the rule then failed on every single sync while
                   still looking perfectly configured. The list is the account's real folders. *@
                var choices = FolderChoicesFor(rule, action.Type);
                bool missingTarget = choices.Count > 0 && action.Argument.Length > 0 && !choices.Contains(action.Argument);
                <div class="filters-rowline">
                    <select class="filters-select" @bind="action.Type">
                        @foreach (var type in Enum.GetValues<FilterActionType>())
                        {
                            <option value="@type">@ActionLabel(type)</option>
                        }
                    </select>
                    @if (IsMove(action.Type))
                    {
                        <select class="filters-select" @bind="action.Argument">
                            <option value="">@ArgumentPlaceholder(action.Type)</option>
                            @foreach (string choice in choices)
                            {
                                <option value="@choice">@choice</option>
                            }
                            @if (missingTarget)
                            {
                                <option value="@action.Argument">@action.Argument</option>
                            }
                        </select>
                        @if (missingTarget)
                        {
                            <span class="filters-preview-warning" title="Every message this rule matches fails to move until the target exists">
                                ⚠️ no folder named “@action.Argument”
                            </span>
                        }
                    }
                    else
                    {
                        <input class="filters-input" placeholder="@ArgumentPlaceholder(action.Type)" @bind="action.Argument" />
                    }
                    <button class="filters-remove" @onclick="() => rule.Actions.Remove(action)">✕</button>
                </div>
            }
            <button class="filters-add" @onclick="() => rule.Actions.Add(new FilterAction())">➕ Add action</button>

            @* A rule that matches nothing and one that matches everything look identical until
               real mail arrives — and by then a move action has already run on the server. *@
            @if (Preview is { } preview)
            {
                <div class="filters-preview">
                    <div class="filters-preview-headline">
                        Matches @preview.Matched.ToString("N0") of @preview.Scanned.ToString("N0") cached messages
                    </div>
                    @if (preview.ScanLimitReached) { <p class="filters-preview-warning">Preview limit reached; additional cached messages were not scanned.</p> }
                    @foreach (var condition in preview.PerCondition)
                    {
                        <div class="filters-preview-condition @(condition.Hits == 0 ? "filters-preview-condition--dead" : "")">
                            @condition.Index. @condition.Description — @condition.Hits.ToString("N0") hits
                            @if (condition.OperatorIgnored)
                            {
                                <span class="filters-preview-warning">the engine ignores this operator for this field</span>
                            }
                        </div>
                    }
                    @foreach (string subject in preview.SampleSubjects)
                    {
                        <div class="filters-preview-sample">· @(string.IsNullOrWhiteSpace(subject) ? "(no subject)" : subject)</div>
                    }
                </div>
            }

            @foreach (string error in EditorErrors) { <p class="filters-preview-warning">@error</p> }
            @if (SaveError != null) { <p class="filters-preview-warning" role="alert">@SaveError</p> }
            <div class="filters-actions">
                <SecondaryButton OnClick="@(() => ClearEditor())">Cancel</SecondaryButton>
                <SecondaryButton OnClick="@(() => Preview = RuleEngine.Preview(rule))" Disabled="@(EditorErrors.Count > 0)">🔎 Try it</SecondaryButton>
                <PrimaryButton OnClick="@SaveRule" Disabled="@(EditorErrors.Count > 0)">💾 Save rule</PrimaryButton>
            </div>
        </GlassCard>
    }

    @if (FilterRuleStore.Rules.Count == 0 && EditingRule == null)
    {
        <div class="mail-empty">
            <div class="mail-empty-icon">🧹</div>
            <div class="mail-empty-text">No filters yet — create one and incoming mail will sort itself.</div>
        </div>
    }

    <div class="filters-grid">
        <input class="filters-input" aria-label="Find filters" placeholder="Find by name, scope or action" @bind="SearchText" @bind:event="oninput" />
        <label><input type="checkbox" @bind="EnabledOnly" /> Enabled only</label>
        @if (HasQueryScope) { <SecondaryButton OnClick="() => Navigation.NavigateTo(RoutePath)">Show all filters</SecondaryButton> }
    </div>
    <p class="filters-rule-summary">@ScopeCaption · @VisibleRules.Count() filter(s)</p>
    @foreach (var existingRule in VisibleRules)
    {
        <div class="filters-rule-surface" data-context-menu="true" data-mouse4="menu" data-mouse5="click" data-mouse5-selector=".core-toggle"
             @oncontextmenu="e => OpenRuleMenu(existingRule, e)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
        <GlassCard CustomClass="filters-card filters-card--row">
            <div class="filters-rule-main">
                <span class="filters-rule-name">@existingRule.Name</span>
                <span class="filters-rule-summary">@Summarize(existingRule)</span>
            </div>
            <div class="filters-rule-tools">
                <CoreToggle Checked="@existingRule.Enabled" CheckedChanged="@(v => SetEnabled(existingRule, v))" />
                <button class="filters-remove" title="Move up within priority" disabled="@(!FilterRuleStore.CanMoveRule(existingRule, true))" @onclick="() => RunRuleCommand(existingRule, RuleCommand.Up)">↑</button>
                <button class="filters-remove" title="Move down within priority" disabled="@(!FilterRuleStore.CanMoveRule(existingRule, false))" @onclick="() => RunRuleCommand(existingRule, RuleCommand.Down)">↓</button>
                <button class="filters-remove" title="Edit" @onclick="() => RunRuleCommand(existingRule, RuleCommand.Edit)">✏️</button>
                <button class="filters-remove" title="Filter actions" aria-label="Filter actions" @onclick="e => OpenRuleMenu(existingRule, e)">⋯</button>
                <button class="filters-remove" title="Delete" @onclick="() => RunRuleCommand(existingRule, RuleCommand.Delete)">🗑️</button>
            </div>
        </GlassCard>
        </div>
    }
</div>

<FilterRulesCss />
<MailCss />

@code {
    public const string RoutePath = "/Settings/Filters";

    FilterRule? EditingRule { get; set; }
    bool IsNewRule { get; set; }

    /// <summary>Result of the last "Try it"; cleared whenever a different rule is opened.</summary>
    RuleEngine.RulePreview? Preview { get; set; }

    /// <summary>Closes the editor and drops the preview with it, so it cannot outlive the rule it described.</summary>
    void ClearEditor() => (EditingRule, Preview) = (null, null);

    void StartNewRule()
    {
        Preview = null;
        RequestedScope = null;
        SaveError = null;
        EditingRule = new FilterRule { AccountId = QueryAccount ?? "", FolderFullName = QueryFolder ?? "", AccountFolderId = QueryAccountFolder ?? "", SenderAddress = QuerySender ?? "", Conditions = HasQueryScope ? [] : [new FilterCondition()], Actions = [new FilterAction()] };
        IsNewRule = true;
    }

    void StartEdit(FilterRule rule)
    {
        RequestedScope = null;
        SaveError = null;
        // Edit a clone so Cancel never leaves half-typed changes in the store.
        EditingRule = System.Text.Json.JsonSerializer.Deserialize<FilterRule>(System.Text.Json.JsonSerializer.Serialize(rule));
        IsNewRule = false;
        if (EditingRule != null) foreach (var condition in EditingRule.Conditions) NormalizeCondition(condition);
        Preview = null;
    }

    void SaveRule()
    {
        if (EditingRule == null) return;
        if (EditorErrors.Count > 0) return;
        try { FilterRuleStore.Save(EditingRule); ClearEditor(); SaveError = null; }
        catch (Exception ex) { SaveError = ex.Message; Log($"Could not save filter: {ex}", LogLevel.Error); }
    }

    static Task<string> SetEnabled(FilterRule rule, bool enabled) => MouseActionService.RunAsync("Change filter", () => {
        var updated = FilterRuleStore.Clone(rule);
        updated.Enabled = enabled;
        FilterRuleStore.Save(updated);
        return Task.FromResult(enabled ? "Filter enabled." : "Filter disabled.");
    });

    /// <summary>Commands consumed by the same rule-row buttons and context menu.</summary>
    enum RuleCommand { Edit, Duplicate, Preview, Toggle, Up, Down, Delete }

    /// <summary>Captures a rule and routes operations to its existing editor and store.</summary>
    /// <param name="rule">Clicked rule.</param>
    /// <param name="pointer">Menu position.</param>
    void OpenRuleMenu(FilterRule rule, MouseEventArgs pointer) => ContextMenuService.Open(this, rule.Name, [
        new("✏️ Edit filter", () => RunRuleCommand(rule, RuleCommand.Edit)),
        new("🔎 Preview against cached mail", () => RunRuleCommand(rule, RuleCommand.Preview)),
        new("⧉ Copy rule definition", () => MouseActionService.RunAsync(MouseActionService.CopyAction, System.Text.Json.JsonSerializer.Serialize(rule, JsonDefaults.Indented))),
        new("⧉ Duplicate into editor", () => RunRuleCommand(rule, RuleCommand.Duplicate)),
        new(rule.Enabled ? "⏸ Disable filter" : "▶ Enable filter", () => RunRuleCommand(rule, RuleCommand.Toggle)),
        new("↑ Move up within priority", () => RunRuleCommand(rule, RuleCommand.Up), FilterRuleStore.CanMoveRule(rule, true)),
        new("↓ Move down within priority", () => RunRuleCommand(rule, RuleCommand.Down), FilterRuleStore.CanMoveRule(rule, false)),
        new("⧉ Copy name", () => MouseActionService.RunAsync(MouseActionService.CopyAction, rule.Name)),
        new("🗑️ Delete filter", () => RunRuleCommand(rule, RuleCommand.Delete))
    ], pointer.ClientX, pointer.ClientY);

    /// <summary>Shares persistence, error logging and UI results for every rule input path.</summary>
    /// <param name="rule">Captured rule.</param>
    /// <param name="command">Editor/store command.</param>
    /// <returns>Awaitable operation.</returns>
    Task RunRuleCommand(FilterRule rule, RuleCommand command)
    {
        if (command == RuleCommand.Toggle) return SetEnabled(rule, !rule.Enabled);
        return MouseActionService.RunAsync($"Filter {command}", () => {
            switch (command)
            {
                case RuleCommand.Edit: StartEdit(rule); break;
                case RuleCommand.Preview: StartEdit(rule); Preview = RuleEngine.Preview(rule); break;
                case RuleCommand.Duplicate:
                    StartEdit(rule);
                    if (EditingRule is { } copy) { copy.Id = Guid.NewGuid().ToString("N"); copy.Name += " (copy)"; IsNewRule = true; }
                    break;
                case RuleCommand.Up: FilterRuleStore.MoveRule(rule.Id, true); break;
                case RuleCommand.Down: FilterRuleStore.MoveRule(rule.Id, false); break;
                case RuleCommand.Delete:
                    FilterRuleStore.Remove(rule.Id);
                    if (EditingRule?.Id == rule.Id) ClearEditor();
                    break;
            }
            return Task.FromResult($"Filter {command} completed.");
        });
    }

    static string ArgumentPlaceholder(FilterActionType type) => type switch
    {
        FilterActionType.MoveToRemoteFolder => "— pick a server folder —",
        FilterActionType.MoveToLocalFolder => "— pick a folder on this PC —",
        FilterActionType.SetNotificationSound => "Sound name or 'none'",
        FilterActionType.AddTag or FilterActionType.RemoveTag => "Tag name",
        _ => "(no argument needed)"
    };

    static bool IsMove(FilterActionType type) =>
        type is FilterActionType.MoveToRemoteFolder or FilterActionType.MoveToLocalFolder;

    static string FieldLabel(FilterField field) => field switch
    {
        FilterField.From => "Sender name or address", FilterField.FromAddress => "Exact sender address",
        FilterField.To => "Recipients", FilterField.Subject => "Subject", FilterField.BodyPreview => "Preview text",
        FilterField.SenderDomain => "Sender domain", FilterField.SizeKb => "Size in kilobytes",
        FilterField.HasAttachment => "Attachment", _ => field.ToString()
    };

    static string OperatorLabel(FilterOperator op) => op switch
    {
        FilterOperator.NotContains => "Does not contain", FilterOperator.StartsWith => "Starts with",
        FilterOperator.EndsWith => "Ends with", FilterOperator.MatchesRegex => "Matches regular expression",
        FilterOperator.GreaterThan => "Greater than", FilterOperator.LessThan => "Less than", _ => op.ToString()
    };

    static string ActionLabel(FilterActionType action) => action switch
    {
        FilterActionType.MoveToRemoteFolder => "Move to server folder", FilterActionType.MoveToLocalFolder => "Move to local folder",
        FilterActionType.MarkRead => "Mark read", FilterActionType.MarkUnread => "Keep unread",
        FilterActionType.MarkImportant => "Mark important", FilterActionType.ClearImportant => "Clear importance",
        FilterActionType.Flag => "Star", FilterActionType.Unflag => "Remove star",
        FilterActionType.Mute => "Mute notifications", FilterActionType.Unmute => "Allow notifications",
        FilterActionType.AddTag => "Add tag", FilterActionType.RemoveTag => "Remove tag",
        FilterActionType.SetNotificationSound => "Notification sound", _ => action.ToString()
    };

    /// <summary>
    /// The folders this action may name. For a rule bound to one account: that account's folders.
    /// For a rule that applies to every account: only the paths ALL of them have, because a path
    /// that exists on one server and not another is a move that fails silently everywhere else.
    /// </summary>
    static List<string> FolderChoicesFor(FilterRule rule, FilterActionType type)
    {
        if (!IsMove(type)) return [];

        var accounts = rule.AccountId.Length > 0
            ? AccountStore.Accounts.Where(a => a.Id == rule.AccountId).ToList()
            : [.. AccountStore.Accounts.Where(a => RuleEngine.AppliesToScope(rule, a, rule.FolderFullName))];
        if (accounts.Count == 0) return [];

        bool wantsLocal = type == FilterActionType.MoveToLocalFolder;
        if (!wantsLocal && accounts.Any(a => a.Protocol != IncomingProtocol.Imap)) return [];
        List<HashSet<string>> perAccount = [.. accounts.Select(account =>
            MessageStore.GetFolders(account.Id)
                .Where(f => IsLocalFolder(f) == wantsLocal && f.Selectable)
                .Select(f => wantsLocal ? f.FullName[MessageStore.LocalFolderPrefix.Length..] : f.FullName)
                .ToHashSet(StringComparer.Ordinal))];

        var shared = perAccount[0];
        foreach (var other in perAccount.Skip(1)) shared.IntersectWith(other);
        return [.. shared.OrderBy(static name => name, StringComparer.OrdinalIgnoreCase)];
    }

    static bool IsLocalFolder(MailFolderData folder) =>
        folder.IsLocal || folder.FullName.StartsWith(MessageStore.LocalFolderPrefix, StringComparison.Ordinal);

    [SupplyParameterFromQuery(Name = "account")] public string? QueryAccount { get; set; }
    [SupplyParameterFromQuery(Name = "folder")] public string? QueryFolder { get; set; }
    [SupplyParameterFromQuery(Name = "accountFolder")] public string? QueryAccountFolder { get; set; }
    [SupplyParameterFromQuery(Name = "sender")] public string? QuerySender { get; set; }
    string SearchText = "";
    bool EnabledOnly;
    string? SaveError;
    string? LastQuery;
    static readonly string[] ScopeNames = ["Application", "Account folder", "Mailbox folder", "Account", "Sender"];
    bool HasQueryScope => !string.IsNullOrEmpty(QueryAccount) || !string.IsNullOrEmpty(QueryFolder) || !string.IsNullOrEmpty(QueryAccountFolder) || !string.IsNullOrEmpty(QuerySender);
    string ScopeCaption => QuerySender is { Length: > 0 } ? $"Sender: {QuerySender}"
        : QueryFolder is { Length: > 0 } ? $"Mailbox: {QueryFolder}"
        : QueryAccountFolder is { Length: > 0 } ? $"Account folder: {AccountFolderStore.Folders.FirstOrDefault(f => f.Id == QueryAccountFolder)?.Name ?? "Missing folder"}"
        : QueryAccount is { Length: > 0 } ? $"Account: {AccountStore.GetById(QueryAccount)?.EmailAddress}" : "All scopes";

    IEnumerable<FilterRule> VisibleRules => FilterRuleStore.Rules
        .Where(r => (!EnabledOnly || r.Enabled)
            && (string.IsNullOrEmpty(QueryAccount) || r.AccountId == QueryAccount)
            && (string.IsNullOrEmpty(QueryFolder) || r.FolderFullName == QueryFolder)
            && (string.IsNullOrEmpty(QueryAccountFolder) || r.AccountFolderId == QueryAccountFolder)
            && (string.IsNullOrEmpty(QuerySender) || r.SenderAddress.Equals(QuerySender, StringComparison.OrdinalIgnoreCase))
            && (SearchText.Length == 0 || ($"{r.Name} {Summarize(r)}").Contains(SearchText, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(RuleEngine.Priority);

    IReadOnlyList<string> EditorErrors
    {
        get
        {
            if (EditingRule == null) return [];
            var errors = FilterRuleStore.Validate(EditingRule).ToList();
            if (EditingScope == "Account" && EditingRule.AccountId.Length == 0) errors.Add("Choose an account.");
            if (EditingScope == "Account folder" && EditingRule.AccountFolderId.Length == 0) errors.Add("Choose an account folder.");
            if (EditingScope == "Mailbox folder" && EditingRule.FolderFullName.Length == 0) errors.Add("Choose a mailbox folder.");
            if (EditingScope == "Sender" && EditingRule.SenderAddress.Length == 0) errors.Add("Enter a sender address.");
            return errors;
        }
    }

    string? RequestedScope;
    string EditingScope
    {
        get => RequestedScope ?? (EditingRule is { } r ? ScopeName(r) : "Application");
        set
        {
            RequestedScope = value;
            if (EditingRule is not { } r) return;
            r.SenderAddress = ""; r.FolderFullName = ""; r.AccountFolderId = "";
            if (value is "Application" or "Account folder") r.AccountId = "";
            Preview = null;
        }
    }

    protected override void OnParametersSet()
    {
        string query = $"{QueryAccount}|{QueryFolder}|{QueryAccountFolder}|{QuerySender}";
        if (LastQuery == query) return;
        LastQuery = query;
        ClearEditor();
        RequestedScope = null;
    }

    void ClearPreview() => Preview = null;
    static string ScopeName(FilterRule r) => r.SenderAddress.Length > 0 ? "Sender" : r.FolderFullName.Length > 0 ? "Mailbox folder"
        : r.AccountFolderId.Length > 0 ? "Account folder" : r.AccountId.Length > 0 ? "Account" : "Application";

    static IEnumerable<FilterOperator> OperatorsFor(FilterField field) => field switch
    {
        FilterField.HasAttachment => [FilterOperator.Equals],
        FilterField.SizeKb => [FilterOperator.Equals, FilterOperator.GreaterThan, FilterOperator.LessThan],
        _ => Enum.GetValues<FilterOperator>().Where(o => o is not (FilterOperator.GreaterThan or FilterOperator.LessThan))
    };

    static void NormalizeCondition(FilterCondition condition)
    {
        if (!OperatorsFor(condition.Field).Contains(condition.Operator)) condition.Operator = OperatorsFor(condition.Field).First();
        if (condition.Field == FilterField.HasAttachment && !bool.TryParse(condition.Value, out _)) condition.Value = "true";
    }

    static string Summarize(FilterRule rule) =>
        $"{ScopeName(rule)} · {rule.SenderAddress}{(rule.SenderAddress.Length > 0 ? " · " : "")}" +
        (rule.AccountId.Length > 0 ? $"{AccountStore.GetById(rule.AccountId)?.EmailAddress ?? "Missing account"} · " : "") +
        (rule.FolderFullName.Length > 0 ? $"{rule.FolderFullName} · " : "") +
        (rule.AccountFolderId.Length > 0 ? $"{AccountFolderStore.Folders.FirstOrDefault(f => f.Id == rule.AccountFolderId)?.Name ?? "Missing folder"} and descendants · " : "") +
        $"{rule.Conditions.Count} condition(s) → {string.Join(", ", rule.Actions.Select(a => ActionLabel(a.Type)))}";

    public static string LinkFor(string? accountId = null, string? folderFullName = null, string? accountFolderId = null, string? senderAddress = null)
    {
        List<string> values = [];
        void Add(string key, string? value) { if (!string.IsNullOrEmpty(value)) values.Add($"{key}={Uri.EscapeDataString(value)}"); }
        Add("account", accountId); Add("folder", folderFullName); Add("accountFolder", accountFolderId); Add("sender", senderAddress);
        return RoutePath + (values.Count == 0 ? "" : "?" + string.Join("&", values));
    }
}
