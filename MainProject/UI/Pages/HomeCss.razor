@namespace MyLovelyMail.MainProject.UI.Pages
<style>
    .home-screen {
        min-height: @(AppMeasures.Viewport.Full)vh;
        position: relative;
    }

    .home-scroll-container {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Medium.ToString() + "px");
        padding-bottom: @(AppMeasures.Space.Px120)px;
    }

    .home-pro-banner {
        margin: 0 @(AppMeasures.Space.Px20)px;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px16)px;
    }

    .home-pro-banner-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px12)px;
    }

    .home-pro-banner-text {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px4)px;
    }

    .home-pro-banner-title {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        color: @AppColors.TextOnFilledSurface;
    }

    .home-pro-banner-subtitle {
        margin: 0;
        font-size: @(AppMeasures.Font.Small)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @AppColors.TextOnFilledSurface;
    }

    .reading-reward-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: @(AppMeasures.Space.Px12)px;
        margin-bottom: @(AppMeasures.Space.Px24)px;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Heavy);
    }

    .reading-reward-xp {
        color: @AppColors.TextPrimary;
    }

    /* Keeps the "+" prefix and the inline CurrencyAmount on one baseline, matching the XP span's layout. The gold tint itself is owned by CurrencyAmount. */
    .reading-reward-gold {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
    }

</style>
