@attribute [Route("/")]
@attribute [Route(NavigationConstants.Mail.Link)]
@inherits MyLovelyMail.MainProject.UI.Layout.Architecture.PageBase
@implements IDisposable
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
<PageTitle>My Lovely Mail</PageTitle>

<div class="mail-screen @(MailUiState.OpenMessage != null ? "mail-screen--reading" : "")"
     style="--account-accent: @(MailUiState.SelectedAccount?.ColorHex ?? AppColors.Primary.ToRgbaHex(true))">

    @* ---- Left: accounts + folders ---- *@
    <aside class="mail-sidebar">
        <div class="mail-logo">💌<span class="mail-logo-text">My Lovely Mail</span><SyncHeart /></div>

        @if (MailUiState.SelectedAccount != null)
        {
            <PrimaryButton IsFullWidth="true" OnClick="@StartCompose" CustomClass="mail-compose-button">✏️ Compose</PrimaryButton>
        }

        @if (SavedSearchList.Count > 0)
        {
            <div class="mail-saved-searches">
                @foreach (var saved in SavedSearchList)
                {
                    <span class="mail-saved-chip">
                        <button class="mail-saved-run" @onclick="() => RunSavedSearch(saved)">🔍 @saved</button>
                        <button class="mail-saved-remove" @onclick="() => RemoveSavedSearch(saved)">✕</button>
                    </span>
                }
            </div>
        }

        @if (AccountStore.Accounts.Count == 0)
        {
            <GlassCard Level="AcrylicLevel.Normal" CustomClass="mail-welcome-card">
                <div class="mail-welcome-icon">🌸</div>
                <div class="mail-welcome-title">Welcome!</div>
                <p class="mail-welcome-text">Add your first mail account and your inbox will bloom here.</p>
                <PrimaryButton IsFullWidth="true" OnClick="@(() => Navigation.NavigateTo(AccountWizard.RoutePath))">
                    ➕ Add account
                </PrimaryButton>
            </GlassCard>
        }
        else
        {
            @foreach (var (account, accountIndex) in AccountStore.Accounts.Select(static (a, i) => (a, i)))
            {
                <button class="mail-account @(MailUiState.SelectedAccount?.Id == account.Id ? "mail-account--active" : "")"
                        title="@(accountIndex < 9 ? $"Ctrl+{accountIndex + 1}" : null)"
                        @onclick="() => SelectAccount(account)">
                    <span class="mail-account-dot" style="background:@account.ColorHex"></span>
                    @if (accountIndex < 9)
                    {
                        <span class="mail-account-ordinal">@(accountIndex + 1)</span>
                    }
                    <span class="mail-account-name">@(string.IsNullOrWhiteSpace(account.DisplayName) ? account.EmailAddress : account.DisplayName)</span>
                    @if (AccountUnreadCount(account.Id) is > 0 and var accountUnread)
                    {
                        <span class="mail-account-unread" style="background:@account.ColorHex">@accountUnread</span>
                    }
                </button>

                @if (MailUiState.SelectedAccount?.Id == account.Id)
                {
                    @foreach (var folder in Folders)
                    {
                        @* The row is itself a button, so the resync control has to be a SIBLING inside this wrapper. *@
                        <div class="mail-folder-row">
                            <button class="mail-folder @(MailUiState.SelectedFolder?.FullName == folder.FullName ? "mail-folder--active" : "")"
                                    @onclick="() => MailUiState.SelectFolder(folder)">
                                <span class="mail-folder-icon">@FolderIcon(folder.Role)</span>
                                <span class="mail-folder-name">@folder.DisplayName</span>
                                @if (folder.UnreadCount > 0)
                                {
                                    <CoreChip Text="@folder.UnreadCount.ToString()"
                                              Background="@AppColors.Primary"
                                              TextColor="@AppColors.TextOnAccent"
                                              FontSize="@AppMeasures.Font.XSmall"
                                              PaddingX="8" PaddingY="2" />
                                }
                            </button>
                            @if (!folder.IsLocal)
                            {
                                <button class="mail-folder-resync" title="Redownload this folder (newest 300 messages)"
                                        @onclick="() => ResyncFolder(folder)">🔄</button>
                            }
                        </div>
                    }
                }
            }
        }
    </aside>

    @* ---- Middle: message list ---- *@
    <section class="mail-list">
        <div class="mail-search">
            <CoreInput Placeholder="Search mail..." Icon="🔍" @bind-Value="SearchText" />
            @if (SyncScheduler.IsSyncing)
            {
                <div class="mail-sync-line"><span class="mail-sync-line-runner"></span></div>
            }
            <div class="mail-search-tools">
                @foreach (var (label, token) in QuickFilters)
                {
                    <button class="mail-search-toggle @(HasSearchToken(token) ? "mail-search-toggle--on" : "")"
                            @onclick="() => ToggleSearchToken(token)">@label</button>
                }
                @if (MailUiState.SelectedAccount != null)
                {
                    <button class="mail-search-toggle @(ConversationMode ? "mail-search-toggle--on" : "")"
                            title="Group replies into conversations"
                            @onclick="ToggleConversationMode">💬 Conversations</button>
                }
                @if (!string.IsNullOrWhiteSpace(SearchText))
                {
                    <button class="mail-search-toggle @(SearchAllFolders ? "mail-search-toggle--on" : "")" @onclick="ToggleSearchAllFolders">🌍 All folders</button>
                    <button class="mail-search-toggle" @onclick="SaveCurrentSearch">⭐ Save search</button>
                }
            </div>
        </div>

        @if (MailUiState.SelectedFolder == null)
        {
            <div class="mail-empty">
                <div class="mail-empty-icon">📮</div>
                <div class="mail-empty-text">Pick a folder to see its mail</div>
            </div>
        }
        else if (FilteredSummaries.Count == 0)
        {
            @if (string.IsNullOrWhiteSpace(SearchText)
                 && MailUiState.SelectedFolder is { } waitedFolder
                 && ImapSyncService.IsFolderSyncing(waitedFolder.AccountId, waitedFolder.FullName))
            {
                <div class="mail-empty">
                    <CoreSpinner />
                    <div class="mail-empty-text">Fetching this folder from the server…</div>
                </div>
            }
            else if (string.IsNullOrWhiteSpace(SearchText) && MailUiState.SelectedFolder is { Role: FolderRole.Inbox })
            {
                <div class="mail-empty mail-inbox-zero">
                    <div class="mail-inbox-zero-hearts">
                        @for (int heartIndex = 0; heartIndex < InboxZeroHeartCount; heartIndex++)
                        {
                            <span class="mail-inbox-zero-heart" style="@InboxZeroHeartStyle(heartIndex)">💗</span>
                        }
                    </div>
                    @* Emoji stays OUTSIDE the gradient span: background-clip:text turns color emoji into flat blocks. *@
                    <div class="mail-inbox-zero-headline"><span class="mail-inbox-zero-title">Inbox Zero</span> 💖</div>
                    <div class="mail-empty-text">Nothing left to read — enjoy the quiet.</div>
                </div>
            }
            else
            {
                <div class="mail-empty">
                    <div class="mail-empty-icon">🕊️</div>
                    <div class="mail-empty-text">@(string.IsNullOrWhiteSpace(SearchText) ? "This folder is empty" : "Nothing matches your search")</div>
                </div>
            }
        }
        else
        {
            @if (MailUiState.SelectedUids.Count > 0)
            {
                <div class="mail-bulk-bar">
                    <span class="mail-bulk-count">@MailUiState.SelectedUids.Count selected</span>
                    <button class="mail-search-toggle" @onclick="() => BulkSetRead(true)">✅ Read</button>
                    <button class="mail-search-toggle" @onclick="() => BulkSetRead(false)">📩 Unread</button>
                    <button class="mail-search-toggle" @onclick="BulkToggleFlag">⭐ Star</button>
                    <button class="mail-search-toggle" @onclick="BulkToggleImportant">❗ Important</button>
                    <button class="mail-search-toggle" @onclick="BulkDelete">🗑️ Delete</button>
                    @{
                        var moveTargets = MoveTargets;
                    }
                    @if (moveTargets.Count > 0)
                    {
                        <span class="mail-bulk-move">
                            <button class="mail-search-toggle" @onclick="() => ShowMovePicker = !ShowMovePicker">📂 Move</button>
                            @if (ShowMovePicker)
                            {
                                <div class="mail-move-popover">
                                    @foreach (var targetGroup in moveTargets.GroupBy(f => f.IsLocal).OrderBy(g => g.Key))
                                    {
                                        @if (targetGroup.Key && moveTargets.Any(f => !f.IsLocal))
                                        {
                                            <div class="mail-move-divider">📁 On this machine</div>
                                        }
                                        @foreach (var targetFolder in targetGroup)
                                        {
                                            <button class="mail-move-option" @onclick="() => BulkMoveTo(targetFolder)">
                                                @FolderIcon(targetFolder.Role) @targetFolder.DisplayName
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </span>
                    }
                    <button class="mail-search-toggle" @onclick="() => MailUiState.SelectMany(Rows.Select(r => r.Message.Uid))">☑️ All</button>
                    <button class="mail-search-toggle" @onclick="MailUiState.ClearSelection">✕ Clear</button>
                </div>
            }
            <div class="mail-rows" tabindex="0" @onkeydown="HandleListKeyDown" @onkeydown:preventDefault="true">
                <Virtualize Items="Rows" Context="row" ItemSize="76">
                    @{
                        var message = row.Message;
                        bool rowUnread = row.UnreadCount > 0;
                    }
                    <button class="mail-row @(rowUnread ? "mail-row--unread" : "") @(MailUiState.OpenMessage == message ? "mail-row--active" : "") @(MailUiState.FocusedMessage == message ? "mail-row--focused" : "") @(bloomingUids.Contains(message.Uid) ? "mail-row--bloom" : "")"
                            @onclick="e => HandleRowClick(e, message)">
                        <span class="mail-row-check @(MailUiState.SelectedUids.Contains(message.Uid) ? "mail-row-check--on" : "")"
                              @onclick="() => MailUiState.ToggleSelected(message.Uid)" @onclick:stopPropagation="true">
                            @(MailUiState.SelectedUids.Contains(message.Uid) ? "☑" : "☐")
                        </span>
                        <span class="mail-row-avatar @(rowUnread ? "mail-row-avatar--unread" : "")" style="background:@AvatarGradient(message)">@AvatarInitials(message)</span>
                        <span class="mail-row-dot"></span>
                        <span class="mail-row-main">
                            <span class="mail-row-top">
                                <span class="mail-row-from">@row.SenderText</span>
                                @if (row.ConversationCount > 1)
                                {
                                    <span class="mail-row-thread-count" title="@row.ConversationCount messages in this conversation">@row.ConversationCount</span>
                                }
                                <span class="mail-row-date">@FormatDate(message.DateUtc)</span>
                            </span>
                            <span class="mail-row-subject">
                                @if (message.Flags.HasFlag(MailFlags.Important))
                                {
                                    <span class="mail-row-flag">❗</span>
                                }
                                @if (message.Flags.HasFlag(MailFlags.Flagged))
                                {
                                    <span class="mail-row-flag">⭐</span>
                                }
                                @(string.IsNullOrWhiteSpace(message.Subject) ? "(no subject)" : message.Subject)
                            </span>
                            <span class="mail-row-preview">
                                @if (HitFolderDisplay(message) is { } hitFolder)
                                {
                                    <span class="mail-row-folder">📁 @hitFolder</span>
                                }
                                @foreach (var tag in message.Tags)
                                {
                                    <span class="mail-tag-chip" style="background:@TagStore.ColorOf(tag)">@tag</span>
                                }
                                @if (message.HasAttachments)
                                {
                                    <span class="mail-row-attach">📎</span>
                                }
                                @message.PreviewText
                            </span>
                        </span>
                    </button>
                </Virtualize>
            </div>
        }
    </section>

    @* ---- Right: compose pane or reading pane ---- *@
    <section class="mail-reader">
        @if (OutboxService.LastFailure is { } failedSend)
        {
            <div class="mail-undo-bar mail-undo-bar--failed">
                <span class="mail-undo-text">❌ Send failed: "@(string.IsNullOrWhiteSpace(failedSend.Draft.Subject) ? "(no subject)" : failedSend.Draft.Subject)" — @failedSend.Reason</span>
                <button class="mail-undo-button" @onclick="OutboxService.RetryFailed">🔁 Retry</button>
                <button class="mail-undo-button" @onclick="EditFailedSend">✏️ Edit</button>
                <button class="mail-undo-button" @onclick="OutboxService.DismissFailed">✕ Dismiss</button>
            </div>
        }
        @if (OutboxService.Current is { } pendingSend)
        {
            <div class="mail-undo-bar">
                <span class="mail-undo-text">✉️ Sending "@(string.IsNullOrWhiteSpace(pendingSend.Draft.Subject) ? "(no subject)" : pendingSend.Draft.Subject)" in @(UndoSecondsLeft(pendingSend))s…</span>
                <button class="mail-undo-button" @onclick="UndoPendingSend">↩️ Undo</button>
            </div>
        }
        @if (MailUiState.ActiveCompose is { } draft)
        {
            <div class="mail-reader-header">
                <BackButton OnClick="@SaveAndCloseCompose" />
                <div class="mail-reader-subject">✏️ @(string.IsNullOrWhiteSpace(draft.Subject) ? "New message" : draft.Subject)</div>
                @if (DraftSavedAt != null)
                {
                    <span class="mail-compose-saved">💾 @DraftSavedAt?.ToString("HH:mm:ss")</span>
                }
            </div>

            <GlassCard Level="AcrylicLevel.Strong" CustomClass="mail-compose-card">
                <div class="mail-compose-fields" @oninput="NoteComposeActivity">
                <div class="mail-compose-from">From: <b>@draft.Account?.EmailAddress</b></div>
                @* Native datalist: the browser owns the dropdown, so autosave and typing stay untouched. *@
                <datalist id="@ContactListId">
                    @foreach (var contact in KnownContacts)
                    {
                        <option value="@contact.Suggestion"></option>
                    }
                </datalist>
                <CoreInput Placeholder="To (comma separated)" Icon="👤" ListId="@ContactListId" @bind-Value="draft.To" />
                <CoreInput Placeholder="Cc" Icon="👥" ListId="@ContactListId" @bind-Value="draft.Cc" />
                <CoreInput Placeholder="Subject" Icon="🏷️" @bind-Value="draft.Subject" />
                <textarea class="mail-compose-body" placeholder="Write something lovely..." @bind="draft.Body" @bind:event="oninput"></textarea>
                </div>

                <label class="mail-compose-dropzone">
                    <InputFile OnChange="OnComposeFilesSelectedAsync" multiple class="mail-compose-file-input" />
                    📎 Attach files — click or drop them here
                </label>
                @if (draft.AttachmentPaths.Count > 0)
                {
                    <div class="mail-compose-attachments">
                        @foreach (var attachmentPath in draft.AttachmentPaths)
                        {
                            <span class="mail-compose-attachment-chip">
                                📎 @Path.GetFileName(attachmentPath)
                                <button class="mail-compose-attachment-remove" title="Remove"
                                        @onclick="() => RemoveComposeAttachment(attachmentPath)">✕</button>
                            </span>
                        }
                    </div>
                }

                @if (SendError != null)
                {
                    <p class="mail-compose-error">❌ @SendError</p>
                }

                <div class="mail-compose-actions">
                    <SecondaryButton OnClick="@DiscardCompose">🗑️ Discard</SecondaryButton>
                    <PrimaryButton OnClick="@QueueActiveDraftSend" Disabled="@(string.IsNullOrWhiteSpace(draft.To))">📨 Send</PrimaryButton>
                </div>
            </GlassCard>
        }
        else if (MailUiState.OpenMessage is not { } open)
        {
            <div class="mail-empty">
                <div class="mail-empty-icon">💌</div>
                <div class="mail-empty-text">Select a message to read it here</div>
            </div>
        }
        else
        {
            @* @key remounts this subtree per message, so the open animation replays on every switch. *@
            <div class="mail-reader-content" @key="open.Uid">
            <div class="mail-reader-header">
                <BackButton OnClick="@MailUiState.CloseMessage" />
                <div class="mail-reader-titles">
                    <div class="mail-reader-subject">@(string.IsNullOrWhiteSpace(open.Subject) ? "(no subject)" : open.Subject)</div>
                    <div class="mail-reader-meta">
                        <span class="mail-reader-from">@open.FromName &lt;@open.FromAddress&gt;</span>
                        <span class="mail-reader-date">@open.DateUtc.ToLocalTime().ToString(ContentConstants.DateFormats.UiBanner + " HH:mm")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(open.ToAddresses))
                    {
                        <div class="mail-reader-to">to @open.ToAddresses</div>
                    }
                </div>
            </div>

            <div class="mail-reader-actions">
                <SecondaryButton FontSize="@AppMeasures.Font.Small" Padding="@(AppMeasures.Space.Px6 + "px " + AppMeasures.Space.Px10 + "px")" OnClick="@(() => StartReply(open, replyAll: false))">↩️ Reply</SecondaryButton>
                <SecondaryButton FontSize="@AppMeasures.Font.Small" Padding="@(AppMeasures.Space.Px6 + "px " + AppMeasures.Space.Px10 + "px")" OnClick="@(() => StartReply(open, replyAll: true))">👥 Reply all</SecondaryButton>
                <SecondaryButton FontSize="@AppMeasures.Font.Small" Padding="@(AppMeasures.Space.Px6 + "px " + AppMeasures.Space.Px10 + "px")" OnClick="@(() => StartForward(open))">➡️ Forward</SecondaryButton>
                <SecondaryButton FontSize="@AppMeasures.Font.Small" Padding="@(AppMeasures.Space.Px6 + "px " + AppMeasures.Space.Px10 + "px")" OnClick="@(() => ToggleOpenFlagged(open))">@(open.Flags.HasFlag(MailFlags.Flagged) ? "⭐ Starred" : "☆ Star")</SecondaryButton>
                <SecondaryButton FontSize="@AppMeasures.Font.Small" Padding="@(AppMeasures.Space.Px6 + "px " + AppMeasures.Space.Px10 + "px")" OnClick="@(() => ToggleOpenImportant(open))">@(open.Flags.HasFlag(MailFlags.Important) ? "❗ Important" : "❕ Mark important")</SecondaryButton>
                <SecondaryButton FontSize="@AppMeasures.Font.Small" Padding="@(AppMeasures.Space.Px6 + "px " + AppMeasures.Space.Px10 + "px")" OnClick="@(() => ShowTagPicker = !ShowTagPicker)">🏷️ Tags</SecondaryButton>
                <SecondaryButton FontSize="@AppMeasures.Font.Small" Padding="@(AppMeasures.Space.Px6 + "px " + AppMeasures.Space.Px10 + "px")" OnClick="@(() => OpenMessageSource(open))">🔍 Source</SecondaryButton>
                <SecondaryButton FontSize="@AppMeasures.Font.Small" Padding="@(AppMeasures.Space.Px6 + "px " + AppMeasures.Space.Px10 + "px")" OnClick="@(() => ExportOpen(open, asHtml: false))">💾 .eml</SecondaryButton>
                <SecondaryButton FontSize="@AppMeasures.Font.Small" Padding="@(AppMeasures.Space.Px6 + "px " + AppMeasures.Space.Px10 + "px")" OnClick="@(() => ExportOpen(open, asHtml: true))">🌐 .html</SecondaryButton>
                <DangerButton FontSize="@AppMeasures.Font.Small" Padding="@(AppMeasures.Space.Px6 + "px " + AppMeasures.Space.Px10 + "px")" OnClick="@(() => DeleteOpen(open))">🗑️ Delete</DangerButton>
            </div>

            @if (open.Tags.Count > 0 || ShowTagPicker)
            {
                <div class="mail-attachments">
                    @foreach (var tag in open.Tags)
                    {
                        <button class="mail-tag-chip mail-tag-chip--action" style="background:@TagStore.ColorOf(tag)"
                                title="Search this tag" @onclick="() => SearchByTag(tag)">@tag</button>
                    }
                </div>
            }

            @if (ShowTagPicker)
            {
                <div class="mail-tag-picker">
                    @foreach (var tag in TagStore.AllTags)
                    {
                        <button class="mail-tag-chip mail-tag-chip--action @(open.Tags.Contains(tag, StringComparer.OrdinalIgnoreCase) ? "" : "mail-tag-chip--off")"
                                style="background:@TagStore.ColorOf(tag)"
                                @onclick="() => ToggleTagOnOpen(open, tag)">
                            @(open.Tags.Contains(tag, StringComparer.OrdinalIgnoreCase) ? "✓ " : "")@tag
                        </button>
                    }
                    <input class="mail-tag-input" placeholder="New tag..." @bind="NewTagName" @bind:event="oninput" />
                    <button class="mail-search-toggle" @onclick="() => AddNewTag(open)" disabled="@(NewTagName.Trim().Length == 0)">➕ Add</button>
                </div>
            }

            @if (OpenAttachments.Count > 0)
            {
                <div class="mail-attachments">
                    @foreach (var attachment in OpenAttachments)
                    {
                        <button class="mail-attachment-chip" title="Save to Downloads"
                                @onclick="() => SaveAttachmentAsync(attachment.Index)">
                            @AttachmentService.IconFor(attachment) @attachment.FileName
                            @if (attachment.HumanSize.Length > 0)
                            {
                                <span class="mail-attachment-size">@attachment.HumanSize</span>
                            }
                        </button>
                    }
                    @if (OpenAttachments.Count > 1)
                    {
                        <button class="mail-attachment-chip mail-attachment-chip--all" @onclick="SaveAllAttachmentsAsync">📦 Save all</button>
                    }
                </div>
            }
            @if (SaveStatus != null)
            {
                <div class="mail-save-status">@SaveStatus</div>
            }

            @if (OpenBodyBlockedImages)
            {
                <div class="mail-image-banner">
                    🖼️ Remote images were blocked for your privacy.
                    <button class="mail-search-toggle" @onclick="AllowImagesOnce">Show images once</button>
                </div>
            }

            <GlassCard Level="AcrylicLevel.Strong" CustomClass="mail-reader-body">
                @if (OpenBodyLoading)
                {
                    <div class="mail-body-loading">
                        <CoreSpinner />
                    </div>
                }
                else if (OpenBodyHtml != null)
                {
                    <iframe class="mail-reader-frame" sandbox="allow-same-origin" srcdoc="@OpenBodyHtml"></iframe>
                }
                else
                {
                    @if (BodyError != null)
                    {
                        <p class="mail-compose-error">❌ @BodyError</p>
                    }
                    @if (string.IsNullOrWhiteSpace(open.PreviewText))
                    {
                        <p class="mail-reader-nobody">The full message is not cached yet. It will appear as soon as sync fetches it.</p>
                    }
                    else
                    {
                        <p class="mail-reader-preview">@open.PreviewText</p>
                    }
                }
            </GlassCard>
            </div>
        }
    </section>
</div>

<CoreModal IsVisible="ShowMessageSource" OnBackdropClick="@(() => ShowMessageSource = false)">
    <div class="mail-source">
        <div class="mail-source-tabs">
            <button class="mail-search-toggle @(ShowRawSource ? "" : "mail-search-toggle--on")" @onclick="() => ShowRawSource = false">📋 Headers</button>
            <button class="mail-search-toggle @(ShowRawSource ? "mail-search-toggle--on" : "")" @onclick="() => ShowRawSource = true">📄 Raw MIME</button>
            <button class="mail-search-toggle" @onclick="CopySourceAsync">⧉ Copy</button>
            <button class="mail-search-toggle" @onclick="() => ShowMessageSource = false">✕ Close</button>
        </div>
        @if (ShowRawSource)
        {
            <pre class="mail-source-raw">@(SourceRaw.Length > 0 ? SourceRaw : "The message body is not cached yet — open it once while online.")</pre>
        }
        else if (SourceHeaders.Count == 0)
        {
            <p class="mail-empty-text">The message body is not cached yet — open it once while online.</p>
        }
        else
        {
            <div class="mail-source-headers">
                @foreach (var (name, value) in SourceHeaders)
                {
                    <div class="mail-source-header-name">@name</div>
                    <div class="mail-source-header-value">@value</div>
                }
            </div>
        }
    </div>
</CoreModal>

<CoreModal IsVisible="ShowShortcutHelp" OnBackdropClick="@(() => ShowShortcutHelp = false)">
    <div class="mail-shortcuts">
        <div class="mail-shortcuts-title">⌨️ Keyboard shortcuts</div>
        @foreach (var (keys, action) in ShortcutHelpRows)
        {
            <div class="mail-shortcuts-row">
                <span class="mail-shortcuts-keys">@keys</span>
                <span class="mail-shortcuts-action">@action</span>
            </div>
        }
    </div>
</CoreModal>

<MailCss />
