@attribute [Route("/")]
@attribute [Route(NavigationConstants.Mail.Link)]
@inherits MyLovelyMail.MainProject.UI.Layout.Architecture.PageBase
@implements IDisposable
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings
<PageTitle>My Lovely Mail</PageTitle>
@{ var workspaceTargets = WorkspaceTargets; var workspacePayload = JsonSerializer.Serialize(workspaceTargets); }

<div class="@MailCssClasses.Screen @(MailUiState.ThirdPane != null ? MailCssClasses.ScreenPaneOpen : "") @(activeSplitter != 0 ? MailCssClasses.ScreenResizing : "")"
     tabindex="-1"
     @onpointermove="OnScreenPointerMove"
     @onpointerup="OnScreenPointerUp"
     @onkeydown="OnScreenKeyDown"
     data-context-menu="true" @oncontextmenu="e => OpenWorkspaceMenu(e)" @oncontextmenu:preventDefault="true"
     data-mouse4="@(workspaceTargets.Length > 0 ? MouseActionService.TrashAction : "menu")" data-mouse4-value="@workspacePayload"
     data-mouse5="@(workspaceTargets.Length > 0 ? MouseActionService.ReadAction : MouseActionService.SyncAction)" data-mouse5-value="@workspacePayload"
     style="--account-accent: @(MailUiState.SelectedAccount?.ColorHex ?? AppColors.Primary.ToRgbaHex(true)); --account-ink: @(AppColors.InkOn(MailUiState.SelectedAccount?.ColorHex ?? AppColors.Primary.ToRgbaHex(true)).ToRgbaHex(true))">

    <MailSidebar View="this" />

    <ColumnSplitter Index="1"
                    IsDragging="@(activeSplitter == 1)"
                    Title="Drag to resize sidebar (snaps near 20.0% · double-click to reset)"
                    OnPointerDown="e => StartColumnSplitterDrag(1, e)"
                    OnDoubleClick="() => ResetColumnSplitter(1)" />

    @* ---- Middle: message list ---- *@
    <section class="@MailCssClasses.List">
        <div class="@MailCssClasses.Search">
            <CoreInput Placeholder="Search mail..." Icon="🔎" @bind-Value="SearchText" />
            <div class="@MailCssClasses.SelectionTools">
                <PillButton IsActive="@SelectionMode" OnClick="() => SelectionMode = !SelectionMode">☑ Select</PillButton>
                <PillButton OnClick="SelectAllMessages" Disabled="@(Rows.Count == 0)">Select all</PillButton>
                <PillButton Title="Select by read state, stars, attachments or tags" OnClick="OpenSelectionMenu" Disabled="@(Rows.Count == 0)">Select ▾</PillButton>
                <PillButton Title="List navigation, selection and keyboard shortcuts" OnClick="OpenListActionsMenu">Actions ▾</PillButton>
                <PillButton IsIcon="true" Title="Keyboard shortcuts (?)" OnClick="OpenShortcutHelpModal">⌨️</PillButton>
                @if (MailUiState.SelectedFolder is { Role: FolderRole.Trash or FolderRole.Junk } trashOrJunkFolder
                     && MailUiState.SelectedAccount is { } activeAcc
                     && CachedCount > 0)
                {
                    <PillButton IsDanger="true"
                                Title="@($"Permanently delete all messages in {trashOrJunkFolder.DisplayName}")"
                                OnClick="() => EmptyFolderWithConfirmationAsync(activeAcc, trashOrJunkFolder)">
                        @(trashOrJunkFolder.Role == FolderRole.Trash ? "🗑️ Empty Trash" : "🧹 Empty Spam")
                    </PillButton>
                }
                @if (MailUiState.SelectedMessages.Count > 0)
                {
                    <PillButton OnClick="MailUiState.ClearSelection">Clear selection</PillButton>
                }
            </div>
            @if (SyncScheduler.IsSyncing)
            {
                <div class="@MailCssClasses.SyncLine"><span class="@MailCssClasses.SyncLineRunner"></span></div>
            }
            <div class="@MailCssClasses.SearchFoldRow">
                <PillButton IsActive="@(!ShowSearchTools && ActiveFilterCount > 0)"
                            Title="@(ShowSearchTools ? "Hide the quick filters" : "Show the quick filters")"
                            OnClick="() => ShowSearchTools = !ShowSearchTools">
                    🎛️ Filters@(!ShowSearchTools && ActiveFilterCount > 0 ? $" · {ActiveFilterCount}" : "") @(ShowSearchTools ? "▴" : "▾")
                </PillButton>
            </div>
            @if (ShowSearchTools)
            {
                <div class="@MailCssClasses.SearchTools">
                    @foreach (var (label, token) in QuickFilters)
                    {
                        <PillButton IsActive="@HasSearchToken(token)"
                                    OnClick="() => ToggleSearchToken(token)">@label</PillButton>
                    }
                    @if (MailUiState.SelectedAccount != null)
                    {
                        <PillButton IsActive="@ConversationMode"
                                    Title="Group replies into conversations"
                                    OnClick="ToggleConversationMode">🧵 Conversations</PillButton>
                    }
                    @if (!string.IsNullOrWhiteSpace(SearchText))
                    {
                        <PillButton IsActive="@SearchAllFolders" OnClick="ToggleSearchAllFolders">🗂️ All folders</PillButton>
                        <PillButton OnClick="SaveCurrentSearch">⭐ Save search</PillButton>
                    }
                </div>
            }
        </div>

        @if (MailUiState.SelectedFolder == null)
        {
            <div class="mail-empty">
                <div class="mail-empty-icon">📭</div>
                <div class="mail-empty-text">Pick a folder to see its mail</div>
            </div>
        }
        else if (FilteredSummaries.Count == 0)
        {
            @if (string.IsNullOrWhiteSpace(SearchText)
                 && MailUiState.SelectedFolder is { } waitedFolder
                 && ImapSyncService.IsFolderSyncing(waitedFolder.AccountId, waitedFolder.FullName))
            {
                <div class="mail-empty">
                    <CoreSpinner />
                    <div class="mail-empty-text">Fetching this folder from the server…</div>
                </div>
            }
            else if (string.IsNullOrWhiteSpace(SearchText) && MailUiState.SelectedFolder is { Role: FolderRole.Inbox })
            {
                <div class="mail-empty mail-inbox-zero">
                    <div class="mail-inbox-zero-hearts">
                        @for (int heartIndex = 0; heartIndex < InboxZeroHeartCount; heartIndex++)
                        {
                            <span class="mail-inbox-zero-heart" style="@InboxZeroHeartStyle(heartIndex)">💖</span>
                        }
                    </div>
                    <div class="mail-inbox-zero-headline"><span class="mail-inbox-zero-title">Inbox Zero</span> ✨</div>
                    <div class="mail-empty-text">Nothing left to read — enjoy the quiet.</div>
                </div>
            }
            else if (string.IsNullOrWhiteSpace(SearchText) && MailUiState.SelectedFolder is { } emptyFolder)
            {
                var why = FolderEmptyReason.Explain(emptyFolder);
                <div class="mail-empty">
                    <div class="mail-empty-icon">🕊️</div>
                    <div class="mail-empty-text">@why.Headline</div>
                    <div class="mail-empty-detail">@why.Detail</div>
                    @if (why.Action != EmptyFolderAction.None)
                    {
                        <SecondaryButton OnClick="@(() => RunEmptyFolderAction(emptyFolder, why.Action))">@why.ActionLabel</SecondaryButton>
                    }
                </div>
            }
            else
            {
                <div class="mail-empty">
                    <div class="mail-empty-icon">🕊️</div>
                    <div class="mail-empty-text">@(string.IsNullOrWhiteSpace(SearchText) ? FolderEmptyReason.PlainlyEmpty : "Nothing matches your search")</div>
                    <div class="mail-rescue">
                        @foreach (var rescue in SearchRescues)
                        {
                            <PillButton OnClick="() => ApplyRescue(rescue)">@rescue.Label</PillButton>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            @if (MailUiState.SelectedMessages.Count > 0)
            {
                bool bulkInTrash = MailUiState.SelectedFolder?.Role == FolderRole.Trash;
                <div class="@MailCssClasses.BulkBar">
                    <span class="@MailCssClasses.BulkCount">@MailUiState.SelectedMessages.Count selected</span>
                    <PillButton OnClick="OpenBulkActionsMenu">More actions ▾</PillButton>
                    <PillButton OnClick="() => RunSelectionCommandAsync(MailMessageCommand.Read)">✅ Read</PillButton>
                    <PillButton OnClick="() => RunSelectionCommandAsync(MailMessageCommand.Unread)">📩 Unread</PillButton>
                    <PillButton OnClick="OpenBulkMarkersModal">⭐ Labels</PillButton>
                    @if (MoveTargets(MailUiState.SelectedMessages).Count > 0)
                    {
                        <PillButton OnClick="OpenBulkMoveModal">📂 Move</PillButton>
                    }
                    <PillButton OnClick="OpenBulkSnoozeModal">⏰ Snooze</PillButton>
                    <PillButton IsDanger="true" OnClick="() => RunSelectionCommandAsync(MailMessageCommand.Trash)">
                        @(bulkInTrash ? "🗑️ Delete forever" : "🗑️ Trash")
                    </PillButton>
                    <PillButton OnClick="SelectAllMessages">☑️ All</PillButton>
                    <PillButton OnClick="MailUiState.ClearSelection">✕ Clear</PillButton>
                </div>
            }
            <div class="@MailCssClasses.Rows" tabindex="0" @onkeydown="HandleListKeyDown">
                <Virtualize Items="Rows" Context="row" ItemSize="76">
                    @{
                        var message = row.Message;
                        bool rowUnread = row.UnreadCount > 0;
                        var targets = MessageTargets(message);
                        string payload = JsonSerializer.Serialize(targets);
                    }
                    <div class="mail-row-shell" @key="MessageIdentityOf(message)" data-context-menu="true"
                         draggable="true"
                         @ondragstart="() => StartMessageDrag(targets)"
                         @ondragend="EndMessageDrag"
                         @oncontextmenu="e => OpenMessageMenu(targets, e.ClientX, e.ClientY)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
                    <button class="mail-row @(rowUnread ? "mail-row--unread" : "") @(MailUiState.OpenMessage == message ? "mail-row--active" : "") @(MailUiState.FocusedMessage == message ? "mail-row--focused" : "") @(bloomingUids.Contains(message.Uid) ? "mail-row--bloom" : "")"
                            data-mouse4="@MouseActionService.TrashAction" data-mouse4-value="@payload"
                            data-mouse5="@MouseActionService.ReadAction" data-mouse5-value="@payload"
                            @onfocus="() => MailUiState.FocusMessage(message, MessageIdentityOf(message))"
                            @onclick="e => HandleRowClick(e, message)">
                        <span class="mail-row-check @(IsRowSelected(message) ? "mail-row-check--on" : "")" title="Select this conversation; Shift selects a range"
                              @onclick="e => ToggleRowSelection(e, message)" @onclick:stopPropagation="true">
                            @(IsRowSelected(message) ? "✓" : "○")
                        </span>
                        <span class="mail-row-avatar @(rowUnread ? "mail-row-avatar--unread" : "")" style="background:@AvatarGradient(message)">@AvatarInitials(message)</span>
                        <span class="mail-row-dot"></span>
                        <span class="mail-row-main">
                            <span class="mail-row-top">
                                <span class="mail-row-from">@row.SenderText</span>
                                @if (row.ConversationCount > 1)
                                {
                                    <span class="mail-row-thread-count" title="@row.ConversationCount messages in this conversation">@row.ConversationCount</span>
                                }
                                <span class="mail-row-date">@FormatDate(message.DateUtc)</span>
                            </span>
                            <span class="mail-row-subject">
                                @if (message.Flags.HasFlag(MailFlags.Muted))
                                {
                                    <span class="mail-row-flag mail-row-flag--muted" title="Muted conversation — replies arrive quietly">🔇</span>
                                }
                                @if (message.Flags.HasFlag(MailFlags.Important))
                                {
                                    <span class="mail-row-flag">❗</span>
                                }
                                @if (message.Flags.HasFlag(MailFlags.Flagged))
                                {
                                    <span class="mail-row-flag">⭐</span>
                                }
                                @(string.IsNullOrWhiteSpace(message.Subject) ? "(no subject)" : message.Subject)
                            </span>
                            <span class="mail-row-preview">
                                @if (OutboxStatusOf(message) is { } outboxStatus)
                                {
                                    <span class="mail-row-outbox">@outboxStatus</span>
                                }
                                @if (HitFolderDisplay(message) is { } hitFolder)
                                {
                                    <span class="mail-row-folder">📁 @hitFolder</span>
                                }
                                @foreach (var tag in message.Tags)
                                {
                                    <span class="mail-tag-chip" style="background:@TagStore.ColorOf(tag);color:@AppColors.InkOn(TagStore.ColorOf(tag)).ToRgbaHex(true)"
                                          data-context-menu="true" data-mouse4="RemoveTag" data-mouse4-value="@JsonSerializer.Serialize(new MailMessageRequest { Messages = targets, Argument = tag })" data-mouse5="menu"
                                          @oncontextmenu="e => OpenTagMenu(tag, message, e)" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">@tag</span>
                                }
                                @if (message.HasAttachments)
                                {
                                    <span class="mail-row-attach">📎</span>
                                }
                                @if (message.SnoozedUntilUtc is { } snoozedUntil)
                                {
                                    <button class="mail-row-snoozed" title="Bring it back now"
                                            @onclick="() => WakeMessage(message)" @onclick:stopPropagation="true">@SnoozeLabel(snoozedUntil)</button>
                                }
                                @message.PreviewText
                            </span>
                        </span>
                    </button>
                    <div class="mail-row-quick-actions">
                        <button title="Mark read (Mouse 5)" aria-label="Mark read" @onclick="() => MouseActionService.RunMessagesAsync(MailMessageCommand.Read, targets, includeSelection: false)">✓</button>
                        <button title="@(MailUiState.SelectedFolder?.Role == FolderRole.Trash ? "Delete forever (Mouse 4)" : "Move to Trash (Mouse 4)")" aria-label="Trash" @onclick="() => MouseActionService.RunMessagesAsync(MailMessageCommand.Trash, targets, includeSelection: false)">🗑️</button>
                        <button title="Message actions" aria-label="Message actions" aria-haspopup="menu" @onclick="e => OpenMessageMenu(targets, e.ClientX, e.ClientY)">⋯</button>
                    </div>
                    </div>
                </Virtualize>

                @if (!SearchAllFolders && TruncatedFolder is { } truncated)
                {
                    <div class="mail-backfill">
                        <span class="mail-backfill-text">
                            Showing @CachedCount.ToString("N0") of @truncated.TotalCount.ToString("N0") here
                        </span>
                        @if (ImapSyncService.IsFolderSyncing(truncated.AccountId, truncated.FullName))
                        {
                            <CoreSpinner />
                        }
                        else
                        {
                            <button class="mail-backfill-button" @onclick="() => LoadOlder(truncated)">
                                ⬇️ Load @BackfillBatchSize older
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </section>

    <ColumnSplitter Index="2"
                    IsDragging="@(activeSplitter == 2)"
                    Title="Drag to resize message list & reader (snaps near 32.0% / 48.0% · double-click to reset)"
                    OnPointerDown="e => StartColumnSplitterDrag(2, e)"
                    OnDoubleClick="() => ResetColumnSplitter(2)" />

    <MailReaderPane View="this" />
</div>

<MailCss />
