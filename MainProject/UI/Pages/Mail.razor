@attribute [Route("/")]
@attribute [Route(NavigationConstants.Mail.Link)]
@inherits MyLovelyMail.MainProject.UI.Layout.Architecture.PageBase
@implements IDisposable
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings
<PageTitle>My Lovely Mail</PageTitle>
@{ var workspaceTargets = WorkspaceTargets; var workspacePayload = JsonSerializer.Serialize(workspaceTargets); }

<div class="@MailCssClasses.Screen @(MailUiState.ThirdPane != null ? MailCssClasses.ScreenPaneOpen : "") @(activeSplitter != 0 ? MailCssClasses.ScreenResizing : "")"
     tabindex="-1"
     @onpointermove="OnScreenPointerMove"
     @onpointerup="OnScreenPointerUp"
     @onkeydown="OnScreenKeyDown"
     @oncontextmenu="e => OpenWorkspaceMenu(e)" @oncontextmenu:preventDefault="true"
     @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
         () => { if (workspaceTargets.Length > 0) return MouseActionService.RunMessagesAsync(MailMessageCommand.Trash, workspaceTargets); OpenWorkspaceMenu(e); return Task.CompletedTask; },
         () => workspaceTargets.Length > 0 ? MouseActionService.RunMessagesAsync(MailMessageCommand.Read, workspaceTargets) : MouseActionService.RunAsync(MouseActionService.SyncAction, string.Empty))"
     style="--account-accent: @(MailUiState.SelectedAccount?.ColorHex ?? AppColors.Primary.ToRgbaHex(true)); --account-ink: @(AppColors.InkOn(MailUiState.SelectedAccount?.ColorHex ?? AppColors.Primary.ToRgbaHex(true)).ToRgbaHex(true))">

    <MailSidebar View="this" />

    <ColumnSplitter Index="1"
                    IsDragging="@(activeSplitter == 1)"
                    Title="Drag to resize sidebar (snaps within ±3% of 20.0% · double-click to reset)"
                    OnPointerDown="e => StartColumnSplitterDrag(1, e)"
                    OnDoubleClick="() => ResetColumnSplitter(1)" />

    @* ---- Middle: message / sender list ---- *@
    <section class="@MailCssClasses.List">
        <div class="@MailCssClasses.Search">
            <CoreInput Placeholder="Search mail..." Icon="🔎" Clearable="true" @bind-Value="SearchText" />

            <CustomizableActionBar SurfaceId="@UiSurfaceIds.ListToolbar"
                                   PairedMenuSurfaceId="@UiSurfaceIds.WorkspaceContextMenu"
                                   DefaultActions="@BuildListToolbarActions()"
                                   AddedActionResolver="@(id => ResolveToolbarAddedAction(UiSurfaceIds.ListToolbar, id))"
                                   Wrap="true"
                                   CustomClass="@MailCssClasses.SelectionTools" />

            @if (SyncScheduler.IsSyncing)
            {
                <div class="@MailCssClasses.SyncLine"><span class="@MailCssClasses.SyncLineRunner"></span></div>
            }

            @if (ShowSearchTools)
            {
                <CustomizableActionBar SurfaceId="@UiSurfaceIds.QuickFiltersBar"
                                       PairedMenuSurfaceId="@UiSurfaceIds.WorkspaceContextMenu"
                                       DefaultActions="@BuildQuickFilterActions()"
                                       AddedActionResolver="@(id => ResolveToolbarAddedAction(UiSurfaceIds.QuickFiltersBar, id))"
                                       Wrap="true"
                                       CustomClass="@MailCssClasses.SearchTools" />
            }
        </div>

        @if (MailUiState.SelectedFolder == null)
        {
            <div class="@MailCssClasses.Empty">
                <div class="@MailCssClasses.EmptyIcon">📭</div>
                <div class="@MailCssClasses.EmptyText">Pick a folder to see its mail</div>
            </div>
        }
        else if (!IsSenderListView && FilteredSummaries.Count == 0)
        {
            @if (string.IsNullOrWhiteSpace(SearchText)
                 && MailUiState.SelectedFolder is { } waitedFolder
                 && ImapSyncService.IsFolderSyncing(waitedFolder.AccountId, waitedFolder.FullName))
            {
                <div class="@MailCssClasses.Empty">
                    <CoreSpinner />
                    <div class="@MailCssClasses.EmptyText">Fetching this folder from the server…</div>
                </div>
            }
            else if (string.IsNullOrWhiteSpace(SearchText) && MailUiState.SelectedFolder is { Role: FolderRole.Inbox })
            {
                <div class="@MailCssClasses.Empty @MailCssClasses.InboxZero">
                    <div class="@MailCssClasses.InboxZeroHearts">
                        @for (int heartIndex = 0; heartIndex < InboxZeroHeartCount; heartIndex++)
                        {
                            <span class="@MailCssClasses.InboxZeroHeart" style="@InboxZeroHeartStyle(heartIndex)">💖</span>
                        }
                    </div>
                    <div class="@MailCssClasses.InboxZeroHeadline"><span class="@MailCssClasses.InboxZeroTitle">Inbox Zero</span> ✨</div>
                    <div class="@MailCssClasses.EmptyText">Nothing left to read — enjoy the quiet.</div>
                </div>
            }
            else if (string.IsNullOrWhiteSpace(SearchText) && MailUiState.SelectedFolder is { } emptyFolder)
            {
                var why = FolderEmptyReason.Explain(emptyFolder);
                <div class="@MailCssClasses.Empty">
                    <div class="@MailCssClasses.EmptyIcon">🕊️</div>
                    <div class="@MailCssClasses.EmptyText">@why.Headline</div>
                    <div class="@MailCssClasses.EmptyDetail">@why.Detail</div>
                    @if (why.Action != EmptyFolderAction.None)
                    {
                        <SecondaryButton OnClick="@(() => RunEmptyFolderAction(emptyFolder, why.Action))">@why.ActionLabel</SecondaryButton>
                    }
                </div>
            }
            else
            {
                <div class="@MailCssClasses.Empty">
                    <div class="@MailCssClasses.EmptyIcon">🕊️</div>
                    <div class="@MailCssClasses.EmptyText">@(string.IsNullOrWhiteSpace(SearchText) ? FolderEmptyReason.PlainlyEmpty : "Nothing matches your search")</div>
                    <div class="@MailCssClasses.Rescue">
                        @foreach (var rescue in SearchRescues)
                        {
                            <PillButton OnClick="() => ApplyRescue(rescue)">@rescue.Label</PillButton>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            @if (MailUiState.SelectedMessages.Count > 0)
            {
                <div class="@MailCssClasses.BulkBar">
                    <span class="@MailCssClasses.BulkCount">@MailUiState.SelectedMessages.Count selected</span>
                    <CustomizableActionBar SurfaceId="@UiSurfaceIds.BulkToolbar"
                                           PairedMenuSurfaceId="@UiSurfaceIds.MessageContextMenu"
                                           DefaultActions="@BuildBulkToolbarActions()"
                                           AddedActionResolver="@(id => ResolveToolbarAddedAction(UiSurfaceIds.BulkToolbar, id))"
                                           Wrap="true"
                                           Inline="true" />
                </div>
            }
            @if (IsSenderListView)
            {
                var senders = GetSenderItems();
                <div class="@MailCssClasses.Rows" tabindex="0">
                    @if (senders.Count == 0)
                    {
                        <div class="@MailCssClasses.Empty">
                            <div class="@MailCssClasses.EmptyIcon">👥</div>
                            <div class="@MailCssClasses.EmptyText">No senders found in this folder</div>
                        </div>
                    }
                    else
                    {
                        <Virtualize @key="@($"{MailUiState.SelectedAccount?.Id}:{MailUiState.SelectedFolder?.FullName}:{ListViewState.SenderSort}:{ListViewState.SenderSortDirection}")" Items="senders" Context="sender" ItemSize="76">
                            @{
                                bool senderOpen = MailUiState.ThirdPane == MailUiState.PaneOccupant.Person
                                    && string.Equals(MailUiState.OpenPersonAddress, sender.Address, StringComparison.OrdinalIgnoreCase);
                                bool senderUnread = sender.UnreadCount > 0;
                            }
                            <div class="@MailCssClasses.RowShell"
                                 @key="sender.Address"
                                 data-sender-row="@sender.Address"
                                 @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                                     () => MouseActionService.RunAsync(MouseActionService.CopyAction, sender.Address),
                                     () => { OpenSenderRowMenu(sender, e); return Task.CompletedTask; })"
                                 @onmouseup:stopPropagation="true"
                                 @oncontextmenu="e => OpenSenderRowMenu(sender, e)"
                                 @oncontextmenu:preventDefault="true"
                                 @oncontextmenu:stopPropagation="true">
                                <button class="@MailCssClasses.Row @(senderUnread ? MailCssClasses.RowUnread : "") @(senderOpen ? MailCssClasses.RowActive : "")"
                                        type="button"
                                        @onclick="() => OpenSenderPerson(sender)">
                                    <span class="@MailCssClasses.RowAvatar @(senderUnread ? MailCssClasses.RowAvatarUnread : "")"
                                          style="background:@AvatarGradientForAddress(sender.Address)">
                                        @AvatarInitialsForText(sender.DisplayName, sender.Address)
                                    </span>
                                    <span class="@MailCssClasses.RowDot"></span>
                                    <span class="@MailCssClasses.RowMain">
                                        <span class="@MailCssClasses.RowTop">
                                            <span class="@MailCssClasses.RowFrom">@sender.DisplayName</span>
                                            <span class="@MailCssClasses.RowThreadCount" title="@sender.MessageCount messages from this sender">
                                                @sender.MessageCount.ToString("N0")
                                            </span>
                                            <span class="@MailCssClasses.RowDate">@FormatDate(sender.LatestDateUtc)</span>
                                        </span>
                                        <span class="@MailCssClasses.RowPreview">
                                            <span>@sender.Address</span>
                                            @if (sender.UnreadCount > 0)
                                            {
                                                <span class="@MailCssClasses.TagChip" style="background:@AppColors.Primary.ToRgbaHex(true);color:@AppColors.TextOnAccent.ToRgbaHex(true)">
                                                    @sender.UnreadCount unread
                                                </span>
                                            }
                                        </span>
                                    </span>
                                </button>
                                <CustomizableActionBar SurfaceId="@UiSurfaceIds.SenderRowHover"
                                                       PairedMenuSurfaceId="@UiSurfaceIds.SenderContextMenu"
                                                       DefaultActions="@BuildSenderRowHoverActions(sender)"
                                                       AddedActionResolver="@(id => ResolveToolbarAddedAction(UiSurfaceIds.SenderRowHover, id, senderRowContext: sender))"
                                                       Compact="true"
                                                       StopClickPropagation="true"
                                                       CustomClass="@MailCssClasses.RowQuickActions" />
                            </div>
                        </Virtualize>
                    }
                </div>
            }
            else
            {
                <div class="@MailCssClasses.Rows" tabindex="0" @onkeydown="HandleListKeyDown">
                <Virtualize @key="@($"{MailUiState.SelectedAccount?.Id}:{MailUiState.SelectedFolder?.FullName}:{ListViewState.MailSort}:{ListViewState.MailSortDirection}:{ConversationMode}")" Items="Rows" Context="row" ItemSize="76">
                    @{
                        var message = row.Message;
                        bool rowUnread = row.UnreadCount > 0;
                        var targets = MessageTargets(message);
                        string payload = JsonSerializer.Serialize(targets);
                        string? rowAccountId = MessageIdentityOf(message)?.AccountId;
                    }
                    <div class="@MailCssClasses.RowShell" @key="MessageIdentityOf(message)"
                         data-mail-uid="@message.Uid"
                         @onpointerdown="e => { if (e.Button == 0) WorkspaceDragService.BeginMessagesCandidate(targets, message.Subject, e.ClientX, e.ClientY); }"
                         @oncontextmenu="e => OpenMessageMenu(targets, e.ClientX, e.ClientY, primary: MessageIdentityOf(message))"
                         @oncontextmenu:preventDefault="true"
                         @oncontextmenu:stopPropagation="true">
                    <button class="@MailCssClasses.Row @(rowUnread ? MailCssClasses.RowUnread : "") @(MailUiState.OpenMessage == message ? MailCssClasses.RowActive : "") @(MailUiState.FocusedMessage == message ? MailCssClasses.RowFocused : "") @(bloomingUids.Contains(message.Uid) ? MailCssClasses.RowBloom : "")"
                            @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                                () => MouseActionService.RunMessagesAsync(MailMessageCommand.Trash, targets),
                                () => MouseActionService.RunMessagesAsync(MailMessageCommand.Read, targets))"
                            @onmouseup:stopPropagation="true"
                            @onfocus="() => MailUiState.FocusMessage(message, MessageIdentityOf(message))"
                            @onclick="e => { if (!WorkspaceDragService.ConsumeSuppressedClick()) HandleRowClick(e, message); }">
                        <span class="@MailCssClasses.RowCheck @(IsRowSelected(message) ? MailCssClasses.RowCheckOn : "")"
                              title="Select this conversation; Shift selects a range"
                              @onpointerdown:stopPropagation="true"
                              @onclick="e => ToggleRowSelection(e, message)"
                              @onclick:stopPropagation="true">
                            @(IsRowSelected(message) ? "✓" : "○")
                        </span>
                        <span class="@MailCssClasses.RowAvatar @(rowUnread ? MailCssClasses.RowAvatarUnread : "")"
                              style="background:@AvatarGradient(message)"
                              title="@($"Sender actions for {message.FromAddress}")"
                              @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                                  () => MouseActionService.RunAsync(MouseActionService.CopyAction, message.FromAddress),
                                  () => { OpenAddressMenu(message.FromAddress, e, rowAccountId); return Task.CompletedTask; })"
                              @onmouseup:stopPropagation="true"
                              @oncontextmenu="e => OpenAddressMenu(message.FromAddress, e, rowAccountId)"
                              @oncontextmenu:preventDefault="true"
                              @oncontextmenu:stopPropagation="true">@AvatarInitials(message)</span>
                        <span class="@MailCssClasses.RowDot"></span>
                        <span class="@MailCssClasses.RowMain">
                            <span class="@MailCssClasses.RowTop">
                                <span class="@MailCssClasses.RowFrom"
                                      title="@($"Right-click for sender actions ({message.FromAddress})")"
                                      @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                                          () => MouseActionService.RunAsync(MouseActionService.CopyAction, message.FromAddress),
                                          () => { OpenAddressMenu(message.FromAddress, e, rowAccountId); return Task.CompletedTask; })"
                                      @onmouseup:stopPropagation="true"
                                      @oncontextmenu="e => OpenAddressMenu(message.FromAddress, e, rowAccountId)"
                                      @oncontextmenu:preventDefault="true"
                                      @oncontextmenu:stopPropagation="true">@row.SenderText</span>
                                @if (row.ConversationCount > 1)
                                {
                                    <span class="@MailCssClasses.RowThreadCount" title="@row.ConversationCount messages in this conversation">@row.ConversationCount</span>
                                }
                                <span class="@MailCssClasses.RowDate">@FormatDate(message.DateUtc)</span>
                            </span>
                            <span class="@MailCssClasses.RowSubject">
                                @if (message.Flags.HasFlag(MailFlags.Muted))
                                {
                                    <span class="@MailCssClasses.RowFlag @MailCssClasses.RowFlagMuted" title="Muted conversation — replies arrive quietly">🔇</span>
                                }
                                @if (message.Flags.HasFlag(MailFlags.Important))
                                {
                                    <span class="@MailCssClasses.RowFlag">❗</span>
                                }
                                @if (message.Flags.HasFlag(MailFlags.Flagged))
                                {
                                    <span class="@MailCssClasses.RowFlag">⭐</span>
                                }
                                @(string.IsNullOrWhiteSpace(message.Subject) ? "(no subject)" : message.Subject)
                            </span>
                            <span class="@MailCssClasses.RowPreview">
                                @if (OutboxStatusOf(message) is { } outboxStatus)
                                {
                                    <span class="@MailCssClasses.RowOutbox">@outboxStatus</span>
                                }
                                @if (HitFolderDisplay(message) is { } hitFolder)
                                {
                                    <span class="@MailCssClasses.RowFolder">📁 @hitFolder</span>
                                }
                                @foreach (var tag in message.Tags)
                                {
                                    <span class="@MailCssClasses.TagChip"
                                          style="background:@TagStore.ColorOf(tag);color:@AppColors.InkOn(TagStore.ColorOf(tag)).ToRgbaHex(true)"
                                          @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                                              () => MouseActionService.RunMessagesAsync(MailMessageCommand.RemoveTag, targets, tag),
                                              () => { OpenTagMenu(tag, message, e); return Task.CompletedTask; })"
                                          @onmouseup:stopPropagation="true"
                                          @oncontextmenu="e => OpenTagMenu(tag, message, e)"
                                          @oncontextmenu:preventDefault="true"
                                          @oncontextmenu:stopPropagation="true">@tag</span>
                                }
                                @if (message.HasAttachments)
                                {
                                    <span class="@MailCssClasses.RowAttach">📎</span>
                                }
                                @if (message.SnoozedUntilUtc is { } snoozedUntil)
                                {
                                    <button class="@MailCssClasses.RowSnoozed" title="Bring it back now"
                                            @onclick="() => WakeMessage(message)" @onclick:stopPropagation="true">@SnoozeLabel(snoozedUntil)</button>
                                }
                                @message.PreviewText
                            </span>
                        </span>
                    </button>
                    <CustomizableActionBar SurfaceId="@UiSurfaceIds.MailRowHover"
                                           PairedMenuSurfaceId="@UiSurfaceIds.MessageContextMenu"
                                           DefaultActions="@BuildMailRowHoverActions(message, targets)"
                                           AddedActionResolver="@(id => ResolveToolbarAddedAction(UiSurfaceIds.MailRowHover, id, messageContext: message, targetsContext: targets))"
                                           Compact="true"
                                           StopClickPropagation="true"
                                           CustomClass="@MailCssClasses.RowQuickActions" />
                    </div>
                </Virtualize>

                @if (!SearchAllFolders && TruncatedFolder is { } truncated)
                {
                    <div class="@MailCssClasses.Backfill">
                        <span class="@MailCssClasses.BackfillText">
                            Showing @CachedCount.ToString("N0") of @truncated.TotalCount.ToString("N0") here
                        </span>
                        @if (ImapSyncService.IsFolderSyncing(truncated.AccountId, truncated.FullName))
                        {
                            <CoreSpinner />
                        }
                        else
                        {
                            <button class="@MailCssClasses.BackfillButton" type="button" @onclick="() => LoadOlder(truncated)">
                                <span>⬇️ Load</span>
                                <input class="@MailCssClasses.BackfillInput"
                                       type="number"
                                       min="1"
                                       max="1000000"
                                       step="50"
                                       @bind="BackfillBatchSize"
                                       @onclick:stopPropagation="true"
                                       @onkeydown:stopPropagation="true" />
                                <span>older</span>
                            </button>
                        }
                    </div>
                }
            </div>
            }
        }
    </section>

    <ColumnSplitter Index="2"
                    IsDragging="@(activeSplitter == 2)"
                    Title="Drag to resize message list & reader (snaps within ±3% of 32.0% / 48.0% · double-click to reset)"
                    OnPointerDown="e => StartColumnSplitterDrag(2, e)"
                    OnDoubleClick="() => ResetColumnSplitter(2)" />

    <MailReaderPane View="this" />
</div>

<FloatingWindow IsOpen="@ListViewState.IsFilterWindowOpen"
                IsOpenChanged="@(open => { if (!open) ListViewState.CloseFilterWindow(); })"
                Title="🎯 Advanced Filters"
                RightPx="@ListViewState.WindowRightPx"
                TopPx="@ListViewState.WindowTopPx"
                PositionChanged="@(pos => ListViewState.SetWindowPosition(pos.Right, pos.Top))">
    <ListFilterWindow />
</FloatingWindow>

<MailCss />
