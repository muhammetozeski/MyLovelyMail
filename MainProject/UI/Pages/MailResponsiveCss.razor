@namespace MyLovelyMail.MainProject.UI.Pages
@inherits ThemedComponentBase

<style>
    @@media (max-width: @(AppMeasures.Breakpoint.TwoPane)px) {
        .@(MailCssClasses.Screen) {
            grid-template-columns: @(AppMeasures.Size.Px200)px minmax(0, 1fr);
            gap: @(AppMeasures.Space.Medium)px;
            height: @(AppMeasures.Viewport.Full)vh;
            align-items: stretch;
        }

        .@(MailCssClasses.ColumnSplitter) {
            display: none;
        }

        .@(MailCssClasses.Sidebar),
        .@(MailCssClasses.List) {
            position: static;
            height: auto;
        }

        .@(MailCssClasses.Reader) {
            display: none;
        }

        .@(MailCssClasses.ScreenPaneOpen) .@(MailCssClasses.Reader) {
            display: flex;
            position: fixed;
            inset: 0;
            z-index: @(AppMeasures.ZLayer.Overlay);
            padding: @(AppMeasures.Space.Medium)px;
            overflow-y: auto;
            min-height: 0;
            @((MarkupString)AppStyles.BuildAuroraBackground())
        }
    }

    @@media (max-width: @(AppMeasures.Breakpoint.OnePane)px) {
        .@(MailCssClasses.Screen) {
            /* minmax(0, …): a plain 1fr track grows to its widest child's min-content, so the
               horizontally scrolling account strip widened the whole phone screen past the viewport. */
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: auto minmax(0, 1fr);
        }

        .@(MailCssClasses.Sidebar) {
            overflow: visible;
        }

        .@(MailCssClasses.SidebarNav) {
            display: flex;
            align-items: center;
            gap: @(AppMeasures.Space.Px4)px;
            overflow-x: auto;
            padding-bottom: @(AppMeasures.Space.Px4)px;
        }

            .@(MailCssClasses.SidebarNav) > .@(MailCssClasses.Account),
            .@(MailCssClasses.SidebarNav) > .@(MailCssClasses.FolderRow) {
                flex: 0 0 auto;
            }

            .@(MailCssClasses.SidebarNav) .@(MailCssClasses.Folder) {
                padding-left: @(AppMeasures.Space.Px8)px;
                white-space: nowrap;
            }

            .@(MailCssClasses.SidebarNav) .@(MailCssClasses.FolderAction) {
                display: none;
            }

            .@(MailCssClasses.SidebarNav) .@(MailCssClasses.FolderRow):has(.@(MailCssClasses.FolderActive)) .@(MailCssClasses.FolderAction) {
                display: inline-block;
                opacity: @(AppMeasures.Opacity.Muted);
            }
    }
</style>
