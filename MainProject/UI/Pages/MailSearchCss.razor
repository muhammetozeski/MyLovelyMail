@namespace MyLovelyMail.MainProject.UI.Pages
@inherits ThemedComponentBase

<style>
    .mail-main {
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px12)px;
        overflow-y: auto;
        box-sizing: border-box;
    }

    /* Compact two-row top bar without huge vertical gaps or multi-line button towers (7.png & 8.png fix). */
    .mail-search-bar {
        margin-bottom: @(AppMeasures.Space.Px8)px;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .mail-search-row {
        display: flex;
        gap: @(AppMeasures.Space.Px6)px;
        align-items: center;
    }

    .mail-search-input {
        flex: 1;
        min-width: 0;
    }

    .mail-selection-tools {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
        flex-wrap: wrap;
    }

    .mail-search-scope, .mail-select-mode {
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Medium);
        white-space: nowrap;
        cursor: pointer;
        transition: all @(AppMeasures.Duration.Fast)s ease;
    }

    .mail-select-mode--icon {
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: 1.2;
    }

        .mail-select-mode:hover:not(:disabled),
        .mail-search-scope:hover {
            border-color: @AppColors.Primary.ToRgbaHex(true);
            color: @AppColors.Primary.ToRgbaHex(true);
        }

        .mail-select-mode:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

    .mail-search-scope--on, .mail-select-mode--on {
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        border-color: @AppColors.Primary.ToRgbaHex(true);
        color: @AppColors.Primary.ToRgbaHex(true);
        font-weight: @(AppMeasures.Weight.Bold);
    }

    .mail-filter-bar {
        display: flex;
        gap: @(AppMeasures.Space.Px4)px;
        flex-wrap: wrap;
        align-items: center;
    }

    .mail-filter-chip {
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.XSmall)px;
        cursor: pointer;
        transition: all @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-filter-chip:hover {
            background: @AppColors.SurfaceNormal.ToRgbaHex(true);
            color: @AppColors.TextPrimary.ToRgbaHex(true);
        }

    .mail-filter-chip--on {
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        border-color: @AppColors.Primary.ToRgbaHex(true);
        color: @AppColors.Primary.ToRgbaHex(true);
        font-weight: @(AppMeasures.Weight.Bold);
    }

    .mail-filter-chip--save {
        border-style: dashed;
        color: @AppColors.Primary.ToRgbaHex(true);
    }

    .mail-saved-search {
        display: inline-flex;
        align-items: center;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.XSmall)px;
        overflow: hidden;
    }

    .mail-saved-search--on {
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        border-color: @AppColors.Primary.ToRgbaHex(true);
    }

    .mail-saved-search-run {
        border: none;
        background: transparent;
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px8)px;
        cursor: pointer;
        font-size: @(AppMeasures.Font.XSmall)px;
    }

    .mail-saved-search-del {
        border: none;
        background: transparent;
        color: @AppColors.TextMuted.ToRgbaHex(true);
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px6)px;
        cursor: pointer;
        font-size: @(AppMeasures.Font.XSmall)px;
    }

    .mail-folder-badge {
        display: inline-block;
        margin-left: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px1)px @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Small)px;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @AppColors.TextMuted.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Tiny)px;
        font-weight: @(AppMeasures.Weight.Normal);
    }

    .mail-bulk-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px10)px;
        margin-bottom: @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        border: @(AppMeasures.Border.Thin)px solid @AppColors.Primary.ToRgbaHex(true);
    }

    .mail-bulk-count {
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @AppColors.Primary.ToRgbaHex(true);
    }

    .mail-bulk-actions {
        display: flex;
        gap: @(AppMeasures.Space.Px4)px;
        flex-wrap: wrap;
        align-items: center;
    }

    .mail-row-check {
        width: @(AppMeasures.Size.Px16)px;
        height: @(AppMeasures.Size.Px16)px;
        accent-color: @AppColors.Primary.ToRgbaHex(true);
        cursor: pointer;
        flex-shrink: 0;
    }

    .mail-row--checked {
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true) !important;
    }
</style>
