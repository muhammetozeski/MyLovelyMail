@namespace MyLovelyMail.MainProject.UI.Pages
@inherits ThemedComponentBase

@{
    string textPrimary = AppColors.TextPrimary.ToRgbaHex(true);
    string textSecondary = AppColors.TextSecondary.ToRgbaHex(true);
    string textMuted = AppColors.TextMuted.ToRgbaHex(true);
    string primary = AppColors.Primary.ToRgbaHex(true);
    string surfaceTint = AppColors.SurfaceTintPrimary.ToRgbaHex(true);
    string glassBorder = AppColors.GlassBorderDefault.ToRgbaHex(true);
}

<style>
    .@(MailCssClasses.RuleTrace) {
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: transparent;
        cursor: pointer;
        margin-left: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        color: @textMuted;
        font-size: @(AppMeasures.Font.XSmall)px;
    }

        .@(MailCssClasses.RuleTrace):hover {
            background: @surfaceTint;
            color: @textPrimary;
        }

    .@(MailCssClasses.RuleStrip) {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px4)px;
        margin-top: @(AppMeasures.Space.Px4)px;
    }

    .@(MailCssClasses.RuleSummary),
    .@(MailCssClasses.RuleRow) {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        margin-left: 0;
        max-width: @(AppMeasures.Percent.Full)%;
    }

    .@(MailCssClasses.RuleLead) {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(MailCssClasses.RuleName) {
        opacity: @AppMeasures.Opacity.Muted;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(MailCssClasses.RuleCount) {
        padding: 0 @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: @surfaceTint;
        color: @textPrimary;
        font-variant-numeric: tabular-nums;
    }

    .@(MailCssClasses.RuleCaret) {
        opacity: @AppMeasures.Opacity.Muted;
    }

    .@(MailCssClasses.RuleRows) {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px4)px;
        padding-left: @(AppMeasures.Space.Px12)px;
    }

    .@(MailCssClasses.AuthChip) {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
        margin-left: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: @AppColors.Warning.ToRgbaHex(true);
        color: @AppColors.TextOnWarning.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Medium);
    }

    .@(MailCssClasses.RowFlagMuted) {
        opacity: @(AppMeasures.Opacity.Muted);
    }

    .@(MailCssClasses.ReaderThread) {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
        padding: @(AppMeasures.Space.Px8)px 0;
        border-bottom: @(AppMeasures.Border.Thin)px solid @glassBorder;
    }

    .@(MailCssClasses.ReaderThreadNav) {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        padding-bottom: @(AppMeasures.Space.Px4)px;
    }

    .@(MailCssClasses.ReaderThreadCount) {
        color: @textMuted;
        font-size: @(AppMeasures.Font.Small)px;
    }

    .@(MailCssClasses.ThreadStep) {
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: transparent;
        cursor: pointer;
        color: var(--account-accent, @primary);
        padding: 0 @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Small)px;
        font-size: @(AppMeasures.Font.Small)px;
    }

        .@(MailCssClasses.ThreadStep):disabled {
            opacity: @(AppMeasures.Opacity.Disabled);
            cursor: not-allowed;
        }

    .@(MailCssClasses.ThreadLine) {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        border: none;
        background: transparent;
        cursor: pointer;
        text-align: left;
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Small)px;
        color: @textSecondary;
        font-size: @(AppMeasures.Font.Small)px;
    }

        .@(MailCssClasses.ThreadLine):hover {
            background: @surfaceTint;
        }

    .@(MailCssClasses.ThreadLineOpen) {
        background: @surfaceTint;
        color: @textPrimary;
        font-weight: @(AppMeasures.Weight.Medium);
    }

    .@(MailCssClasses.ThreadLineDate) {
        flex-shrink: 0;
        color: @textMuted;
    }

    .@(MailCssClasses.ThreadLineSender) {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(MailCssClasses.ThreadLineUnread) {
        flex-shrink: 0;
        width: @(AppMeasures.Size.Px8)px;
        height: @(AppMeasures.Size.Px8)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        background: var(--account-accent, @primary);
    }

    .@(MailCssClasses.Backfill) {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: @(AppMeasures.Space.Px8)px;
        padding: @(AppMeasures.Space.Px12)px @(AppMeasures.Space.Px8)px;
    }

    .@(MailCssClasses.BackfillText) {
        color: @textMuted;
        font-size: @(AppMeasures.Font.XSmall)px;
    }

    .@(MailCssClasses.BackfillButton) {
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: transparent;
        cursor: pointer;
        color: var(--account-accent, @primary);
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Medium);
        transition: background @(AppMeasures.Duration.Fast)s ease;
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
    }

        .@(MailCssClasses.BackfillButton):hover {
            background: @surfaceTint;
        }

    .@(MailCssClasses.BackfillInput) {
        width: @(AppMeasures.Size.Px60)px;
        background: @surfaceTint;
        color: var(--account-accent, @primary);
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        border-radius: @(AppMeasures.Radius.Small)px;
        padding: @(AppMeasures.Space.Px1)px @(AppMeasures.Space.Px4)px;
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Bold);
        text-align: center;
        outline: none;
    }

    .@(MailCssClasses.RowThreadCount) {
        flex-shrink: 0;
        padding: 0 @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: var(--account-accent, @primary);
        color: var(--account-ink, @AppColors.TextOnAccent.ToRgbaHex(true));
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Bold);
    }

    .@(MailCssClasses.Source) {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px12)px;
        width: @(AppMeasures.Percent.Full)%;
        max-width: @(AppMeasures.Percent.Full)%;
        text-align: left;
    }

    .@(MailCssClasses.SourceTabs) {
        display: flex;
        gap: @(AppMeasures.Space.Px6)px;
        flex-wrap: wrap;
    }

    .@(MailCssClasses.SourceHeaders) {
        display: grid;
        grid-template-columns: minmax(@(AppMeasures.Size.Px140)px, auto) 1fr;
        gap: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px16)px;
        padding: @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: @AppColors.SurfaceDarken.ToRgbaHex(true);
        max-height: @(AppMeasures.Viewport.ThreeQuarters)vh;
        overflow: auto;
        font-size: @(AppMeasures.Font.Small)px;
        text-align: left;
    }

    .@(MailCssClasses.SourceHeaderName) {
        font-weight: @(AppMeasures.Weight.Bold);
        color: @textSecondary;
        white-space: nowrap;
    }

    .@(MailCssClasses.SourceHeaderValue) {
        color: @AppColors.TextPrimary.ToRgbaHex(true);
        word-break: break-all;
    }

    .@(MailCssClasses.SourceRaw) {
        margin: 0;
        overflow: auto;
        max-height: @(AppMeasures.Viewport.ThreeQuarters)vh;
        padding: @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: @AppColors.SurfaceDarken.ToRgbaHex(true);
        font-family: Consolas, monospace;
        font-size: @(AppMeasures.Font.Small)px;
        white-space: pre-wrap;
        word-break: break-all;
        text-align: left;
    }

    .@(MailCssClasses.InboxZero) {
        position: relative;
        overflow: hidden;
    }

    .@(MailCssClasses.InboxZeroHearts) {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .@(MailCssClasses.InboxZeroHeart) {
        position: absolute;
        bottom: -@(AppMeasures.Space.Px32)px;
        opacity: 0;
        animation: inbox-zero-drift @(AppMeasures.Duration.Drift)s linear infinite;
    }

    @@keyframes inbox-zero-drift {
        0% { transform: translateY(0) scale(0.8); opacity: 0; }
        15% { opacity: @(AppMeasures.Opacity.Muted); }
        85% { opacity: @(AppMeasures.Opacity.Muted); }
        100% { transform: translateY(-@(AppMeasures.Size.Px300)px) scale(1.1); opacity: 0; }
    }

    .@(MailCssClasses.InboxZeroHeadline) {
        position: relative;
        font-size: @(AppMeasures.Font.Hero)px;
        font-weight: @(AppMeasures.Weight.Bold);
    }

    .@(MailCssClasses.InboxZeroTitle) {
        background: linear-gradient(135deg, var(--account-accent, @primary), @AppColors.Accent.ToRgbaHex(true));
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .@(MailCssClasses.EmptyIcon) {
        font-size: @(AppMeasures.Font.Mega)px;
        opacity: @(AppMeasures.Opacity.Soft);
    }

    .@(MailCssClasses.EmptyText) {
        font-size: @(AppMeasures.Font.Normal)px;
    }

    .@(MailCssClasses.EmptyDetail) {
        font-size: @(AppMeasures.Font.Small)px;
        opacity: @(AppMeasures.Opacity.Soft);
        max-width: @(AppMeasures.Size.Px360)px;
        text-align: center;
        line-height: @(AppMeasures.LineHeight.Normal);
        word-break: break-word;
    }
</style>
