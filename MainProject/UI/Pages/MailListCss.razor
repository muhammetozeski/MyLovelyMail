@namespace MyLovelyMail.MainProject.UI.Pages
@inherits ThemedComponentBase
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings

@{
    // Row metrics follow the density setting: Cozy = roomy + 2 preview lines, Compact = tight single line.
    (int rowPaddingY, int previewLines, int rowGap) = GlobalSettings.MessageListDensity.Value switch
    {
        "Cozy" => (AppMeasures.Space.Px14, 2, AppMeasures.Space.Px8),
        "Compact" => (AppMeasures.Space.Px4, 0, AppMeasures.Space.Px2),
        _ => (AppMeasures.Space.Px10, 1, AppMeasures.Space.Px6)
    };
    string textPrimary = AppColors.TextPrimary.ToRgbaHex(true);
    string textSecondary = AppColors.TextSecondary.ToRgbaHex(true);
    string textMuted = AppColors.TextMuted.ToRgbaHex(true);
    string primary = AppColors.Primary.ToRgbaHex(true);
    string surfaceTint = AppColors.SurfaceTintPrimary.ToRgbaHex(true);
    string glassBorder = AppColors.GlassBorderDefault.ToRgbaHex(true);
    string paneHeight = $"calc({AppMeasures.Viewport.Full}vh - {AppMeasures.Space.Px90 + AppMeasures.Space.Medium * 2}px)";
}

<style>
    .mail-selection-tools { display: flex; flex-wrap: wrap; gap: @(AppMeasures.Space.Px6)px; }
    .mail-row-shell { position: relative; }
    .mail-row-quick-actions {
        position: absolute;
        right: @(AppMeasures.Space.Px6)px;
        bottom: @(AppMeasures.Space.Px4)px;
        display: flex;
        gap: @(AppMeasures.Space.Px4)px;
        justify-content: flex-end;
        padding: 0;
    }
    .mail-row-shell .mail-row-subject, .mail-row-shell .mail-row-preview { padding-right: @(AppMeasures.Size.Px100)px; }
    .mail-row-quick-actions button {
        border: 0;
        border-radius: @(AppMeasures.Radius.Small)px;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @textPrimary;
        cursor: pointer;
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.Small)px;
    }
    .mail-row-quick-actions button:hover, .mail-row-quick-actions button:focus-visible { background: @surfaceTint; }
    /* ---- Message list ---- */

    .mail-list {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px8)px;
        min-height: 0;
        /* Pinned beside the growing reader, exactly like the sidebar. */
        position: sticky;
        top: @(AppMeasures.Space.Medium)px;
        height: @paneHeight;
    }

    .mail-rows {
        overflow-y: auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: @(rowGap)px;
        padding-right: @(AppMeasures.Space.Px2)px;
    }

    .mail-row {
        display: flex;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px8)px;
        width: @(AppMeasures.Percent.Full)%;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        cursor: pointer;
        text-align: left;
        padding: @(rowPaddingY)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        color: @textPrimary;
        transition: all @(AppMeasures.Duration.Fast)s ease;
        box-sizing: border-box;
    }

        .mail-row:hover {
            background: @surfaceTint;
            transform: translateY(-@(AppMeasures.Size.Px1)px);
        }

    .mail-row--active {
        background: @surfaceTint;
        border-color: var(--account-accent, @primary);
    }

    /* Keyboard-focused row: a soft accent outline distinct from the opened (active) row. */
    .mail-row--focused {
        outline: @(AppMeasures.Border.Medium)px solid @AppColors.Accent.ToRgbaHex(true);
        outline-offset: -@(AppMeasures.Border.Medium)px;
    }

    /* The app-state ring (.mail-row--focused) tracks MailUiState.FocusedMessage, which stays lit
       while the keyboard is somewhere else entirely. These rules follow real DOM focus, and only
       for keyboard focus, so clicking does not light everything up. */
    .mail-rows:focus-visible,
    .mail-account:focus-visible,
    .mail-folder:focus-visible,
    .mail-folder-action:focus-visible,
    .mail-search-toggle:focus-visible,
    .mail-row:focus-visible,
    .mail-move-option:focus-visible,
    .mail-attachment-chip:focus-visible,
    .mail-tag-chip:focus-visible,
    .mail-backfill-button:focus-visible,
    .mail-saved-run:focus-visible,
    .mail-saved-remove:focus-visible {
        outline: @(AppMeasures.Border.Medium)px solid @AppColors.Accent.ToRgbaHex(true);
        outline-offset: @(AppMeasures.Border.Thin)px;
    }

    .mail-rows:focus:not(:focus-visible) {
        outline: none;
    }

    .mail-shortcuts {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px8)px;
        text-align: left;
    }

    .mail-shortcuts-title {
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        margin-bottom: @(AppMeasures.Space.Px8)px;
        text-align: center;
    }

    .mail-shortcuts-row {
        display: flex;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px16)px;
    }

    .mail-shortcuts-keys {
        font-weight: @(AppMeasures.Weight.Heavy);
        color: @primary;
        min-width: @(AppMeasures.Size.Px80)px;
    }

    .mail-shortcuts-action {
        color: @textSecondary;
    }

    .mail-bulk-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        border: @(AppMeasures.Border.Thin)px solid var(--account-accent, @primary);
        background: @surfaceTint;
    }

    /* Move popover anchors to its wrapper span so it opens right under the Move button. */
    .mail-bulk-move {
        position: relative;
    }

    .mail-move-popover {
        position: absolute;
        top: @(AppMeasures.Percent.Full)%;
        left: 0;
        margin-top: @(AppMeasures.Space.Px4)px;
        z-index: @(AppMeasures.ZLayer.Popover);
        display: flex;
        flex-direction: column;
        min-width: @(AppMeasures.Size.Px200)px;
        max-height: @(AppMeasures.Size.Px300)px;
        overflow-y: auto;
        padding: @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        background: @AppColors.SurfaceStrong.ToRgbaHex(true);
        box-shadow: @AppStyles.ShadowMedium;
    }

    .mail-move-divider {
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px2)px;
        margin-top: @(AppMeasures.Space.Px4)px;
        border-top: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @AppColors.TextMuted.ToRgbaHex(true);
    }

    .mail-move-option {
        border: none;
        background: transparent;
        color: @AppColors.TextPrimary.ToRgbaHex(true);
        text-align: left;
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Small)px;
        cursor: pointer;
        font-size: @(AppMeasures.Font.Small)px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .mail-move-option:hover {
            background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        }

    .mail-bulk-count {
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        color: var(--account-accent, @primary);
        margin-right: @(AppMeasures.Space.Px4)px;
    }

    .mail-row-check {
        font-size: @(AppMeasures.Font.Medium)px;
        color: @textMuted;
        flex-shrink: 0;
        cursor: pointer;
        line-height: @(AppMeasures.LineHeight.None);
    }

        .mail-row-check:hover {
            color: @textPrimary;
        }

    .mail-row-check--on {
        color: var(--account-accent, @primary);
    }

    /* Reader twin of the row avatar, one size up since it identifies the message being read. */
    .mail-reader-avatar {
        width: @(AppMeasures.Size.Px44)px;
        height: @(AppMeasures.Size.Px44)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: @AppColors.TextOnFilledSurface.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Medium)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        flex-shrink: 0;
        box-shadow: @AppStyles.ShadowSoft;
    }

    .mail-row-snoozed {
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @surfaceTint;
        color: @textSecondary;
        border-radius: @(AppMeasures.Radius.Pill)px;
        padding: 0 @(AppMeasures.Space.Px6)px;
        margin-right: @(AppMeasures.Space.Px4)px;
        font-size: @(AppMeasures.Font.XSmall)px;
        cursor: pointer;
        white-space: nowrap;
    }

    .mail-unsubscribe {
        display: flex;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px6)px;
        margin-top: @(AppMeasures.Space.Px4)px;
    }

    .mail-unsubscribe-chip {
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: transparent;
        color: @textSecondary;
        font-size: @(AppMeasures.Font.XSmall)px;
        cursor: pointer;
        white-space: nowrap;
    }

        .mail-unsubscribe-chip:hover {
            color: @AppColors.TextDanger.ToRgbaHex(true);
            border-color: @AppColors.TextDanger.ToRgbaHex(true);
        }

        /* Not a button: it says why the action is absent, so it must not look pressable.
           After the base rule and the hover rule on purpose — same specificity, so order decides
           which cursor and which colour win. */
        .mail-unsubscribe-chip--blocked,
        .mail-unsubscribe-chip--blocked:hover {
            cursor: default;
            opacity: @(AppMeasures.Opacity.Soft);
            display: inline-block;
            color: @textSecondary;
            border-color: @glassBorder;
        }

    .mail-reader-history {
        align-self: flex-start;
        margin-top: @(AppMeasures.Space.Px4)px;
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @surfaceTint;
        color: @textSecondary;
        font-size: @(AppMeasures.Font.XSmall)px;
        cursor: pointer;
        white-space: nowrap;
    }

        .mail-reader-history:hover {
            color: @AppColors.TextPrimary.ToRgbaHex(true);
            border-color: var(--account-accent, @primary);
        }

    .mail-row-avatar {
        width: @(GlobalSettings.MessageListDensity.Value == "Compact" ? AppMeasures.Size.Px24 : AppMeasures.Size.Px32)px;
        height: @(GlobalSettings.MessageListDensity.Value == "Compact" ? AppMeasures.Size.Px24 : AppMeasures.Size.Px32)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: @AppColors.TextOnFilledSurface.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        flex-shrink: 0;
        box-shadow: @AppStyles.ShadowSoft;
    }

    /* Unread: an accent ring around the avatar reinforces the dot without shouting. */
    .mail-row-avatar--unread {
        outline: @(AppMeasures.Border.Medium)px solid var(--account-accent, @primary);
        outline-offset: @(AppMeasures.Border.Thin)px;
    }

    .mail-row-dot {
        width: @(AppMeasures.Size.Px5)px;
        height: @(AppMeasures.Size.Px5)px;
        margin-top: @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        flex-shrink: 0;
        background: transparent;
    }

    .mail-row--unread .mail-row-dot {
        background: var(--account-accent, @primary);
    }

    /* One-shot arrival bloom: the row unfolds from slightly small with a petal-like accent glow. */
    .mail-row--bloom {
        animation: mail-bloom @(AppMeasures.Duration.Slow)s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes mail-bloom {
        0% {
            transform: scale(0.92);
            opacity: 0;
            box-shadow: 0 0 0 0 var(--account-accent, @primary);
        }

        45% {
            transform: scale(1.02);
            opacity: 1;
            box-shadow: 0 0 @(AppMeasures.Space.Px24)px @(AppMeasures.Space.Px2)px @AppColors.Primary.WithAlpha(0.35f).ToRgbaHex(true);
        }

        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 transparent;
        }
    }

    .mail-row--unread .mail-row-from,
    .mail-row--unread .mail-row-subject {
        font-weight: @(AppMeasures.Weight.Heavy);
    }

    .mail-row-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
    }

    .mail-row-top {
        display: flex;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .mail-row-from {
        font-size: @(AppMeasures.Font.Normal)px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-row-date {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textMuted;
        flex-shrink: 0;
    }

    .mail-row-subject {
        font-size: @(AppMeasures.Font.Normal)px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-row-flag {
        margin-right: @(AppMeasures.Space.Px4)px;
    }

    .mail-row-preview {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textMuted;
        overflow: hidden;
        @if (previewLines == 0)
        {
            @("display: none;")
        }
        else if (previewLines == 1)
        {
            @("text-overflow: ellipsis; white-space: nowrap;")
        }
        else
        {
            @($"display: -webkit-box; -webkit-line-clamp: {previewLines}; -webkit-box-orient: vertical; white-space: normal;")
        }
    }

    .mail-row-attach {
        margin-right: @(AppMeasures.Space.Px4)px;
    }

</style>
