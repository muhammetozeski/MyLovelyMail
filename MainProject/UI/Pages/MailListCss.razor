@namespace MyLovelyMail.MainProject.UI.Pages
@inherits ThemedComponentBase
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings

@{
    (int rowPaddingY, int previewLines, int rowGap) = GlobalSettings.MessageListDensity.Value switch
    {
        "Cozy" => (AppMeasures.Space.Px14, 2, AppMeasures.Space.Px8),
        "Compact" => (AppMeasures.Space.Px4, 0, AppMeasures.Space.Px2),
        _ => (AppMeasures.Space.Px10, 1, AppMeasures.Space.Px6)
    };
    string textPrimary = AppColors.TextPrimary.ToRgbaHex(true);
    string textSecondary = AppColors.TextSecondary.ToRgbaHex(true);
    string textMuted = AppColors.TextMuted.ToRgbaHex(true);
    string primary = AppColors.Primary.ToRgbaHex(true);
    string surfaceTint = AppColors.SurfaceTintPrimary.ToRgbaHex(true);
    string glassBorder = AppColors.GlassBorderDefault.ToRgbaHex(true);
    string paneHeight = AppStyles.MailPaneHeight;
}

<style>
    .@(MailCssClasses.RowShell) {
        position: relative;
    }

    .@(MailCssClasses.RowQuickActions),
    .@(MailCssClasses.RowQuickActions).@(MyLovelyMail.MainProject.UI.Elements.Buttons.ActionBarCssClasses.Bar) {
        position: absolute;
        right: @(AppMeasures.Space.Px6)px;
        bottom: @(AppMeasures.Space.Px4)px;
        display: none;
        gap: @(AppMeasures.Space.Px4)px;
        justify-content: flex-end;
        padding: 0;
        z-index: @(AppMeasures.ZLayer.Raised);
    }

    .@(MailCssClasses.RowShell):hover .@(MailCssClasses.RowQuickActions),
    .@(MailCssClasses.RowShell):focus-within .@(MailCssClasses.RowQuickActions),
    .@(MailCssClasses.RowQuickActions).@(MyLovelyMail.MainProject.UI.Elements.Buttons.ActionBarCssClasses.BarDropReady) {
        display: flex;
    }

    .@(MailCssClasses.RowShell):hover .@(MailCssClasses.RowDate),
    .@(MailCssClasses.RowShell):hover .@(MailCssClasses.RowThreadCount) {
        opacity: 0;
        pointer-events: none;
    }

    .@(MailCssClasses.RowShell) .@(MailCssClasses.RowSubject),
    .@(MailCssClasses.RowShell) .@(MailCssClasses.RowPreview) {
        padding-right: @(AppMeasures.Size.Px100)px;
    }

    .@(MailCssClasses.RowQuickActions) button,
    .@(MailCssClasses.RowQuickBtn) {
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        border-radius: @(AppMeasures.Radius.Small)px;
        background: @AppColors.SurfaceStrong.ToRgbaHex(true);
        color: @textPrimary;
        cursor: pointer;
        padding: @(AppMeasures.Space.Px3)px @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.Small)px;
    }

    .@(MailCssClasses.RowQuickActions) button:hover,
    .@(MailCssClasses.RowQuickActions) button:focus-visible,
    .@(MailCssClasses.RowQuickBtn):hover {
        background: @surfaceTint;
    }

    .@(MailCssClasses.RowQuickBtnDanger):hover {
        color: @AppColors.TextDanger.ToRgbaHex(true);
        border-color: @AppColors.TextDanger.ToRgbaHex(true);
    }

    /* ---- Message list ---- */

    .@(MailCssClasses.List) {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px8)px;
        min-height: 0;
        position: sticky;
        top: @(AppMeasures.Space.Medium)px;
        height: @paneHeight;
    }

    .@(MailCssClasses.Rows) {
        overflow-y: auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: @(rowGap)px;
        padding-right: @(AppMeasures.Space.Px2)px;
    }

    .@(MailCssClasses.Row) {
        display: flex;
        align-items: flex-start;
        gap: @(AppMeasures.Space.Px8)px;
        width: @(AppMeasures.Percent.Full)%;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        cursor: pointer;
        text-align: left;
        padding: @(rowPaddingY)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        color: @textPrimary;
        transition: all @(AppMeasures.Duration.Fast)s ease;
        box-sizing: border-box;
    }

        .@(MailCssClasses.Row):hover {
            background: @surfaceTint;
            transform: translateY(-@(AppMeasures.Size.Px1)px);
        }

    .@(MailCssClasses.RowActive) {
        background: @surfaceTint;
        border-color: var(--account-accent, @primary);
    }

    .@(MailCssClasses.RowFocused) {
        outline: @(AppMeasures.Border.Medium)px solid @AppColors.Accent.ToRgbaHex(true);
        outline-offset: -@(AppMeasures.Border.Medium)px;
    }

    .@(MailCssClasses.Rows):focus,
    .@(MailCssClasses.Rows):focus-visible {
        outline: none;
    }

    .@(MailCssClasses.Account):focus-visible,
    .@(MailCssClasses.Folder):focus-visible,
    .@(MailCssClasses.FolderAction):focus-visible,
    .@(MailCssClasses.SearchToggle):focus-visible,
    .@(MailCssClasses.Row):focus-visible,
    .@(MailCssClasses.MoveOption):focus-visible,
    .@(MailCssClasses.AttachmentChip):focus-visible,
    .@(MailCssClasses.TagChip):focus-visible,
    .@(MailCssClasses.BackfillButton):focus-visible,
    .@(MailCssClasses.SavedRun):focus-visible,
    .@(MailCssClasses.SavedRemove):focus-visible {
        outline: @(AppMeasures.Border.Medium)px solid @AppColors.Accent.ToRgbaHex(true);
        outline-offset: @(AppMeasures.Border.Thin)px;
    }

    .@(MailCssClasses.Shortcuts) {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px8)px;
        text-align: left;
    }

    .@(MailCssClasses.ShortcutsTitle) {
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        margin-bottom: @(AppMeasures.Space.Px8)px;
        text-align: center;
    }

    .@(MailCssClasses.ShortcutsRow) {
        display: flex;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px16)px;
    }

    .@(MailCssClasses.ShortcutsKeys) {
        font-weight: @(AppMeasures.Weight.Heavy);
        color: @primary;
        min-width: @(AppMeasures.Size.Px80)px;
    }

    .@(MailCssClasses.ShortcutsAction) {
        color: @textSecondary;
    }

    .@(MailCssClasses.ShortcutGrid) {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px12)px;
        font-size: @(AppMeasures.Font.Small)px;
        align-items: center;
    }

    .@(MailCssClasses.ModalSectionTitle) {
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @textMuted;
        margin-bottom: @(AppMeasures.Space.Px6)px;
        text-transform: uppercase;
        letter-spacing: @(AppMeasures.Tracking.Normal)px;
    }

    .@(MailCssClasses.SnoozeWhen) {
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @textMuted;
    }

    .@(MailCssClasses.BulkBar) {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        border: @(AppMeasures.Border.Thin)px solid var(--account-accent, @primary);
        background: @surfaceTint;
    }

    .@(MailCssClasses.BulkMove) {
        position: relative;
    }

    .@(MailCssClasses.MovePopover) {
        position: absolute;
        top: @(AppMeasures.Percent.Full)%;
        left: 0;
        margin-top: @(AppMeasures.Space.Px4)px;
        z-index: @(AppMeasures.ZLayer.Popover);
        display: flex;
        flex-direction: column;
        min-width: @(AppMeasures.Size.Px200)px;
        max-height: @(AppMeasures.Size.Px300)px;
        overflow-y: auto;
        padding: @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        background: @AppColors.SurfaceStrong.ToRgbaHex(true);
        box-shadow: @AppStyles.ShadowMedium;
    }

    .@(MailCssClasses.MoveDivider) {
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px2)px;
        margin-top: @(AppMeasures.Space.Px4)px;
        border-top: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @AppColors.TextMuted.ToRgbaHex(true);
    }

    .@(MailCssClasses.MoveOption) {
        border: none;
        background: transparent;
        color: @AppColors.TextPrimary.ToRgbaHex(true);
        text-align: left;
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Small)px;
        cursor: pointer;
        font-size: @(AppMeasures.Font.Small)px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .@(MailCssClasses.MoveOption):hover {
            background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        }

    .@(MailCssClasses.MoveFilter) {
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @textPrimary;
        border-radius: @(AppMeasures.Radius.Small)px;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px10)px;
        font-size: @(AppMeasures.Font.Small)px;
        outline: none;
    }

    .@(MailCssClasses.BulkCount) {
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        color: var(--account-accent, @primary);
        margin-right: @(AppMeasures.Space.Px4)px;
    }

    .@(MailCssClasses.RowCheck) {
        font-size: @(AppMeasures.Font.Medium)px;
        color: @textMuted;
        flex-shrink: 0;
        cursor: pointer;
        line-height: @(AppMeasures.LineHeight.None);
    }

        .@(MailCssClasses.RowCheck):hover {
            color: @textPrimary;
        }

    .@(MailCssClasses.RowCheckOn) {
        color: var(--account-accent, @primary);
    }

    .@(MailCssClasses.ReaderAvatar) {
        width: @(AppMeasures.Size.Px44)px;
        height: @(AppMeasures.Size.Px44)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: @AppColors.TextOnFilledSurface.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Medium)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        flex-shrink: 0;
        box-shadow: @AppStyles.ShadowSoft;
        cursor: context-menu;
    }

    .@(MailCssClasses.RowSnoozed) {
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @surfaceTint;
        color: @textSecondary;
        border-radius: @(AppMeasures.Radius.Pill)px;
        padding: 0 @(AppMeasures.Space.Px6)px;
        margin-right: @(AppMeasures.Space.Px4)px;
        font-size: @(AppMeasures.Font.XSmall)px;
        cursor: pointer;
        white-space: nowrap;
    }

    .@(MailCssClasses.Unsubscribe) {
        display: flex;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px6)px;
        margin-top: @(AppMeasures.Space.Px4)px;
    }

    .@(MailCssClasses.UnsubscribeChip) {
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: transparent;
        color: @textSecondary;
        font-size: @(AppMeasures.Font.XSmall)px;
        cursor: pointer;
        white-space: nowrap;
    }

        .@(MailCssClasses.UnsubscribeChip):hover {
            color: @AppColors.TextDanger.ToRgbaHex(true);
            border-color: @AppColors.TextDanger.ToRgbaHex(true);
        }

        .@(MailCssClasses.UnsubscribeChipBlocked),
        .@(MailCssClasses.UnsubscribeChipBlocked):hover {
            cursor: default;
            opacity: @(AppMeasures.Opacity.Soft);
            display: inline-block;
            color: @textSecondary;
            border-color: @glassBorder;
        }

    .@(MailCssClasses.ReaderHistory) {
        align-self: flex-start;
        margin-top: @(AppMeasures.Space.Px4)px;
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @surfaceTint;
        color: @textSecondary;
        font-size: @(AppMeasures.Font.XSmall)px;
        cursor: pointer;
        white-space: nowrap;
    }

        .@(MailCssClasses.ReaderHistory):hover {
            color: @AppColors.TextPrimary.ToRgbaHex(true);
            border-color: var(--account-accent, @primary);
        }

    .@(MailCssClasses.RowAvatar) {
        width: @(GlobalSettings.MessageListDensity.Value == "Compact" ? AppMeasures.Size.Px24 : AppMeasures.Size.Px32)px;
        height: @(GlobalSettings.MessageListDensity.Value == "Compact" ? AppMeasures.Size.Px24 : AppMeasures.Size.Px32)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: @AppColors.TextOnFilledSurface.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Heavy);
        flex-shrink: 0;
        box-shadow: @AppStyles.ShadowSoft;
    }

    .@(MailCssClasses.RowAvatarUnread) {
        outline: @(AppMeasures.Border.Medium)px solid var(--account-accent, @primary);
        outline-offset: @(AppMeasures.Border.Thin)px;
    }

    .@(MailCssClasses.RowDot) {
        width: @(AppMeasures.Size.Px5)px;
        height: @(AppMeasures.Size.Px5)px;
        margin-top: @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Circular)%;
        flex-shrink: 0;
        background: transparent;
    }

    .@(MailCssClasses.RowUnread) .@(MailCssClasses.RowDot) {
        background: var(--account-accent, @primary);
    }

    .@(MailCssClasses.RowBloom) {
        animation: mail-bloom @(AppMeasures.Duration.Slow)s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes mail-bloom {
        0% {
            transform: scale(0.92);
            opacity: 0;
            box-shadow: 0 0 0 0 var(--account-accent, @primary);
        }

        45% {
            transform: scale(1.02);
            opacity: 1;
            box-shadow: 0 0 @(AppMeasures.Space.Px24)px @(AppMeasures.Space.Px2)px @AppColors.Primary.WithAlpha(0.35f).ToRgbaHex(true);
        }

        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 transparent;
        }
    }

    .@(MailCssClasses.RowUnread) .@(MailCssClasses.RowFrom),
    .@(MailCssClasses.RowUnread) .@(MailCssClasses.RowSubject) {
        font-weight: @(AppMeasures.Weight.Heavy);
    }

    .@(MailCssClasses.RowMain) {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
    }

    .@(MailCssClasses.RowTop) {
        display: flex;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .@(MailCssClasses.RowFrom) {
        font-size: @(AppMeasures.Font.Normal)px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(MailCssClasses.RowDate) {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textMuted;
        flex-shrink: 0;
    }

    .@(MailCssClasses.RowSubject) {
        font-size: @(AppMeasures.Font.Normal)px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(MailCssClasses.RowFlag) {
        margin-right: @(AppMeasures.Space.Px4)px;
    }

    .@(MailCssClasses.RowPreview) {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textMuted;
        overflow: hidden;
        @if (previewLines == 0)
        {
            @("display: none;")
        }
        else if (previewLines == 1)
        {
            @("text-overflow: ellipsis; white-space: nowrap;")
        }
        else
        {
            @($"display: -webkit-box; -webkit-line-clamp: {previewLines}; -webkit-box-orient: vertical; white-space: normal;")
        }
    }

    .@(MailCssClasses.RowAttach) {
        margin-right: @(AppMeasures.Space.Px4)px;
    }

    .@(MailCssClasses.TrashPolicyBanner) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px8)px;
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
    }

    .@(MailCssClasses.TrashPolicyText) {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textSecondary;
        font-weight: @(AppMeasures.Weight.Medium);
    }

    .@(MailCssClasses.TrashPolicyActions) {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .@(MailCssClasses.DeletedFolderCard) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px10)px;
        padding: @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
    }

    .@(MailCssClasses.DeletedFolderMain) {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px4)px;
        min-width: 0;
        flex: 1;
    }

    .@(MailCssClasses.DeletedFolderTitle) {
        font-size: @(AppMeasures.Font.Normal)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @textPrimary;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(MailCssClasses.DeletedFolderMeta) {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textMuted;
    }

    .@(MailCssClasses.DeletedFolderActions) {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        flex-shrink: 0;
    }

    .@(MailCssClasses.ModalBodyStack) {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px14)px;
    }

    .@(MailCssClasses.ModalFieldBlock) {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .@(MailCssClasses.ModalFieldLabel) {
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @textPrimary;
    }

    .@(MailCssClasses.ModalFieldHint) {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textMuted;
        line-height: @(AppMeasures.LineHeight.Snug);
    }

    .@(MailCssClasses.ModalRowBetween) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px12)px;
    }

    .@(MailCssClasses.ModalPresetBar) {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .@(MailCssClasses.ModalSelectInput) {
        width: @(AppMeasures.Percent.Full)%;
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceStrong.ToRgbaHex(true);
        color: @textPrimary;
        font-size: @(AppMeasures.Font.Normal)px;
        outline: none;
    }

    .@(MailCssClasses.ModalFooterActions) {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px8)px;
        margin-top: @(AppMeasures.Space.Px8)px;
    }

    .@(MailCssClasses.ModalErrorBanner) {
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Small)px;
        border: @(AppMeasures.Border.Thin)px solid @AppColors.TextDanger.ToRgbaHex(true);
        color: @AppColors.TextDanger.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
    }

    .@(MailCssClasses.ModalNumberBox) {
        width: @(AppMeasures.Size.Px110)px;
    }
</style>
