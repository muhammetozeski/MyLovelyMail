@namespace MyLovelyMail.MainProject.UI.Pages
@inherits ThemedComponentBase

@{
    string textPrimary = AppColors.TextPrimary.ToRgbaHex(true);
    string textSecondary = AppColors.TextSecondary.ToRgbaHex(true);
    string textMuted = AppColors.TextMuted.ToRgbaHex(true);
    string primary = AppColors.Primary.ToRgbaHex(true);
    string surfaceTint = AppColors.SurfaceTintPrimary.ToRgbaHex(true);
    string glassBorder = AppColors.GlassBorderDefault.ToRgbaHex(true);
}

<style>
    /* ---- Compose ---- */

    .mail-compose-button {
        margin-bottom: @(AppMeasures.Space.Px8)px;
    }

    /* Grows to fill the pane but never shrinks below its content: in the phone's full-screen
       compose a shrinking card clipped the Discard and Send buttons, and the overlay scrolls instead. */
    .mail-compose-card {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px10)px;
        text-align: left;
        flex: 1 0 auto;
    }

    /* No min-height: 0 here, for the same reason: with it the 200px body slid under the attachment
       dropzone. */
    .mail-compose-fields {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px10)px;
        flex: 1;
    }

    .mail-compose-saved {
        font-size: @(AppMeasures.Font.XSmall)px;
        color: @textMuted;
        margin-left: auto;
        flex-shrink: 0;
    }

    .mail-compose-from {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textSecondary;
    }

    .mail-compose-body {
        flex: 1;
        min-height: @(AppMeasures.Size.Px200)px;
        resize: vertical;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: @AppColors.Background.ToRgbaHex(true);
        color: @textPrimary;
        padding: @(AppMeasures.Space.Px12)px;
        font-size: @(AppMeasures.Font.Normal)px;
        font-family: inherit;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        outline: none;
        box-sizing: border-box;
    }

    /* Undo-send bar: slides in above the reader while a queued send counts down. */
    .mail-undo-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px12)px;
        padding: @(AppMeasures.Space.Px10)px @(AppMeasures.Space.Px16)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: linear-gradient(135deg, @AppColors.Primary.WithAlpha(0.18f).ToRgbaHex(true), @AppColors.Accent.WithAlpha(0.18f).ToRgbaHex(true));
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        color: @AppColors.TextPrimary.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Normal)px;
        animation: reader-open @(AppMeasures.Duration.Normal)s ease;
    }

    .mail-undo-bar--warning {
        background: @AppColors.Warning.WithAlpha(0.18f).ToRgbaHex(true);
        border-color: @AppColors.Warning.ToRgbaHex(true);
    }

        /* The attach control is a label wrapping a hidden input, so it needs the button's own layout. */
        .mail-undo-bar--warning label.mail-undo-button {
            position: relative;
            display: inline-flex;
            align-items: center;
            overflow: hidden;
        }

    .mail-undo-bar--failed {
        background: @AppColors.Error.WithAlpha(0.18f).ToRgbaHex(true);
        border-color: @AppColors.Error.ToRgbaHex(true);
    }

    .mail-undo-text {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-undo-button {
        border: none;
        border-radius: @(AppMeasures.Radius.Pill)px;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px16)px;
        background: linear-gradient(135deg, @AppColors.Primary.ToRgbaHex(true), @AppColors.Accent.ToRgbaHex(true));
        color: @AppColors.TextOnAccent.ToRgbaHex(true);
        font-weight: @(AppMeasures.Weight.Bold);
        cursor: pointer;
        flex-shrink: 0;
        transition: transform @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-undo-button:hover {
            transform: scale(1.05);
        }

    /* Attachment dropzone: the invisible file input stretches over the whole label so both
       clicking anywhere and dropping files onto it reach the same input. */
    .mail-compose-dropzone {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: @(AppMeasures.Space.Px6)px;
        padding: @(AppMeasures.Space.Px10)px;
        border: @(AppMeasures.Border.Medium)px dashed @AppColors.GlassBorderDefault.ToRgbaHex(true);
        border-radius: @(AppMeasures.Radius.Medium)px;
        color: @AppColors.TextMuted.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
        cursor: pointer;
        transition: border-color @(AppMeasures.Duration.Fast)s ease, color @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-compose-dropzone:hover {
            border-color: @AppColors.Primary.ToRgbaHex(true);
            color: @AppColors.TextSecondary.ToRgbaHex(true);
        }

    .mail-compose-file-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .mail-compose-attachments {
        display: flex;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .mail-compose-attachment-chip {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px10)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
        max-width: @(AppMeasures.Size.Px280)px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-compose-attachment-remove {
        border: none;
        background: transparent;
        color: @AppColors.TextMuted.ToRgbaHex(true);
        cursor: pointer;
        font-size: @(AppMeasures.Font.Small)px;
        padding: 0 @(AppMeasures.Space.Px2)px;
    }

        .mail-compose-attachment-remove:hover {
            color: @AppColors.TextDanger.ToRgbaHex(true);
        }

    .mail-compose-error {
        margin: 0;
        color: @AppColors.TextDanger.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
        word-break: break-word;
    }

    .mail-compose-actions {
        display: flex;
        justify-content: flex-end;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .mail-reader-actions {
        display: flex;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .mail-attachments {
        display: flex;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px8)px;
    }

    .mail-attachment-chip {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @textPrimary;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        cursor: pointer;
        font-size: @(AppMeasures.Font.Small)px;
        max-width: @(AppMeasures.Size.Px300)px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: all @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-attachment-chip:hover {
            background: @surfaceTint;
            transform: translateY(-@(AppMeasures.Size.Px1)px);
        }

    .mail-attachment-chip--all {
        border-color: var(--account-accent, @primary);
        color: var(--account-accent, @primary);
        font-weight: @(AppMeasures.Weight.Medium);
    }

    .mail-attachment-size {
        color: @textMuted;
        font-size: @(AppMeasures.Font.XSmall)px;
    }

    .mail-tag-chip {
        display: inline-flex;
        align-items: center;
        /* Ink comes from the inline style (AppColors.InkOn), which measures contrast against the actual chip color. */
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Medium);
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: none;
        margin-right: @(AppMeasures.Space.Px4)px;
        white-space: nowrap;
    }

    .mail-tag-chip--action {
        cursor: pointer;
        transition: transform @(AppMeasures.Duration.Fast)s ease;
    }

        .mail-tag-chip--action:hover {
            transform: translateY(-@(AppMeasures.Size.Px1)px);
        }

    .mail-tag-chip--off {
        opacity: @(AppMeasures.Opacity.Disabled);
    }

    .mail-tag-picker {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .mail-tag-input {
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @textPrimary;
        border-radius: @(AppMeasures.Radius.Pill)px;
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px10)px;
        font-size: @(AppMeasures.Font.Small)px;
        outline: none;
        width: @(AppMeasures.Size.Px120)px;
    }

    .mail-image-banner {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.Small)px;
        color: @textSecondary;
        border: @(AppMeasures.Border.Thin)px solid @glassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        border-radius: @(AppMeasures.Radius.Medium)px;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px10)px;
    }

    .mail-save-status {
        font-size: @(AppMeasures.Font.Small)px;
        color: @textSecondary;
        word-break: break-all;
    }

</style>
