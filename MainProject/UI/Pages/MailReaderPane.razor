@namespace MyLovelyMail.MainProject.UI.Pages
@inherits MailPageSection
@inject NavigationManager Navigation
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings
@using System.IO

    @* ---- Right: compose pane, person sheet, or reading pane ---- *@
    <section class="@MailCssClasses.Reader">
        @if (View.PaneTabs.Count > 1)
        {
            <div class="@MailCssClasses.PaneTabs">
                @foreach (var (occupant, label) in View.PaneTabs)
                {
                    <button class="@MailCssClasses.PaneTab @(MailUiState.ThirdPane == occupant ? MailCssClasses.PaneTabOn : "")"
                            @onclick="() => MailUiState.ShowPane(occupant)">@label</button>
                }
            </div>
        }
        @if (MailUiState.ThirdPane == MailUiState.PaneOccupant.Person
             && MailUiState.OpenPersonAddress is { } personAddress
             && PersonProfileService.Build(MailUiState.SelectedAccount?.Id ?? string.Empty, personAddress) is { } person)
        {
            <div class="@MailCssClasses.PersonSheet"
                 @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                     () => MouseActionService.RunAsync(MouseActionService.CopyAction, person.Address),
                     () => { View.OpenAddressMenu(person.Address, e); return Task.CompletedTask; })"
                 @onmouseup:stopPropagation="true"
                 @oncontextmenu="e => View.OpenAddressMenu(person.Address, e)"
                 @oncontextmenu:preventDefault="true"
                 @oncontextmenu:stopPropagation="true">
                <div class="@MailCssClasses.PersonHead">
                    <span class="@MailCssClasses.PersonName"
                          @oncontextmenu="e => View.OpenAddressMenu(person.Address, e)"
                          @oncontextmenu:preventDefault="true"
                          @oncontextmenu:stopPropagation="true">@(person.DisplayName.Length > 0 ? person.DisplayName : person.Address)</span>
                    <button class="@MailCssClasses.PersonClose" title="Close" @onclick="MailUiState.ClosePerson">✕</button>
                </div>
                <div class="@MailCssClasses.PersonAddress"
                     @oncontextmenu="e => View.OpenAddressMenu(person.Address, e)"
                     @oncontextmenu:preventDefault="true"
                     @oncontextmenu:stopPropagation="true">@person.Address</div>
                <div class="@MailCssClasses.PersonStats">
                    <span>@person.MessageCount messages</span>
                    <span>@person.ReceivedCount received · @person.SentCount sent</span>
                    <span>@person.UnreadCount unread</span>
                    <span>@person.WithAttachments with attachments</span>
                    @if (person.MessageCount > 0)
                    {
                        <span>@person.OldestUtc.ToLocalTime().ToString("dd MMM yyyy") — @person.NewestUtc.ToLocalTime().ToString("dd MMM yyyy")</span>
                    }
                </div>
                @foreach (var (folderName, count) in person.ByFolder.OrderByDescending(e => e.Value))
                {
                    <div class="@MailCssClasses.PersonFolder">@folderName — @count</div>
                }
                @if (person.Tags.Count > 0)
                {
                    <div class="@MailCssClasses.PersonTags">
                        @foreach (string tag in person.Tags)
                        {
                            <span class="@MailCssClasses.TagChip"
                                  style="background:@TagStore.ColorOf(tag);color:@AppColors.InkOn(TagStore.ColorOf(tag)).ToRgbaHex(true)"
                                  @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                                      () => MouseActionService.RunAsync(MouseActionService.CopyAction, tag),
                                      () => { View.OpenTagMenu(tag, null, e); return Task.CompletedTask; })"
                                  @onmouseup:stopPropagation="true"
                                  @oncontextmenu="e => View.OpenTagMenu(tag, null, e)"
                                  @oncontextmenu:preventDefault="true"
                                  @oncontextmenu:stopPropagation="true">@tag</span>
                        }
                    </div>
                }
                <CustomizableActionBar SurfaceId="@UiSurfaceIds.PersonActionsBar"
                                       PairedMenuSurfaceId="@UiSurfaceIds.SenderContextMenu"
                                       DefaultActions="@View.BuildPersonActions(person)"
                                       AddedActionResolver="@(id => View.ResolveToolbarAddedAction(UiSurfaceIds.PersonActionsBar, id, senderAddressContext: person.Address))"
                                       Wrap="true"
                                       CustomClass="@MailCssClasses.PersonActions" />
            </div>
        }

        @if (OutboxAttemptStore.HeldCount is > 0 and var heldCount)
        {
            <div class="@MailCssClasses.UndoBar @MailCssClasses.UndoBarFailed">
                <span class="@MailCssClasses.UndoText">⛔ @heldCount message(s) stopped after repeated send failures</span>
                <button class="@MailCssClasses.UndoButton" @onclick="View.RetryHeldOutbox">Try now</button>
            </div>
        }

        @if (OutboxService.LastFailure is { } failedSend)
        {
            <div class="@MailCssClasses.UndoBar @MailCssClasses.UndoBarFailed">
                <span class="@MailCssClasses.UndoText">❌ Send failed: "@(string.IsNullOrWhiteSpace(failedSend.Draft.Subject) ? "(no subject)" : failedSend.Draft.Subject)" — @failedSend.Reason</span>
                <button class="@MailCssClasses.UndoButton" @onclick="OutboxService.RetryFailed">🔁 Retry</button>
                <button class="@MailCssClasses.UndoButton" @onclick="Mail.EditFailedSend">✏️ Edit</button>
                <button class="@MailCssClasses.UndoButton" @onclick="OutboxService.DismissFailed">✕ Dismiss</button>
            </div>
        }
        @if (OutboxService.Current is { } pendingSend)
        {
            <div class="@MailCssClasses.UndoBar">
                <span class="@MailCssClasses.UndoText">✉️ Sending "@(string.IsNullOrWhiteSpace(pendingSend.Draft.Subject) ? "(no subject)" : pendingSend.Draft.Subject)" in @(Mail.UndoSecondsLeft(pendingSend))s…</span>
                <button class="@MailCssClasses.UndoButton" @onclick="Mail.UndoPendingSend">↩️ Undo</button>
            </div>
        }
        @if (MailUiState.ThirdPane == MailUiState.PaneOccupant.Compose && MailUiState.ActiveCompose is { } draft)
        {
            <div class="@MailCssClasses.ReaderTopRow"
                 data-context-menu="true"
                 @oncontextmenu="e => View.OpenComposeMenu(e)"
                 @oncontextmenu:preventDefault="true"
                 @oncontextmenu:stopPropagation="true">
                <BackButton OnClick="@View.SaveAndCloseCompose" />
                <div class="@MailCssClasses.ReaderSubject">✏️ @(string.IsNullOrWhiteSpace(draft.Subject) ? "New message" : draft.Subject)</div>
                @if (View.DraftSavedAt != null)
                {
                    <span class="@MailCssClasses.ComposeSaved">💾 @View.DraftSavedAt?.ToString("HH:mm:ss")</span>
                }
                @if (draft.SourceUid > 0)
                {
                    <CustomizableActionBar SurfaceId="@UiSurfaceIds.ComposeQuoteBar"
                                           PairedMenuSurfaceId="@UiSurfaceIds.WorkspaceContextMenu"
                                           DefaultActions="@View.BuildComposeQuoteActions(draft)"
                                           AddedActionResolver="@(id => View.ResolveToolbarAddedAction(UiSurfaceIds.ComposeQuoteBar, id))"
                                           Inline="true"
                                           Compact="true"
                                           CustomClass="@MailCssClasses.QuotePicker" />
                }
            </div>

            <GlassCard Level="AcrylicLevel.Strong" CustomClass="@MailCssClasses.ComposeCard">
                <div class="@MailCssClasses.ComposeFields" @oninput="View.NoteComposeActivity">
                    <div class="@MailCssClasses.ComposeFrom">
                        <span class="@MailCssClasses.AccountDot" style="background:@(draft.Account?.ColorHex ?? AppColors.Primary.ToRgbaHex(true))"></span>
                        <span>From:</span>
                        <select class="@MailCssClasses.ModalSelectInput"
                                style="@AppStyles.BuildAccountTintedBoxStyle(draft.Account?.ColorHex)"
                                value="@(draft.Account?.Id ?? string.Empty)"
                                @onchange="e => { if (AccountStore.GetById(e.Value?.ToString() ?? string.Empty) is { } chosen) View.SwitchDraftAccount(draft, chosen); }"
                                @oncontextmenu="e => { if (draft.Account is { } acc) View.OpenAccountMenu(acc, e); }"
                                @oncontextmenu:preventDefault="true"
                                @oncontextmenu:stopPropagation="true">
                            @foreach (var sender in AccountStore.Accounts)
                            {
                                <option value="@sender.Id" style="background:@AppColors.Background.ToRgbaHex(true);color:@AppColors.TextPrimary.ToRgbaHex(true);">@(string.IsNullOrWhiteSpace(sender.DisplayName) ? sender.EmailAddress : $"{sender.DisplayName} <{sender.EmailAddress}>")</option>
                            }
                        </select>
                    </div>
                    <datalist id="@Mail.ContactListId">
                        @foreach (var contact in View.KnownContacts)
                        {
                            <option value="@contact.Suggestion"></option>
                        }
                    </datalist>
                    <CoreInput Placeholder="To (comma separated)" Icon="👤" ListId="@Mail.ContactListId" @bind-Value="draft.To" />
                    <CoreInput Placeholder="Cc" Icon="👥" ListId="@Mail.ContactListId" @bind-Value="draft.Cc" />
                    <CoreInput Placeholder="Subject" Icon="🏷️" @bind-Value="draft.Subject" />
                    <textarea class="@MailCssClasses.ComposeBody" placeholder="Write something lovely..." @bind="draft.Body" @bind:event="oninput"></textarea>
                </div>

                <label class="@MailCssClasses.ComposeDropzone">
                    <InputFile OnChange="View.OnComposeFilesSelectedAsync" multiple class="@MailCssClasses.ComposeFileInput" />
                    📎 Attach files — click or drop them here
                </label>
                @if (draft.AttachmentPaths.Count > 0)
                {
                    <div class="@MailCssClasses.ComposeAttachments">
                        @foreach (var attachmentPath in draft.AttachmentPaths)
                        {
                            <span class="@MailCssClasses.ComposeAttachmentChip"
                                  @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                                      () => { View.RemoveComposeAttachment(attachmentPath); return Task.CompletedTask; },
                                      () => MouseActionService.RunAsync(MouseActionService.CopyAction, Path.GetFileName(attachmentPath)))"
                                  @onmouseup:stopPropagation="true"
                                  @oncontextmenu="e => View.OpenComposeAttachmentMenu(attachmentPath, e)"
                                  @oncontextmenu:preventDefault="true"
                                  @oncontextmenu:stopPropagation="true">
                                📎 @Path.GetFileName(attachmentPath)
                                <button class="@MailCssClasses.ComposeAttachmentRemove" title="Remove"
                                        @onclick="() => View.RemoveComposeAttachment(attachmentPath)">✕</button>
                            </span>
                        }
                    </div>
                }

                @if (View.SendError != null)
                {
                    <p class="@MailCssClasses.ComposeError">❌ @View.SendError</p>
                }

                @if (View.SendWarnings.Count > 0)
                {
                    <div class="@MailCssClasses.UndoBar @MailCssClasses.UndoBarWarning @MailCssClasses.SendGuard">
                        @foreach (var warning in View.SendWarnings)
                        {
                            <span class="@MailCssClasses.UndoText">⚠️ @warning.Text</span>
                            @if (warning.Code == SendGuardService.AttachmentCode)
                            {
                                <label class="@MailCssClasses.UndoButton">
                                    <InputFile OnChange="View.OnComposeFilesSelectedAsync" multiple class="@MailCssClasses.ComposeFileInput" />
                                    Attach a file
                                </label>
                            }
                        }
                        <button class="@MailCssClasses.UndoButton" @onclick="View.ForceQueueActiveDraftSend">Send anyway</button>
                    </div>
                }

                <CustomizableActionBar SurfaceId="@UiSurfaceIds.ComposeFooterBar"
                                       PairedMenuSurfaceId="@UiSurfaceIds.WorkspaceContextMenu"
                                       DefaultActions="@View.BuildComposeFooterActions(draft)"
                                       AddedActionResolver="@(id => View.ResolveToolbarAddedAction(UiSurfaceIds.ComposeFooterBar, id))"
                                       Wrap="true"
                                       CustomClass="@MailCssClasses.ComposeActions" />
            </GlassCard>
        }
        else if (MailUiState.OpenMessage is not { } open)
        {
            <div class="@MailCssClasses.Empty">
                <div class="@MailCssClasses.EmptyIcon">💌</div>
                <div class="@MailCssClasses.EmptyText">Select a message to read it here</div>
            </div>
        }
        else
        {
            var readerTargets = View.MessageTargets(open);
            var readerPayload = JsonSerializer.Serialize(readerTargets);
            string? openAccountId = View.MessageIdentityOf(open)?.AccountId;

            <div class="@MailCssClasses.ReaderContent"
                 @key="View.MessageIdentityOf(open)"
                 @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                     () => MouseActionService.RunMessagesAsync(MailMessageCommand.Trash, readerTargets),
                     () => MouseActionService.RunMessagesAsync(MailMessageCommand.Read, readerTargets))"
                 @onmouseup:stopPropagation="true"
                 @oncontextmenu="e => View.OpenMessageMenu(readerTargets, e.ClientX, e.ClientY, primary: View.MessageIdentityOf(open))"
                 @oncontextmenu:preventDefault="true"
                 @oncontextmenu:stopPropagation="true">

            <div class="@MailCssClasses.ReaderHeaderCard">
                <div class="@MailCssClasses.ReaderTopRow">
                    <BackButton OnClick="@MailUiState.CloseMessage" />
                    <button class="@MailCssClasses.ReaderAvatar"
                            title="Everything known about this correspondent (right-click for sender actions)"
                            style="background:@Mail.AvatarGradient(open)"
                            @oncontextmenu="e => View.OpenAddressMenu(open.FromAddress, e, openAccountId)"
                            @oncontextmenu:preventDefault="true"
                            @oncontextmenu:stopPropagation="true"
                            @onclick="() => MailUiState.OpenPerson(open.FromAddress)">@Mail.AvatarInitials(open)</button>
                    <div class="@MailCssClasses.ReaderSubject" title="@open.Subject">@(string.IsNullOrWhiteSpace(open.Subject) ? "(no subject)" : open.Subject)</div>
                    <CustomizableActionBar SurfaceId="@UiSurfaceIds.ReaderHeaderNav"
                                           PairedMenuSurfaceId="@UiSurfaceIds.MessageContextMenu"
                                           DefaultActions="@View.BuildReaderHeaderNavActions()"
                                           AddedActionResolver="@(id => View.ResolveToolbarAddedAction(UiSurfaceIds.ReaderHeaderNav, id, messageContext: open, targetsContext: readerTargets))"
                                           Inline="true"
                                           Compact="true"
                                           CustomClass="@MailCssClasses.ReaderListNav" />
                </div>

                <div class="@MailCssClasses.ReaderMetaRow">
                    <div class="@MailCssClasses.ReaderMetaLeft">
                        <span class="@MailCssClasses.ReaderFrom"
                              @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                                  () => MouseActionService.RunAsync(MouseActionService.CopyAction, open.FromAddress),
                                  () => { View.OpenAddressMenu(open.FromAddress, e, openAccountId); return Task.CompletedTask; })"
                              @onmouseup:stopPropagation="true"
                              @onclick="() => MailUiState.OpenPerson(open.FromAddress)"
                              @oncontextmenu="e => View.OpenAddressMenu(open.FromAddress, e, openAccountId)"
                              @oncontextmenu:preventDefault="true"
                              @oncontextmenu:stopPropagation="true">
                            @(string.IsNullOrWhiteSpace(open.FromName) ? open.FromAddress : $"{open.FromName} <{open.FromAddress}>")
                        </span>
                        <span class="@MailCssClasses.ReaderDate">@open.DateUtc.ToLocalTime().ToString(ContentConstants.DateFormats.UiBanner + " HH:mm")</span>
                        @if (View.HistoryOfOpenSender(open) is { } history)
                        {
                            <button class="@MailCssClasses.ReaderHistory"
                                    title="Show everything from this sender (right-click for sender actions)"
                                    @oncontextmenu="e => View.OpenAddressMenu(open.FromAddress, e, openAccountId)"
                                    @oncontextmenu:preventDefault="true"
                                    @oncontextmenu:stopPropagation="true"
                                    @onclick="() => MailUiState.OpenPerson(open.FromAddress)">
                                💌 @history.MessageCount@(history.UnreadCount > 0 ? $" ({history.UnreadCount} unread)" : "")
                            </button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(open.ToAddresses))
                    {
                        var parsedRecipients = Mail.ParseRecipients(open.ToAddresses);
                        <div class="@MailCssClasses.ReaderTo" title="to @open.ToAddresses">
                            to
                            @if (parsedRecipients.Count > 0)
                            {
                                @for (int ri = 0; ri < parsedRecipients.Count; ri++)
                                {
                                    var (rawRecip, recipAddr) = parsedRecipients[ri];
                                    @if (ri > 0) { <text>, </text> }
                                    <span class="@MailCssClasses.ReaderToAddress"
                                          @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                                              () => MouseActionService.RunAsync(MouseActionService.CopyAction, recipAddr),
                                              () => { View.OpenAddressMenu(recipAddr, e, openAccountId); return Task.CompletedTask; })"
                                          @onmouseup:stopPropagation="true"
                                          @onclick="() => MailUiState.OpenPerson(recipAddr)"
                                          @oncontextmenu="e => View.OpenAddressMenu(recipAddr, e, openAccountId)"
                                          @oncontextmenu:preventDefault="true"
                                          @oncontextmenu:stopPropagation="true">@rawRecip</span>
                                }
                            }
                            else
                            {
                                @open.ToAddresses
                            }
                        </div>
                    }
                </div>

                @if (open.Tags.Count > 0 || View.authFindings.Count > 0 || View.ruleTraceLines.Count > 0 || View.unsubscribeTargets != null)
                {
                    <div class="@MailCssClasses.ReaderBadgesRow">
                        @foreach (var tag in open.Tags)
                        {
                            <button class="@MailCssClasses.TagChip @MailCssClasses.TagChipAction"
                                    style="background:@TagStore.ColorOf(tag);color:@AppColors.InkOn(TagStore.ColorOf(tag)).ToRgbaHex(true)"
                                    @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                                        () => MouseActionService.RunMessagesAsync(MailMessageCommand.RemoveTag, readerTargets, tag))"
                                    @onmouseup:stopPropagation="true"
                                    @oncontextmenu="e => View.OpenTagMenu(tag, open, e)"
                                    @oncontextmenu:preventDefault="true"
                                    @oncontextmenu:stopPropagation="true"
                                    title="Search this tag"
                                    @onclick="() => View.SearchByTag(tag)">@tag</button>
                        }
                        @foreach (var finding in View.authFindings)
                        {
                            <span class="@MailCssClasses.AuthChip" title="@finding.Code">⚠️ @finding.Text</span>
                        }
                        @if (View.ruleTraceLines.Count > 0)
                        {
                            <div class="@MailCssClasses.RuleStrip">
                                <button class="@MailCssClasses.RuleTrace @MailCssClasses.RuleSummary"
                                        title="What the filter rules did to this message"
                                        @onclick="() => View.ruleTraceExpanded = !View.ruleTraceExpanded">
                                    <span>🧭</span>
                                    <span class="@MailCssClasses.RuleLead">@Mail.RuleTraceLabel(View.ruleTraceLines[0])</span>
                                    @if (View.ruleTraceLines.Count > 1)
                                    {
                                        <span class="@MailCssClasses.RuleCount">+@(View.ruleTraceLines.Count - 1)</span>
                                    }
                                    <span class="@MailCssClasses.RuleName">@View.ruleTraceLines[0].RuleName</span>
                                    <span class="@MailCssClasses.RuleCaret">@(View.ruleTraceExpanded ? "▴" : "▾")</span>
                                </button>
                                @if (View.ruleTraceExpanded)
                                {
                                    <div class="@MailCssClasses.RuleRows">
                                        @foreach (var line in View.ruleTraceLines)
                                        {
                                            <button class="@MailCssClasses.RuleTrace @MailCssClasses.RuleRow"
                                                    title="Open the filter rules"
                                                    @onclick='() => Navigation.NavigateTo(FilterRules.RoutePath)'>
                                                <span class="@MailCssClasses.RuleLead">@Mail.RuleTraceLabel(line)</span>
                                                <span class="@MailCssClasses.RuleName">@line.RuleName</span>
                                                @if (line.Count > 1)
                                                {
                                                    <span class="@MailCssClasses.RuleCount">×@line.Count</span>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (View.unsubscribeTargets is { } unsubscribe)
                        {
                            @if (unsubscribe.HttpUrl is { } unsubscribeUrl && MailUiState.SelectedAccount is not { TorOnly: true })
                            {
                                <button class="@MailCssClasses.UnsubscribeChip" title="@unsubscribeUrl"
                                        @onclick="() => View.OpenUnsubscribePage(unsubscribeUrl)">🚫 Unsubscribe on web</button>
                            }
                            else if (unsubscribe.HttpUrl != null)
                            {
                                <span class="@MailCssClasses.UnsubscribeChip @MailCssClasses.UnsubscribeChipBlocked" title="@unsubscribe.HttpUrl">
                                    🛡️ Web unsubscribe blocked (Tor)
                                </span>
                            }
                            @if (unsubscribe.MailtoAddress != null)
                            {
                                <button class="@MailCssClasses.UnsubscribeChip" title="Prepares the mail; you still press Send"
                                        @onclick="() => View.ComposeUnsubscribeMail(unsubscribe)">✉️ Unsubscribe by mail</button>
                            }
                        }
                    </div>
                }
            </div>

            @if (View.ThreadOfOpenMessage(open) is { } thread)
            {
                <div class="@MailCssClasses.ReaderThread">
                    <div class="@MailCssClasses.ReaderThreadNav">
                        <button class="@MailCssClasses.ThreadStep" disabled="@(View.OpenThreadPosition(open) <= 1)"
                                title="Previous in conversation (P)" @onclick="() => View.StepThread(-1)">◀</button>
                        <span class="@MailCssClasses.ReaderThreadCount">@View.OpenThreadPosition(open) of @thread.Count</span>
                        <button class="@MailCssClasses.ThreadStep" disabled="@(View.OpenThreadPosition(open) >= thread.Count)"
                                title="Next in conversation (N)" @onclick="() => View.StepThread(1)">▶</button>
                    </div>
                    @foreach (var step in thread)
                    {
                        var stepTargets = View.MessageTargets(step);
                        <button class="@MailCssClasses.ThreadLine @(step.Uid == open.Uid ? MailCssClasses.ThreadLineOpen : "")"
                                @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                                    () => MouseActionService.RunMessagesAsync(MailMessageCommand.Trash, stepTargets),
                                    () => MouseActionService.RunMessagesAsync(MailMessageCommand.Read, stepTargets))"
                                @onmouseup:stopPropagation="true"
                                @oncontextmenu="e => View.OpenMessageMenu(stepTargets, e.ClientX, e.ClientY, primary: View.MessageIdentityOf(step))"
                                @oncontextmenu:preventDefault="true"
                                @oncontextmenu:stopPropagation="true"
                                @onclick="() => View.OpenMessage(step)">
                            <span class="@MailCssClasses.ThreadLineDate">@step.DateUtc.ToLocalTime().ToString("dd MMM HH:mm")</span>
                            <span class="@MailCssClasses.ThreadLineSender"
                                  @oncontextmenu="e => View.OpenAddressMenu(step.FromAddress, e, View.MessageIdentityOf(step)?.AccountId)"
                                  @oncontextmenu:preventDefault="true"
                                  @oncontextmenu:stopPropagation="true">@(string.IsNullOrWhiteSpace(step.FromName) ? step.FromAddress : step.FromName)</span>
                            @if (step.IsUnread)
                            {
                                <span class="@MailCssClasses.ThreadLineUnread"></span>
                            }
                        </button>
                    }
                </div>
            }

            <CustomizableActionBar SurfaceId="@UiSurfaceIds.ReaderToolbar"
                                   PairedMenuSurfaceId="@UiSurfaceIds.MessageContextMenu"
                                   DefaultActions="@View.BuildReaderToolbarActions(open, readerTargets)"
                                   AddedActionResolver="@(id => View.ResolveToolbarAddedAction(UiSurfaceIds.ReaderToolbar, id, messageContext: open, targetsContext: readerTargets))"
                                   Wrap="true"
                                   CustomClass="@MailCssClasses.ReaderActions" />

            @if (View.OpenAttachments.Count > 0)
            {
                <div class="@MailCssClasses.Attachments">
                    @foreach (var attachment in View.OpenAttachments)
                    {
                        <button class="@MailCssClasses.AttachmentChip" title="Save to Downloads"
                                @onmouseup="e => MouseActionService.HandleSideMouseUpAsync(e,
                                    () => MouseActionService.RunAsync(MouseActionService.CopyAction, attachment.FileName))"
                                @onmouseup:stopPropagation="true"
                                @oncontextmenu="e => View.OpenAttachmentMenu(attachment, e)"
                                @oncontextmenu:preventDefault="true"
                                @oncontextmenu:stopPropagation="true"
                                @onclick="() => View.SaveAttachmentAsync(attachment.Index)">
                            @AttachmentService.IconFor(attachment) @attachment.FileName
                            @if (attachment.HumanSize.Length > 0)
                            {
                                <span class="@MailCssClasses.AttachmentSize">@attachment.HumanSize</span>
                            }
                        </button>
                    }
                    @if (View.OpenAttachments.Count > 1)
                    {
                        <button class="@MailCssClasses.AttachmentChip @MailCssClasses.AttachmentChipAll" @onclick="View.SaveAllAttachmentsAsync">📦 Save all</button>
                    }
                </div>
            }

            @if (View.OpenBodyBlockedImages)
            {
                <div class="@MailCssClasses.ImageBanner">
                    @if (MailUiState.SelectedAccount is { TorOnly: true })
                    {
                        <span>🛡️ Remote images stay blocked — this account only talks through Tor.</span>
                    }
                    else
                    {
                        <span>🖼️ Remote images were blocked for your privacy.</span>
                        <PillButton OnClick="View.AllowImagesOnce">Show images once</PillButton>
                    }
                </div>
            }

            <GlassCard Level="AcrylicLevel.Strong" CustomClass="@MailCssClasses.ReaderBody">
                @if (View.OpenBodyLoading)
                {
                    <div class="@MailCssClasses.BodyLoading">
                        <CoreSpinner />
                        <span class="@MailCssClasses.ReaderNoBody">Loading message…</span>
                    </div>
                }
                else if (View.OpenBodyHtml != null)
                {
                    <iframe class="@MailCssClasses.ReaderFrame"
                            scrolling="no"
                            data-anonymous="@(MailUiState.SelectedAccount is { TorOnly: true } ? "true" : "false")"
                            sandbox="@(MailUiState.SelectedAccount is { TorOnly: true } ? "allow-same-origin" : "allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation")"
                            srcdoc="@View.OpenBodyHtml"
                            data-message-targets="@readerPayload"
                            data-message-primary="@JsonSerializer.Serialize(View.MessageIdentityOf(open))"></iframe>
                }
                else
                {
                    @if (View.BodyError != null)
                    {
                        <p class="@MailCssClasses.ComposeError">❌ @View.BodyError</p>
                        <PillButton OnClick="View.RetryOpenBodyAsync">🔄 Try again</PillButton>
                    }
                    @if (string.IsNullOrWhiteSpace(open.PreviewText))
                    {
                        <p class="@MailCssClasses.ReaderNoBody">The full message is not cached yet. It will appear as soon as sync fetches it.</p>
                    }
                    else
                    {
                        <p class="@MailCssClasses.ReaderPreview">@open.PreviewText</p>
                    }
                }
            </GlassCard>
            </div>
        }
    </section>
