@attribute [Route(RouteTemplate)]
@inherits MyLovelyMail.MainProject.UI.Layout.Architecture.PageBase
@inject NavigationManager Navigation
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings
<PageTitle>Account settings — My Lovely Mail</PageTitle>

<div class="settings-screen">
    @if (Account == null)
    {
        <div class="mail-empty">
            <div class="mail-empty-icon">👻</div>
            <div class="mail-empty-text">This account no longer exists.</div>
        </div>
    }
    else
    {
        <div class="filters-header">
            <BackButton OnClick="@(() => Navigation.NavigateTo(NavigationConstants.Settings.Link))" />
            <h1 class="filters-title">
                <span class="settings-account-dot" style="background:@Account.ColorHex"></span>
                @Account.EmailAddress
            </h1>
        </div>

        <GlassCard CustomClass="settings-section">
            <div class="settings-section-title">🙂 Identity</div>
            <div class="settings-row">
                <div class="settings-row-text">
                    <span class="settings-row-label">Display name</span>
                    <span class="settings-row-hint">Shown to recipients of your mail</span>
                </div>
                <div class="settings-number settings-number--wide">
                    <CoreInput Value="@Account.DisplayName" ValueChanged="@SetDisplayName" />
                </div>
            </div>
            <div class="settings-row">
                <div class="settings-row-text">
                    <span class="settings-row-label">Account color</span>
                    <span class="settings-row-hint">Tints the workspace while this account is active</span>
                </div>
                <div class="wizard-colors">
                    @foreach (var colorHex in AccountWizard.AccountColors)
                    {
                        <button class="wizard-color @(Account.ColorHex == colorHex ? "wizard-color--active" : "")"
                                style="background:@colorHex" @onclick="() => SetColor(colorHex)"></button>
                    }
                </div>
            </div>
            <div class="settings-row">
                <div class="settings-row-text">
                    <span class="settings-row-label">Account enabled</span>
                    <span class="settings-row-hint">Disabled accounts stay configured but never sync</span>
                </div>
                <CoreToggle Checked="@Account.Enabled" CheckedChanged="@SetEnabled" />
            </div>
        </GlassCard>

        @* Inherits exactly like every other account setting, but it gets its own card: a
           signature is written, and a one-line override row cannot hold an editor and a preview. *@
        <GlassCard CustomClass="settings-section">
            <SignatureEditor Value="@AccountSettingsOf.Signature.Value"
                             BadgeText="@(AccountSettingsOf.Signature.IsOverridden ? "overridden" : "inherited")"
                             Inherited="@(!AccountSettingsOf.Signature.IsOverridden)"
                             Hint="Follows the global signature until you write one here"
                             ValueChanged="@SaveAccountSignature"
                             OnReset="@ResetAccountSignature" />
        </GlassCard>

        <GlassCard CustomClass="settings-section">
            <div class="settings-section-title">🧬 Account overrides</div>
            <p class="settings-empty-text">
                Each setting follows the global value until you change it here. "Inherited" rows update
                live when the global setting changes; overridden rows keep their own value.
            </p>
            @foreach (var setting in AccountSettingsOf.GetAllSettings().Where(SettingHasItsOwnCard))
            {
                <SettingEditorRow Setting="@setting"
                                  BadgeText="@(setting.IsDefault ? "inherited" : "overridden")"
                                  ResetTitle="Reset to inherited"
                                  OnSaved="@(() => AccountSettingsOf.Save())" />
            }
        </GlassCard>
    }
</div>

<SettingsCss />
<FilterRulesCss />
<AccountWizardCss />
<MailCss />
<AccountSettingsPageCss />

@code {
    public const string RouteTemplate = "/Settings/Account/{AccountId}";

    [Parameter] public string AccountId { get; set; } = string.Empty;

    MailAccountData? Account => AccountStore.GetById(AccountId);
    AccountSettings AccountSettingsOf => AccountStore.GetSettings(AccountId);

    /// <summary>Written with nameof so renaming the field breaks the build instead of showing the signature twice.</summary>
    static bool SettingHasItsOwnCard(ISetting setting) =>
        setting.Key != nameof(AccountSettings.Signature);

    void SaveAccountSignature(string value)
    {
        AccountSettingsOf.Signature.Value = value;
        AccountSettingsOf.Save();
    }

    void ResetAccountSignature()
    {
        AccountSettingsOf.Signature.ClearOverride();
        AccountSettingsOf.Save();
    }

    public static string RouteFor(string accountId) => $"/Settings/Account/{accountId}";

    void SetDisplayName(string name)
    {
        if (Account is not { } account) return;
        account.DisplayName = name;
        AccountStore.Save(account);
    }

    void SetColor(string colorHex)
    {
        if (Account is not { } account) return;
        account.ColorHex = colorHex;
        AccountStore.Save(account);
    }

    void SetEnabled(bool enabled)
    {
        if (Account is not { } account) return;
        account.Enabled = enabled;
        AccountStore.Save(account);
    }

}
