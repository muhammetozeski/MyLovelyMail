@attribute [Route(RouteTemplate)]
@inherits MyLovelyMail.MainProject.UI.Layout.Architecture.PageBase
@inject NavigationManager Navigation
@using GlobalSettings = MyLovelyMail.MainProject.Stores.Settings
<PageTitle>Account settings — My Lovely Mail</PageTitle>

<div class="settings-screen">
    @if (Account == null)
    {
        <div class="mail-empty">
            <div class="mail-empty-icon">👻</div>
            <div class="mail-empty-text">This account no longer exists.</div>
        </div>
    }
    else
    {
        <div class="filters-header">
            <BackButton OnClick="@(() => Navigation.NavigateTo(NavigationConstants.Settings.Link))" />
            <h1 class="filters-title">
                <span class="settings-account-dot" style="background:@Account.ColorHex"></span>
                @Account.EmailAddress
            </h1>
        </div>

        <GlassCard CustomClass="settings-section">
            <div class="settings-section-title">🙂 Identity</div>
            <div class="settings-row">
                <div class="settings-row-text">
                    <span class="settings-row-label">Display name</span>
                    <span class="settings-row-hint">Shown to recipients of your mail</span>
                </div>
                <div class="settings-number settings-number--wide">
                    <CoreInput Value="@Account.DisplayName" ValueChanged="@SetDisplayName" />
                </div>
            </div>
            <div class="settings-row">
                <div class="settings-row-text">
                    <span class="settings-row-label">Account color</span>
                    <span class="settings-row-hint">Tints the workspace while this account is active</span>
                </div>
                <div class="wizard-colors">
                    @foreach (var colorHex in AccountWizard.AccountColors)
                    {
                        <button class="wizard-color @(Account.ColorHex == colorHex ? "wizard-color--active" : "")"
                                style="background:@colorHex" @onclick="() => SetColor(colorHex)"></button>
                    }
                </div>
            </div>
            <div class="settings-row">
                <div class="settings-row-text">
                    <span class="settings-row-label">Account enabled</span>
                    <span class="settings-row-hint">Disabled accounts stay configured but never sync</span>
                </div>
                <CoreToggle Checked="@Account.Enabled" CheckedChanged="@SetEnabled" />
            </div>
        </GlassCard>

        <GlassCard CustomClass="settings-section">
            <div class="settings-section-title">🖧 Servers</div>
            <p class="settings-empty-text">Changes apply immediately.</p>

            <div class="wizard-presets">
                @foreach (var preset in ProviderPresets.All)
                {
                    <button class="wizard-preset" @onclick="() => ApplyPreset(preset)">
                        <span class="wizard-preset-emoji">@preset.Emoji</span>
                        <span>@preset.Name</span>
                    </button>
                }
            </div>

            <div class="wizard-field">
                <span class="wizard-label">Receive protocol</span>
                <div class="wizard-protocols">
                    <button class="wizard-preset @(Account.Protocol == IncomingProtocol.Imap ? "wizard-preset--active" : "")"
                            @onclick="() => SetProtocol(IncomingProtocol.Imap)">📥 @IncomingProtocol.Imap.DisplayName()</button>
                    <button class="wizard-preset @(Account.Protocol == IncomingProtocol.Pop3 ? "wizard-preset--active" : "")"
                            @onclick="() => SetProtocol(IncomingProtocol.Pop3)">📪 @IncomingProtocol.Pop3.DisplayName()</button>
                </div>
            </div>

            <div class="wizard-grid">
                <div class="wizard-field">
                    <span class="wizard-label">Incoming host (@Account.Protocol.DisplayName())</span>
                    <CoreInput Value="@Account.IncomingHost" ValueChanged="@SetIncomingHost" />
                </div>
                <div class="wizard-field wizard-field--small">
                    <span class="wizard-label">Port</span>
                    <CoreInput Type="number" Value="@Account.IncomingPort.ToString()" ValueChanged="@SetIncomingPort" />
                </div>
                <div class="wizard-field wizard-field--small">
                    <span class="wizard-label">Security</span>
                    <select class="wizard-select" @bind="IncomingSecurityBinding">
                        @foreach (var security in Enum.GetValues<ConnectionSecurity>())
                        {
                            <option value="@security">@security</option>
                        }
                    </select>
                </div>
            </div>

            <div class="wizard-grid">
                <div class="wizard-field">
                    <span class="wizard-label">SMTP host</span>
                    <CoreInput Value="@Account.SmtpHost" ValueChanged="@SetSmtpHost" />
                </div>
                <div class="wizard-field wizard-field--small">
                    <span class="wizard-label">Port</span>
                    <CoreInput Type="number" Value="@Account.SmtpPort.ToString()" ValueChanged="@SetSmtpPort" />
                </div>
                <div class="wizard-field wizard-field--small">
                    <span class="wizard-label">Security</span>
                    <select class="wizard-select" @bind="SmtpSecurityBinding">
                        @foreach (var security in Enum.GetValues<ConnectionSecurity>())
                        {
                            <option value="@security">@security</option>
                        }
                    </select>
                </div>
            </div>

            <div class="wizard-field">
                <span class="wizard-label">Username (empty = email address)</span>
                <CoreInput Value="@Account.IncomingUsername" ValueChanged="@SetUsername" />
            </div>

            <div class="settings-row">
                <div class="settings-row-text">
                    <span class="settings-row-label">Password / app password</span>
                    <span class="settings-row-hint">Leave blank to keep the saved password</span>
                </div>
                <div class="settings-password-row">
                    <div class="settings-number settings-number--wide">
                        <CoreInput Type="password" @bind-Value="NewPassword" />
                    </div>
                    <SecondaryButton OnClick="@UpdatePassword" Disabled="@(NewPassword.Length == 0)">🔑 Update</SecondaryButton>
                </div>
            </div>
        </GlassCard>

        <GlassCard CustomClass="settings-section">
            <div class="settings-section-title">🛡️ Tor</div>
            <div class="settings-row">
                <div class="settings-row-text">
                    <span class="settings-row-label">Reach this account only through Tor</span>
                    <span class="settings-row-hint">
                        Mail is fetched and sent through the Tor SOCKS proxy, the server name is looked up by
                        Tor rather than by this machine, and remote images in this account's mail are never
                        loaded. When Tor is unavailable the account stays offline — it never falls back to a
                        direct connection. The server itself stays an ordinary one; only the route changes.
                    </span>
                </div>
                <CoreToggle Checked="@Account.TorOnly" CheckedChanged="@SetTorOnly" />
            </div>
            @if (Account.TorOnly)
            {
                <p class="settings-empty-text">@TorStatusLine</p>
                <div class="settings-migration-actions">
                    <SecondaryButton OnClick="@CheckTorAsync" Disabled="@TorChecking">
                        @if (TorChecking)
                        {
                            <CoreSpinner SizePx="18" BorderWidthPx="2" Color="@AppColors.TextPrimary" />
                        }
                        🛡️ Check the Tor route
                    </SecondaryButton>
                </div>
                @if (TorCheckMessage != null)
                {
                    <p class="settings-empty-text">@TorCheckMessage</p>
                }
            }
        </GlassCard>

        @* Inherits exactly like every other account setting, but it gets its own card: a
           signature is written, and a one-line override row cannot hold an editor and a preview. *@
        <GlassCard CustomClass="settings-section">
            <SignatureEditor Value="@AccountSettingsOf.Signature.Value"
                             BadgeText="@(AccountSettingsOf.Signature.IsOverridden ? "overridden" : "inherited")"
                             Inherited="@(!AccountSettingsOf.Signature.IsOverridden)"
                             Hint="Follows the global signature until you write one here"
                             ValueChanged="@SaveAccountSignature"
                             OnReset="@ResetAccountSignature" />
        </GlassCard>

        <GlassCard CustomClass="settings-section">
            <div class="settings-section-title">🧬 Account overrides</div>
            <p class="settings-empty-text">
                Each setting follows the global value until you change it here. "Inherited" rows update
                live when the global setting changes; overridden rows keep their own value.
            </p>
            @foreach (var setting in AccountSettingsOf.GetAllSettings().Where(SettingHasItsOwnCard))
            {
                <SettingEditorRow Setting="@setting"
                                  BadgeText="@(setting.IsDefault ? "inherited" : "overridden")"
                                  ResetTitle="Reset to inherited"
                                  OnSaved="@(() => AccountSettingsOf.Save())" />
            }
        </GlassCard>
    }
</div>

<SettingsCss />
<FilterRulesCss />
<AccountWizardCss />
<MailCss />
<AccountSettingsPageCss />

@code {
    public const string RouteTemplate = "/Settings/Account/{AccountId}";

    [Parameter] public string AccountId { get; set; } = string.Empty;

    MailAccountData? Account => AccountStore.GetById(AccountId);
    AccountSettings AccountSettingsOf => AccountStore.GetSettings(AccountId);

    /// <summary>Written with nameof so renaming the field breaks the build instead of showing the signature twice.</summary>
    static bool SettingHasItsOwnCard(ISetting setting) =>
        setting.Key != nameof(AccountSettings.Signature);

    void SaveAccountSignature(string value)
    {
        AccountSettingsOf.Signature.Value = value;
        AccountSettingsOf.Save();
    }

    void ResetAccountSignature()
    {
        AccountSettingsOf.Signature.ClearOverride();
        AccountSettingsOf.Save();
    }

    public static string RouteFor(string accountId) => $"/Settings/Account/{accountId}";

    void SetDisplayName(string name)
    {
        if (Account is not { } account) return;
        account.DisplayName = name;
        AccountStore.Save(account);
    }

    void SetColor(string colorHex)
    {
        if (Account is not { } account) return;
        account.ColorHex = colorHex;
        AccountStore.Save(account);
    }

    void SetEnabled(bool enabled)
    {
        if (Account is not { } account) return;
        account.Enabled = enabled;
        AccountStore.Save(account);
    }

    bool TorChecking { get; set; }
    string? TorCheckMessage { get; set; }

    /// <summary>
    /// What this account's traffic is doing right now, answered without touching the network.
    /// Instance-scoped since the route is per account: the globally current endpoint says nothing
    /// about which rung THIS mailbox needed.
    /// </summary>
    string TorStatusLine =>
        TorService.BootstrapLine is { } starting ? starting
        : LastRouteOfThisAccount is { } carried ? $"Last connection went {carried}."
        : TorService.Current is { } endpoint ? $"Route in use: {endpoint}."
        : !TorProcess.CanStartHere ? TorProcess.OrbotAdvice
        : TorProcess.Find() is { } executable ? $"No route open yet — one will be started from {executable.Path} on the next connection."
        : "⚠️ No tor executable was found on this machine. Install Tor or the Tor Browser, or set TorExecutablePath in Settings.";

    /// <summary>The route the last successful connection of THIS account actually took, or null before one.</summary>
    string? LastRouteOfThisAccount =>
        Account is { } account && SyncHealthService.For(account.Id).LastRoute is { Length: > 0 } route ? route : null;

    void SetTorOnly(bool torOnly)
    {
        if (Account is not { } account) return;
        account.TorOnly = torOnly;
        AccountStore.Save(account);
        TorCheckMessage = null;

        // The live IDLE connection was opened under the old answer and would keep using it: a
        // socket already talking to the provider directly does not become tunnelled because a flag
        // changed. Dropping the loop makes the next one take the route the account now demands.
        ImapIdleService.Drop(account.Id);

        Log($"Account {account.EmailAddress} is now {(torOnly ? "Tor-only" : "reachable directly")}.");
    }

    /// <summary>
    /// Runs the real check — a Tor RESOLVE over the SOCKS port — instead of reporting whether
    /// something is listening. A plain SOCKS proxy sitting on 9050 passes the second test and fails
    /// this one, and it is the difference between tunnelled and merely proxied.
    /// </summary>
    async Task CheckTorAsync()
    {
        TorChecking = true;
        TorCheckMessage = "Building a circuit…";
        StateHasChanged();
        try
        {
            var verification = await TorService.VerifyAsync(CancellationToken.None);
            TorCheckMessage = (verification.IsTor ? "✅ " : "❌ ") + verification.Detail;
        }
        catch (Exception ex)
        {
            TorCheckMessage = $"❌ {ex.Message}";
        }
        finally
        {
            TorChecking = false;
        }
    }

    string NewPassword { get; set; } = string.Empty;

    ConnectionSecurity IncomingSecurityBinding
    {
        get => Account?.IncomingSecurity ?? ConnectionSecurity.SslOnConnect;
        set => SetIncomingSecurity(value);
    }

    ConnectionSecurity SmtpSecurityBinding
    {
        get => Account?.SmtpSecurity ?? ConnectionSecurity.SslOnConnect;
        set => SetSmtpSecurity(value);
    }

    void ApplyPreset(ProviderPreset preset)
    {
        if (Account is not { } account) return;
        if (account.Protocol == IncomingProtocol.Imap)
        {
            account.IncomingHost = preset.ImapHost;
            account.IncomingPort = preset.ImapPort;
            account.IncomingSecurity = preset.ImapSecurity;
        }
        else
        {
            account.IncomingHost = preset.Pop3Host;
            account.IncomingPort = preset.Pop3Port;
            account.IncomingSecurity = preset.Pop3Security;
        }
        account.SmtpHost = preset.SmtpHost;
        account.SmtpPort = preset.SmtpPort;
        account.SmtpSecurity = preset.SmtpSecurity;
        AccountStore.Save(account);
    }

    void SetProtocol(IncomingProtocol protocol)
    {
        if (Account is not { } account) return;
        account.Protocol = protocol;
        AccountStore.Save(account);
    }

    void SetIncomingHost(string host)
    {
        if (Account is not { } account) return;
        account.IncomingHost = host.Trim();
        AdoptOnionAsTorOnly(account);
        AccountStore.Save(account);
    }

    /// <summary>
    /// Typing an onion address turns the account Tor-only, because there is no other way to reach
    /// one and the direct attempt is not merely useless: it asks the system resolver for the name
    /// first, so the address — which identifies the provider exactly — leaves the machine before
    /// anything fails. The live IDLE connection is dropped for the same reason the toggle does it.
    /// </summary>
    static void AdoptOnionAsTorOnly(MailAccountData account)
    {
        if (account.TorOnly) return;
        if (!MailConnections.IsOnionHost(account.IncomingHost) && !MailConnections.IsOnionHost(account.SmtpHost)) return;

        account.TorOnly = true;
        ImapIdleService.Drop(account.Id);
        Log($"{account.EmailAddress} became Tor-only: an onion address cannot be reached any other way.");
    }

    void SetIncomingPort(string portText)
    {
        if (Account is not { } account || !int.TryParse(portText, out int port)) return;
        account.IncomingPort = port;
        AccountStore.Save(account);
    }

    void SetIncomingSecurity(ConnectionSecurity security)
    {
        if (Account is not { } account) return;
        account.IncomingSecurity = security;
        AccountStore.Save(account);
    }

    void SetSmtpHost(string host)
    {
        if (Account is not { } account) return;
        account.SmtpHost = host.Trim();
        AdoptOnionAsTorOnly(account);
        AccountStore.Save(account);
    }

    void SetSmtpPort(string portText)
    {
        if (Account is not { } account || !int.TryParse(portText, out int port)) return;
        account.SmtpPort = port;
        AccountStore.Save(account);
    }

    void SetSmtpSecurity(ConnectionSecurity security)
    {
        if (Account is not { } account) return;
        account.SmtpSecurity = security;
        AccountStore.Save(account);
    }

    void SetUsername(string username)
    {
        if (Account is not { } account) return;
        account.IncomingUsername = username.Trim();
        AccountStore.Save(account);
    }

    void UpdatePassword()
    {
        if (Account is not { } account || NewPassword.Length == 0) return;
        CredentialVault.SetPassword(account.Id, NewPassword);
        NewPassword = string.Empty;
    }

}
