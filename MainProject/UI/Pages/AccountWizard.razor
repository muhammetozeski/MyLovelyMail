@attribute [Route(RoutePath)]
@inherits MyLovelyMail.MainProject.UI.Layout.Architecture.PageBase
@inject NavigationManager Navigation
@if (!IsModal)
{
    <PageTitle>Add account — My Lovely Mail</PageTitle>
}

<div class="wizard-screen @(IsModal ? "wizard-screen--modal" : "")">
    <div class="wizard-header">
        <BackButton OnClick="@HandleBack" />
        <h1 class="wizard-title">💌 Add your mail account</h1>
        <div class="wizard-header-actions" style="margin-left:auto;display:flex;gap:8px;align-items:center;">
            <SecondaryButton OnClick="@OpenFastMailModal">⚡ Fast Mail</SecondaryButton>
            @if (IsModal)
            {
                <SecondaryButton OnClick="@(() => Services.ModalService.CloseAll())">✕</SecondaryButton>
            }
        </div>
    </div>

    <GlassCard CustomClass="wizard-card">
        <div class="wizard-section-title">Provider</div>
        <div class="wizard-presets">
            @foreach (var preset in ProviderPresets.All)
            {
                <button class="wizard-preset @(SelectedPreset == preset ? "wizard-preset--active" : "")"
                        @onclick="() => PickPreset(preset)">
                    <span class="wizard-preset-emoji">@preset.Emoji</span>
                    <span>@preset.Name</span>
                </button>
            }
        </div>
        @if (!string.IsNullOrEmpty(SelectedPreset?.Hint))
        {
            <p class="wizard-hint">💡 @SelectedPreset.Hint</p>
        }
    </GlassCard>

    <GlassCard CustomClass="wizard-card">
        <div class="wizard-section-title">Identity &amp; Folder</div>
        <div class="wizard-field">
            <span class="wizard-label">Account folder (empty places account in Main folder)</span>
            <select class="wizard-select" @bind="SelectedFolderId">
                <option value="">— Main folder (default) —</option>
                @foreach (var (folder, depth) in AccountFolderStore.GetFlattenedTree())
                {
                    <option value="@folder.Id">@(new string('—', depth)) 📁 @folder.Name</option>
                }
            </select>
        </div>
        <div class="wizard-field">
            <span class="wizard-label">Email address</span>
            <CoreInput Type="email" Placeholder="you@example.com" Icon="✉️" Value="@Email" ValueChanged="@OnEmailChanged" />
        </div>
        <div class="wizard-field">
            <span class="wizard-label">Display name (shown to recipients)</span>
            <CoreInput Placeholder="Your name" Icon="🙂" @bind-Value="DisplayName" />
        </div>
        <div class="wizard-field">
            <span class="wizard-label">Password / app password</span>
            <CoreInput Type="password" Placeholder="••••••••" Icon="🔑" @bind-Value="Password" />
        </div>
        <div class="wizard-field">
            <span class="wizard-label">Title (optional — shown in tooltip)</span>
            <CoreInput Placeholder="e.g. Shopping / GitHub / Forum" Icon="🏷️" @bind-Value="AccountTitle" />
        </div>
        <div class="wizard-field">
            <span class="wizard-label">Note (optional — multi-line note shown in tooltip)</span>
            <textarea class="wizard-select" rows="3" style="resize:vertical;font-family:inherit;"
                      placeholder="Optional notes about where this account is used..."
                      @bind="AccountNote"></textarea>
        </div>
        <div class="wizard-field">
            <span class="wizard-label">Account color (tints the workspace when this account is active)</span>
            <div class="wizard-colors">
                @foreach (var colorHex in AccountColors)
                {
                    <button class="wizard-color @(SelectedColorHex == colorHex ? "wizard-color--active" : "")"
                            style="background:@colorHex"
                            @onclick="() => SelectedColorHex = colorHex"></button>
                }
            </div>
        </div>
    </GlassCard>

    <GlassCard CustomClass="wizard-card">
        <div class="wizard-section-title">Servers</div>

        <div class="wizard-field">
            <span class="wizard-label">Receive protocol</span>
            <div class="wizard-protocols">
                <button class="wizard-preset @(Protocol == IncomingProtocol.Imap ? "wizard-preset--active" : "")"
                        @onclick="() => PickProtocol(IncomingProtocol.Imap)">📥 @IncomingProtocol.Imap.DisplayName() (recommended)</button>
                <button class="wizard-preset @(Protocol == IncomingProtocol.Pop3 ? "wizard-preset--active" : "")"
                        @onclick="() => PickProtocol(IncomingProtocol.Pop3)">📪 @IncomingProtocol.Pop3.DisplayName()</button>
            </div>
            @if (Protocol == IncomingProtocol.Pop3)
            {
                <p class="wizard-hint">💡 POP3 exposes only the Inbox — the protocol has no server folders (Sent, Spam, custom folders stay invisible). Pick IMAP to see the full folder tree.</p>
                <div class="wizard-field">
                    <div class="wizard-toggle-row">
                        <span class="wizard-label">Fetch the entire mailbox</span>
                        <CoreToggle @bind-Checked="Pop3FetchEverything" />
                    </div>
                    <span class="wizard-label">Fetch at most (newest messages)</span>
                    <CoreInput Type="number" @bind-Value="Pop3FetchLimitText" Disabled="@Pop3FetchEverything" />
                    @if (Pop3FetchEverything)
                    {
                        <p class="wizard-hint">Thousands of messages can take a while on POP3.</p>
                    }
                </div>
            }
        </div>

        <div class="wizard-grid">
            <div class="wizard-field">
                <span class="wizard-label">Incoming host (@Protocol.DisplayName())</span>
                <CoreInput Placeholder="@($"{Protocol.HostPrefix()}.example.com")" @bind-Value="IncomingHost" />
            </div>
            <div class="wizard-field wizard-field--small">
                <span class="wizard-label">Port</span>
                <CoreInput Type="number" @bind-Value="IncomingPortText" />
            </div>
            <div class="wizard-field wizard-field--small">
                <span class="wizard-label">Security</span>
                <select class="wizard-select" @bind="IncomingSecurity">
                    @foreach (var security in Enum.GetValues<ConnectionSecurity>())
                    {
                        <option value="@security">@security</option>
                    }
                </select>
            </div>
        </div>

        <div class="wizard-grid">
            <div class="wizard-field">
                <span class="wizard-label">SMTP host @(WantsTorOnly ? "(leave empty for Direct-to-MX over Tor)" : "")</span>
                <CoreInput Placeholder="smtp.example.com" @bind-Value="SmtpHost" />
            </div>
            <div class="wizard-field wizard-field--small">
                <span class="wizard-label">Port</span>
                <CoreInput Type="number" @bind-Value="SmtpPortText" />
            </div>
            <div class="wizard-field wizard-field--small">
                <span class="wizard-label">Security</span>
                <select class="wizard-select" @bind="SmtpSecurity">
                    @foreach (var security in Enum.GetValues<ConnectionSecurity>())
                    {
                        <option value="@security">@security</option>
                    }
                </select>
            </div>
        </div>

        <div class="wizard-field">
            <span class="wizard-label">Username (empty = email address)</span>
            <CoreInput Placeholder="Usually your full email address" @bind-Value="Username" />
        </div>
    </GlassCard>

    <GlassCard CustomClass="wizard-card">
        <div class="wizard-section-title">🛡️ Tor</div>
        <div class="wizard-field">
            <div class="wizard-toggle-row">
                <span class="wizard-label">Reach this account only through Tor (isolated circuit &amp; unique exit IP)</span>
                <CoreToggle @bind-Checked="TorOnly" />
            </div>
            <p class="wizard-hint">
                The server stays an ordinary one — only the route changes. Mail is fetched and sent
                through the Tor SOCKS proxy on an isolated circuit with a unique exit IP per account,
                the server name is looked up by Tor instead of by this machine, and remote images in
                this account's mail are never loaded.
            </p>
            @if (TorOnly)
            {
                <p class="wizard-hint">@TorRouteLine</p>
            }
        </div>
    </GlassCard>

    @if (TestMessage != null)
    {
        <GlassCard CustomClass="wizard-card">
            <p class="wizard-test @(TestSucceeded ? "wizard-test--ok" : "wizard-test--fail")">@TestMessage</p>
            @if (Diagnosis is { SuggestedPort: not null } suggestion)
            {
                <SecondaryButton OnClick="@(() => ApplySuggestion(suggestion))">
                    ↩️ Use port @suggestion.SuggestedPort with @suggestion.SuggestedSecurity
                </SecondaryButton>
            }
        </GlassCard>
    }

    <div class="wizard-actions">
        <SecondaryButton OnClick="@TestConnectionAsync" Disabled="@(Busy || !FormLooksComplete)">
            @if (Busy && BusyAction == "test")
            {
                <CoreSpinner SizePx="18" BorderWidthPx="2" Color="@AppColors.TextPrimary" />
            }
            🧪 Test connection
        </SecondaryButton>
        <PrimaryButton OnClick="@SaveAsync" Disabled="@(Busy || !FormLooksComplete)">
            @if (Busy && BusyAction == "save")
            {
                <CoreSpinner SizePx="18" BorderWidthPx="2" Color="@AppColors.TextOnAccent" />
            }
            💾 Save account
        </PrimaryButton>
    </div>
</div>

<AccountWizardCss />
