@namespace MyLovelyMail.MainProject.UI.Pages
@inherits ThemedComponentBase

@{
    string textPrimary = AppColors.TextPrimary.ToRgbaHex(true);
    string textSecondary = AppColors.TextSecondary.ToRgbaHex(true);
    string textMuted = AppColors.TextMuted.ToRgbaHex(true);
    string primary = AppColors.Primary.ToRgbaHex(true);
    string paneHeight = AppStyles.MailPaneHeight;
}

<style>
    .@(MailCssClasses.Reader) {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Small)px;
        min-height: @paneHeight;
    }

    .@(MailCssClasses.ReaderHeaderCard) {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px6)px;
        padding-bottom: @(AppMeasures.Space.Px6)px;
        border-image: linear-gradient(90deg, var(--account-accent, @primary), @AppColors.Accent.ToRgbaHex(true)) 1;
        border-bottom: @(AppMeasures.Border.Medium)px solid;
    }

    .@(MailCssClasses.ReaderTopRow) {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        min-width: 0;
    }

    .@(MailCssClasses.ReaderListNav) {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
        margin-left: auto;
        flex-shrink: 0;
    }

    .@(MailCssClasses.ReaderMetaRow) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.Small)px;
        color: @textSecondary;
        min-width: 0;
    }

    .@(MailCssClasses.ReaderMetaLeft) {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px8)px;
        min-width: 0;
    }

    .@(MailCssClasses.ReaderFrom) {
        font-weight: @(AppMeasures.Weight.Bold);
        color: @textPrimary;
        cursor: context-menu;
    }

    .@(MailCssClasses.ReaderDate) {
        color: @textMuted;
    }

    .@(MailCssClasses.ReaderBadgesRow) {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .@(MailCssClasses.ReaderContent) {
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Small)px;
        min-height: 0;
        flex: 1;
        animation: reader-open @(AppMeasures.Duration.Medium)s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes reader-open {
        from {
            opacity: 0;
            transform: translateX(@(AppMeasures.Space.Px24)px) scale(0.985);
        }

        to {
            opacity: 1;
            transform: translateX(0) scale(1);
        }
    }

    .@(MailCssClasses.ReaderSubject) {
        flex: 1;
        min-width: 0;
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @textPrimary;
        line-height: @(AppMeasures.LineHeight.Tight);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(MailCssClasses.ReaderTo) {
        margin-left: auto;
        font-size: @(AppMeasures.Font.Small)px;
        color: @textMuted;
        text-align: right;
        max-width: @(AppMeasures.Percent.Half)%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(MailCssClasses.ReaderToAddress) {
        cursor: context-menu;
    }

    .@(MailCssClasses.ReaderToAddress):hover {
        color: @textPrimary;
        text-decoration: underline;
    }

    .@(MailCssClasses.SearchTogglePinned) {
        border-color: @AppColors.PrimarySoftBorder.ToRgbaHex(true);
        background: @AppColors.PrimaryBadgeTint.ToRgbaHex(true);
    }

    .@(MailCssClasses.ReaderBody) {
        flex: 1 0 auto;
    }

    .@(MailCssClasses.ReaderFrame) {
        width: @(AppMeasures.Percent.Full)%;
        flex: 1 0 auto;
        height: calc(@(AppMeasures.Viewport.Full)vh - @(AppMeasures.Size.Px320)px);
        min-height: @(AppMeasures.Size.Px300)px;
        border: none;
        border-radius: @(AppMeasures.Radius.Medium)px;
        background: @AppColors.MailCanvas.Background;
        overflow-y: hidden;
    }

    .@(MailCssClasses.BodyLoading) {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: @(AppMeasures.Size.Px200)px;
    }

    .@(MailCssClasses.ReaderPreview),
    .@(MailCssClasses.ReaderNoBody) {
        margin: 0;
        text-align: left;
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
        color: @textPrimary;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .@(MailCssClasses.ReaderNoBody) {
        color: @textMuted;
        font-style: italic;
    }
</style>
