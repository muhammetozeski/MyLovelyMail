@inherits ModalBase
@using MyLovelyMail.MainProject.UI.Pages

<div class="@CoreModalCssClasses.Header">
    <span class="@CoreModalCssClasses.Title">🧾 Message Source (RFC 5322)</span>
    <div style="display:flex;align-items:center;gap:@(AppMeasures.Space.Px8)px;">
        @if (Headers.Count > 0)
        {
            <PillButton IsActive="@(!ShowRawSource)" OnClick="() => ShowRawSource = false">📋 Headers</PillButton>
            <PillButton IsActive="@ShowRawSource" OnClick="() => ShowRawSource = true">🧾 Raw MIME</PillButton>
        }
        <PillButton OnClick="CopySourceAsync">📋 Copy</PillButton>
        <button class="@CoreModalCssClasses.Close" type="button" title="Close (Esc)" @onclick="Close">✕</button>
    </div>
</div>

<div class="@MailCssClasses.Source" style="max-height:68vh;overflow:auto;">
    @if (ShowRawSource || Headers.Count == 0)
    {
        <pre class="@MailCssClasses.SourceRaw" style="margin:0;">@(EffectiveRaw.Length > 0 ? EffectiveRaw : "The message body is not cached yet — open it once while online.")</pre>
    }
    else
    {
        <div class="@MailCssClasses.SourceHeaders">
            @foreach (var (name, value) in Headers)
            {
                <div class="@MailCssClasses.SourceHeaderName">@name</div>
                <div class="@MailCssClasses.SourceHeaderValue">@value</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<(string Name, string Value)> Headers { get; set; } = [];
    [Parameter] public string RawSource { get; set; } = string.Empty;
    [Parameter] public string SourceText { get; set; } = string.Empty;

    bool ShowRawSource { get; set; }

    string EffectiveRaw => !string.IsNullOrEmpty(RawSource) ? RawSource : SourceText;

    async Task CopySourceAsync()
    {
        string text = (ShowRawSource || Headers.Count == 0)
            ? EffectiveRaw
            : string.Join('\n', Headers.Select(h => $"{h.Name}: {h.Value}"));
        await MouseActionService.RunAsync(MouseActionService.CopyAction, text);
    }

    static void Close() => ModalService.GoBack();
}
