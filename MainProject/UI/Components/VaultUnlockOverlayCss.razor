@inherits ThemedComponentBase

<style>
    .vault-overlay {
        position: fixed;
        inset: 0;
        z-index: @(AppMeasures.ZLayer.Toast);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: @(AppMeasures.Space.Large)px;
        @((MarkupString)AppStyles.BuildAuroraBackground())
    }

    .vault-card {
        width: @(AppMeasures.Percent.Full)%;
        max-width: @(AppMeasures.Size.Px360)px;
        text-align: center;
        gap: @(AppMeasures.Space.Px12)px;
    }

    .vault-card--shake {
        animation: vault-shake @(AppMeasures.Duration.Slow)s ease;
    }

    .vault-icon {
        font-size: @(AppMeasures.Font.Mega)px;
    }

    .vault-title {
        font-size: @(AppMeasures.Font.Large)px;
        font-weight: @(AppMeasures.Weight.Bold);
    }

    .vault-text {
        margin: 0;
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Normal)px;
        line-height: @(AppMeasures.LineHeight.Relaxed);
    }

    .vault-error {
        margin: 0;
        color: @AppColors.TextDanger.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
    }

    @@keyframes vault-shake {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-@(AppMeasures.Space.Px10)px); }
        40% { transform: translateX(@(AppMeasures.Space.Px10)px); }
        60% { transform: translateX(-@(AppMeasures.Space.Px6)px); }
        80% { transform: translateX(@(AppMeasures.Space.Px6)px); }
    }
</style>
