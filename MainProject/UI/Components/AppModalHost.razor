@implements IDisposable

@if (Current is { } descriptor)
{
    ModalSize effectiveSize = ResolveModalSize(descriptor);
    RenderFragment body = @<AppErrorBoundary Title="An error occurred inside this dialog"
                                            RetryText="Close Dialog"
                                            ShowReload="false"
                                            OnRecover="@HandleModalErrorClose">
        <DynamicComponent Type="@descriptor.ComponentType" Parameters="@(new Dictionary<string, object?>(descriptor.Parameters))" />
    </AppErrorBoundary>;

    if (effectiveSize == ModalSize.Wide)
    {
        <WideModal IsOpen="true" OnClose="@HandleBackdropClose">
            @body
        </WideModal>
    }
    else if (effectiveSize == ModalSize.Dialog)
    {
        <DialogModal IsOpen="true" OnClose="@HandleBackdropClose">
            @body
        </DialogModal>
    }
    else if (effectiveSize == ModalSize.Compact)
    {
        <CompactModal IsOpen="true" OnClose="@HandleBackdropClose">
            @body
        </CompactModal>
    }
    else
    {
        <WorkspaceModal IsOpen="true" OnClose="@HandleBackdropClose">
            @body
        </WorkspaceModal>
    }
}

@code {
    ModalDescriptor? Current => ModalService.Current;

    static ModalSize ResolveModalSize(ModalDescriptor descriptor)
    {
        if (descriptor.Size != ModalSize.Workspace) return descriptor.Size;
        if (descriptor.ComponentType == typeof(FastMailModal) || descriptor.ComponentType == typeof(MessageSourceModal))
            return ModalSize.Wide;
        if (descriptor.ComponentType == typeof(AccountFolderModal)
            || descriptor.ComponentType == typeof(AccountNoteModal)
            || descriptor.ComponentType == typeof(ConfirmDialogModal)
            || descriptor.ComponentType == typeof(ShortcutHelpModal))
            return ModalSize.Dialog;
        if (descriptor.ComponentType == typeof(MessageMarkersModal)
            || descriptor.ComponentType == typeof(MessageMoveModal)
            || descriptor.ComponentType == typeof(MessageSnoozeModal)
            || descriptor.ComponentType == typeof(MessageSaveModal))
            return ModalSize.Compact;
        return ModalSize.Workspace;
    }

    protected override void OnInitialized() => ModalService.OnChanged += HandleChanged;

    void HandleChanged() => InvokeAsync(StateHasChanged);

    void HandleBackdropClose() => ModalService.GoBack();

    void HandleModalErrorClose() => ModalService.CloseAll();

    public void Dispose() => ModalService.OnChanged -= HandleChanged;
}
