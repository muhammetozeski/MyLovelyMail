@namespace MyLovelyMail.MainProject.UI.Components
@inherits ThemedComponentBase

<style>
    .@(AppContextMenuCssClasses.Backdrop) {
        position: fixed;
        inset: 0;
        z-index: @(AppMeasures.ZLayer.Modal + AppMeasures.Size.Px20);
        background: transparent;
    }

    .@(AppContextMenuCssClasses.BackdropPassThrough) {
        pointer-events: none;
    }

    .@(AppContextMenuCssClasses.Panel) {
        position: fixed;
        pointer-events: auto;
        width: @(AppMeasures.Size.Px260)px;
        max-height: calc(@(AppMeasures.Viewport.Full)vh - @(AppMeasures.Space.Px24)px);
        overflow-y: auto;
        padding: @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Large)px;
        @((MarkupString)AppStyles.BuildAcrylicStyle(AcrylicLevel.Strong, AppMeasures.Blur.Strong))
        box-shadow: @AppStyles.ShadowHeavy;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
        z-index: @(AppMeasures.ZLayer.Modal + AppMeasures.Size.Px22);
        user-select: none;
        -webkit-user-select: none;
    }

    .@(AppContextMenuCssClasses.PanelDropTarget) {
        outline: @(AppMeasures.Border.Medium)px solid @AppColors.Accent.ToRgbaHex(true);
        outline-offset: @(AppMeasures.Space.Px2)px;
    }

    .@(AppContextMenuCssClasses.PanelSub) {
        z-index: @(AppMeasures.ZLayer.Modal + AppMeasures.Size.Px24);
    }

    .@(AppContextMenuCssClasses.PanelGrand) {
        z-index: @(AppMeasures.ZLayer.Modal + AppMeasures.Size.Px26);
    }

    .@(AppContextMenuCssClasses.Title) {
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @AppColors.TextMuted.ToRgbaHex(true);
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px8)px;
        border-bottom: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        margin-bottom: @(AppMeasures.Space.Px2)px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px6)px;
    }

    .@(AppContextMenuCssClasses.TitleText) {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(AppContextMenuCssClasses.TitleTools) {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
        flex-shrink: 0;
    }

    .@(AppContextMenuCssClasses.TitleToolBtn) {
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        border-radius: @(AppMeasures.Radius.Px6)px;
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px6)px;
        font-size: @(AppMeasures.Font.XSmall)px;
        cursor: pointer;
        line-height: @(AppMeasures.LineHeight.Tight);
        transition: all @(AppMeasures.Duration.Instant)s ease;
    }

    .@(AppContextMenuCssClasses.TitleToolBtn):hover,
    .@(AppContextMenuCssClasses.TitleToolBtnActive) {
        border-color: @AppColors.Primary.ToRgbaHex(true);
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        color: @AppColors.Primary.ToRgbaHex(true);
    }

    .@(AppContextMenuCssClasses.PinHint) {
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Medium);
        color: @AppColors.Primary.ToRgbaHex(true);
        opacity: @AppMeasures.Opacity.Bright;
    }

    .@(AppContextMenuCssClasses.ItemWrap) {
        position: relative;
        display: flex;
        flex-direction: column;
    }

    .@(AppContextMenuCssClasses.ItemWrapDragging) {
        opacity: @(AppMeasures.Opacity.Disabled);
    }

    .@(AppContextMenuCssClasses.ItemWrapHidden) {
        opacity: @(AppMeasures.Opacity.Disabled);
    }

    .@(AppContextMenuCssClasses.ItemWrapDropBefore)::before,
    .@(AppContextMenuCssClasses.ItemWrapDropAfter)::after {
        content: "";
        position: absolute;
        left: @(AppMeasures.Space.Px6)px;
        right: @(AppMeasures.Space.Px6)px;
        height: @(AppMeasures.Size.Px2)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: @AppColors.Accent.ToRgbaHex(true);
        box-shadow: @AppStyles.GetGlow(AppColors.Accent, 0.45f);
        pointer-events: none;
        z-index: @(AppMeasures.ZLayer.Dropdown);
    }

    .@(AppContextMenuCssClasses.ItemWrapDropBefore)::before {
        top: -@(AppMeasures.Space.Px1)px;
    }

    .@(AppContextMenuCssClasses.ItemWrapDropAfter)::after {
        bottom: -@(AppMeasures.Space.Px1)px;
    }

    .@(AppContextMenuCssClasses.ItemRow) {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px2)px;
    }

    .@(AppContextMenuCssClasses.Item) {
        flex: 1;
        min-width: 0;
        width: @(AppMeasures.Percent.Full)%;
        border: none;
        background: transparent;
        color: @AppColors.TextPrimary.ToRgbaHex(true);
        border-radius: @(AppMeasures.Radius.Medium)px;
        padding: @(AppMeasures.Space.Px5)px @(AppMeasures.Space.Px10)px;
        font-size: @(AppMeasures.Font.Small)px;
        text-align: left;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px8)px;
        transition: background @(AppMeasures.Duration.Fast)s ease;
    }

    .@(AppContextMenuCssClasses.ItemLabel) {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px6)px;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .@(AppContextMenuCssClasses.PinBadge) {
        font-size: @(AppMeasures.Font.XSmall)px;
        flex-shrink: 0;
    }

    .@(AppContextMenuCssClasses.EditTools) {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px2)px;
        flex-shrink: 0;
    }

    .@(AppContextMenuCssClasses.MiniActionBtn) {
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        border-radius: @(AppMeasures.Radius.Px6)px;
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px5)px;
        font-size: @(AppMeasures.Font.XSmall)px;
        cursor: pointer;
        transition: all @(AppMeasures.Duration.Instant)s ease;
    }

    .@(AppContextMenuCssClasses.MiniActionBtn):hover {
        border-color: @AppColors.Primary.ToRgbaHex(true);
        color: @AppColors.Primary.ToRgbaHex(true);
    }

    .@(AppContextMenuCssClasses.MiniActionBtnDanger):hover {
        border-color: @AppColors.Error.ToRgbaHex(true);
        color: @AppColors.TextDanger.ToRgbaHex(true);
    }

    .@(AppContextMenuCssClasses.PinPopover) {
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px4)px;
        display: flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
    }

    .@(AppContextMenuCssClasses.PinButton) {
        width: @(AppMeasures.Percent.Full)%;
        border: @(AppMeasures.Border.Thin)px solid @AppColors.Primary.ToRgbaHex(true);
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        color: @AppColors.TextPrimary.ToRgbaHex(true);
        border-radius: @(AppMeasures.Radius.Small)px;
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Bold);
        cursor: pointer;
        text-align: left;
    }

    .@(AppContextMenuCssClasses.Item):hover:not(:disabled),
    .@(AppContextMenuCssClasses.ItemOpen) {
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        color: @AppColors.Primary.ToRgbaHex(true);
    }

    .@(AppContextMenuCssClasses.Item):disabled {
        opacity: @AppMeasures.Opacity.Disabled;
        cursor: not-allowed;
    }

    .@(AppContextMenuCssClasses.Arrow) {
        color: @AppColors.TextMuted.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.XSmall)px;
    }

    .@(AppContextMenuCssClasses.Divider) {
        height: @(AppMeasures.Border.Thin)px;
        margin: @(AppMeasures.Space.Px3)px @(AppMeasures.Space.Px6)px;
        background: @AppColors.GlassBorderDefault.ToRgbaHex(true);
        flex-shrink: 0;
    }

    .@(AppContextMenuCssClasses.FooterBar) {
        margin-top: @(AppMeasures.Space.Px2)px;
        padding-top: @(AppMeasures.Space.Px4)px;
        border-top: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px4)px;
    }

    .@(AppContextMenuCssClasses.InputStatus) {
        position: fixed;
        top: @(AppMeasures.Space.Px12)px;
        left: @(AppMeasures.Percent.Half)%;
        transform: translateX(-@(AppMeasures.Percent.Half)%);
        z-index: @(AppMeasures.ZLayer.Toast);
        max-width: min(@(AppMeasures.Size.Px420)px, calc(@(AppMeasures.Viewport.Full)vw - @(AppMeasures.Space.Px32)px));
        padding: @(AppMeasures.Space.Px8)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        @((MarkupString)AppStyles.BuildAcrylicStyle(AcrylicLevel.Strong, AppMeasures.Blur.Normal))
        color: @AppColors.TextPrimary.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px8)px;
        box-shadow: @AppStyles.ShadowMedium;
        cursor: pointer;
        animation: app-toast-in @(AppMeasures.Duration.Fast)s ease-out;
    }

    .@(AppContextMenuCssClasses.InputStatusClose) {
        border: none;
        background: transparent;
        color: @AppColors.TextMuted.ToRgbaHex(true);
        cursor: pointer;
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px6)px;
    }

    @@keyframes app-toast-in {
        from {
            opacity: 0;
            transform: translate(-@(AppMeasures.Percent.Half)%, -@(AppMeasures.Space.Px6)px);
        }
        to {
            opacity: 1;
            transform: translate(-@(AppMeasures.Percent.Half)%, 0);
        }
    }
</style>
