@inherits ModalBase

<div class="core-modal-header">
    <span class="core-modal-title">⌨️ Keyboard Shortcuts</span>
    <button class="core-modal-close" type="button" title="Close (Esc)" @onclick="Close">✕</button>
</div>

<div class="mail-shortcut-grid">
    <kbd>j</kbd><span>Focus next message</span>
    <kbd>k</kbd><span>Focus previous message</span>
    <kbd>Enter</kbd><span>Open focused message</span>
    <kbd>c</kbd><span>New message</span>
    <kbd>r</kbd><span>Reply</span>
    <kbd>a</kbd><span>Reply all</span>
    <kbd>f</kbd><span>Forward</span>
    <kbd>e</kbd><span>Archive</span>
    <kbd>#</kbd><span>Delete / Move to Trash</span>
    <kbd>s</kbd><span>Star / Unstar</span>
    <kbd>u</kbd><span>Toggle read / unread</span>
    <kbd>/</kbd><span>Focus search</span>
    <kbd>Ctrl+1..9</kbd><span>Switch to account 1..9</span>
    <kbd>Esc</kbd><span>Close modal / cancel drag / close pane</span>
    <kbd>?</kbd><span>Show this sheet</span>
</div>

<div class="mail-modal-section-title" style="margin-top:14px;">Search operators</div>
<div class="mail-shortcut-grid">
    <kbd>from:alice</kbd><span>Sender name or address</span>
    <kbd>to:bob</kbd><span>Mail you sent to Bob</span>
    <kbd>tag:work</kbd><span>Tagged with work</span>
    <kbd>has:attachment</kbd><span>Messages with files</span>
    <kbd>is:unread</kbd><span>Also: starred, important, muted, snoozed</span>
    <kbd>newer_than:7d</kbd><span>Also: older_than: (d, w, m, y)</span>
    <kbd>after:2026-01-01</kbd><span>Also: before:, on: (yyyy-MM-dd)</span>
</div>

@code {
    static void Close() => ModalService.GoBack();
}
