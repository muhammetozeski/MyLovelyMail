@inherits ModalBase
@using MyLovelyMail.MainProject.UI.Pages

<div class="@CoreModalCssClasses.Header">
    <span class="@CoreModalCssClasses.Title">⏰ Snooze Until</span>
    <button class="@CoreModalCssClasses.Close" type="button" title="Close (Esc)" @onclick="Close">✕</button>
</div>

<div style="display:flex;flex-direction:column;gap:@(AppMeasures.Space.Px4)px;">
    @foreach (var preset in SnoozeService.Presets)
    {
        var due = preset.DueUtc();
        <button class="@MailCssClasses.MoveOption" style="display:flex;justify-content:space-between;align-items:center;gap:@(AppMeasures.Space.Px12)px;"
                type="button" @onclick="() => SnoozeAsync(due)">
            <span>@preset.Label</span>
            <span class="@MailCssClasses.SnoozeWhen">@due.ToLocalTime().ToString("ddd HH:mm", UiCulture.Display)</span>
        </button>
    }
    @if (AnySnoozed)
    {
        <button class="@MailCssClasses.MoveOption" style="margin-top:@(AppMeasures.Space.Px4)px;border-top:@(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);padding-top:@(AppMeasures.Space.Px8)px;"
                type="button" @onclick="WakeNowAsync">
            ☀️ Wake snoozed message(s) now
        </button>
    }
</div>

@code {
    [Parameter] public MailMessageIdentity[] Targets { get; set; } = [];
    [Parameter] public Action? OnChanged { get; set; }

    bool AnySnoozed => Targets
        .Select(k => MessageStore.GetSummary(k.AccountId, k.FolderFullName, k.Uid))
        .Any(static s => s?.SnoozedUntilUtc != null);

    async Task SnoozeAsync(DateTime dueUtc)
    {
        ModalService.CloseAll();
        await MouseActionService.RunMessagesAsync(MailMessageCommand.Snooze, Targets, dueUtc: dueUtc);
        OnChanged?.Invoke();
    }

    async Task WakeNowAsync()
    {
        ModalService.CloseAll();
        await MouseActionService.RunMessagesAsync(MailMessageCommand.Wake, Targets);
        OnChanged?.Invoke();
    }

    static void Close() => ModalService.GoBack();
}
