@namespace MyLovelyMail.MainProject.UI.Elements.Core

@if (IsOpen)
{
    <div class="core-modal-backdrop" style="@_backdropStyle" tabindex="-1"
         @onclick="HandleBackdropClick" @onkeydown="HandleKeyDown">
        <div class="core-modal-sheet @CustomClass" style="@_sheetStyle" @onclick:stopPropagation="true">
            @if (!string.IsNullOrWhiteSpace(Title) || ShowCloseButton)
            {
                <div class="core-modal-header">
                    <span class="core-modal-title">@Title</span>
                    @if (ShowCloseButton)
                    {
                        <button class="core-modal-close" type="button" title="Close (Esc)" @onclick="CloseAsync">✕</button>
                    }
                </div>
            }
            @ChildContent
        </div>
    </div>
}

<CoreModalCss />

@code {
    const bool ActivateCoreModalLogs = false;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool DismissOnBackdropTap { get; set; } = true;
    [Parameter] public int MaxWidthPx { get; set; } = AppMeasures.Size.Px420;
    [Parameter] public int PaddingPx { get; set; } = AppMeasures.Space.Large;
    [Parameter] public int RadiusPx { get; set; } = AppMeasures.Radius.XXLarge;
    [Parameter] public string CustomClass { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public bool ShowCloseButton { get; set; }

    string _backdropStyle => AppStyles.BuildBackdropFrost();

    string _sheetStyle =>
        $"max-width:{MaxWidthPx}px;" +
        $"padding:{PaddingPx}px;" +
        $"border-radius:{RadiusPx}px;";

    async Task HandleBackdropClick()
    {
        if (!DismissOnBackdropTap)
        {
            Log("CoreModal backdrop tap ignored (DismissOnBackdropTap=false)", Run: ActivateCoreModalLogs);
            return;
        }
        await CloseAsync();
    }

    async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && DismissOnBackdropTap)
        {
            await CloseAsync();
        }
    }

    async Task CloseAsync()
    {
        Log("CoreModal dismissed", Run: ActivateCoreModalLogs);
        await IsOpenChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
    }
}
