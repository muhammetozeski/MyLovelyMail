@inherits MyLovelyMail.MainProject.UI.Elements.Modals.ModalBase

@if (IsVisible)
{
    <div class="core-modal-backdrop" @onclick="HandleBackdropClick">
        <div class="core-modal-content @(IsWobbling ? "wobbling-animation" : "")" style="@_computedStyle" @onclick:stopPropagation>
            @ChildContent
        </div>
    </div>
}

<CoreModalCss />

@code {
    const bool ActivateModalLogs = false;

    [Parameter] public bool IsWobbling { get; set; }
    [Parameter] public bool IsAcrylic { get; set; }
    [Parameter] public bool TextAlignLeft { get; set; }

    // bu magic string değer'leri yerel nesnelere al. orneğin background bir Color nesnesine işaret etsin. public yap arkaplan gibi önemli şeyleri.
    /// <summary> Opaque elevated card surface of the modal so background text never bleeds through. </summary>
    public static Color Background => AppColors.TooltipBackground;

    /// <summary> Hairline border color of the modal card. </summary>
    public static Color BorderColor => AppColors.GlassBorderDefault;

    /// <summary> Foreground text color shared by all modal variants. </summary>
    public static Color TextColor => AppColors.TextPrimary;

    string _layoutOverrides =>
        (MaxWidthPx is { } maxW ? $"max-width:{maxW}px;" : string.Empty) +
        (TextAlignLeft ? "text-align:left;" : string.Empty);

    string _computedStyle => (IsAcrylic
        ? AppStyles.BuildAcrylicStyle(AcrylicLevel.Strong, AppMeasures.Blur.Heavy)
          + $"border-radius:{AppMeasures.Radius.XLarge}px;padding:{AppMeasures.Space.Large}px;"
          + $"color:{TextColor.ToRgbaHex(true)};"
        : $"background:{Background.ToRgbaHex(true)};"
          + $"border:{AppMeasures.Border.Thin}px solid {BorderColor.ToRgbaHex(true)};"
          + $"border-radius:{AppMeasures.Radius.XLarge}px;padding:{AppMeasures.Space.Large}px;"
          + $"box-shadow:{AppStyles.ShadowHeavy};"
          + $"color:{TextColor.ToRgbaHex(true)};") + _layoutOverrides;

    void HandleBackdropClick()
    {
        Log("CoreModal backdrop tapped, closing modal", Run: ActivateModalLogs);
        if (OnBackdropClick.HasDelegate) OnBackdropClick.InvokeAsync();
        else if (OnClose.HasDelegate) OnClose.InvokeAsync();
    }
}
