<div class="@CoreInputCssClasses.Group" style="@_groupStyle">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <span class="@CoreInputCssClasses.Icon">@Icon</span>
    }
    <input type="@Type" placeholder="@Placeholder" @bind="CurrentValue" @bind:event="oninput" required="@IsRequired" disabled="@Disabled" list="@ListId" class="@CoreInputCssClasses.Element" />
    @if (Clearable && !string.IsNullOrEmpty(CurrentValue))
    {
        <button type="button" class="@CoreInputCssClasses.Clear" title="Clear" @onclick="Clear">✕</button>
    }
    @ChildContent
</div>

<CoreInputCss />

@code {
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public bool IsRequired { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Clearable { get; set; }

    /// <summary> Id of a &lt;datalist&gt; rendered by the caller; the browser then offers its options natively (no custom dropdown, no key handling). </summary>
    [Parameter] public string? ListId { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    
    private string CurrentValue
    {
        get => Value;
        set
        {
            if (Value != value)
            {
                Value = value;
                ValueChanged.InvokeAsync(value);
            }
        }
    }

    void Clear()
    {
        CurrentValue = string.Empty;
    }

    string _groupStyle => $"background-color: {AppColors.Background.ToRgbaHex(true)}; border-radius: {AppMeasures.Radius.Medium}px;";
}
