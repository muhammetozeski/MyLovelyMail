@namespace MyLovelyMail.MainProject.UI.Elements.Core
@inherits ThemedComponentBase

<style>
    .core-modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: @(AppMeasures.Viewport.Full)vw;
        height: @(AppMeasures.Viewport.Full)vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: @(AppMeasures.Space.Medium)px;
        box-sizing: border-box;
        z-index: @(AppMeasures.ZLayer.Modal);
        animation: core-modal-fade-in @(AppMeasures.Duration.Fast)s ease-out;
        outline: none;
    }

    .core-modal-sheet {
        width: @(AppMeasures.Percent.Full)%;
        max-height: 90vh;
        overflow-y: auto;
        text-align: left;
        box-sizing: border-box;
        background: @AppColors.TooltipBackground.ToRgbaHex(true);
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        box-shadow: inset 0 @(AppMeasures.Border.Thin)px 0 @AppColors.GlassBorderTop.ToRgbaHex(true), @AppStyles.ShadowHeavy;
        animation: core-modal-pop-in @(AppMeasures.Duration.Normal)s cubic-bezier(0.16, 1, 0.3, 1);
        color: @AppColors.TextPrimary.ToRgbaHex(true);
    }

    .core-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: @(AppMeasures.Space.Px8)px;
        margin-bottom: @(AppMeasures.Space.Px12)px;
        padding-bottom: @(AppMeasures.Space.Px8)px;
        border-bottom: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
    }

    .core-modal-title {
        font-size: @(AppMeasures.Font.Medium)px;
        font-weight: @(AppMeasures.Weight.Bold);
        color: @AppColors.TextPrimary.ToRgbaHex(true);
    }

    .core-modal-close {
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        border-radius: @(AppMeasures.Radius.Small)px;
        width: @(AppMeasures.Size.Px28)px;
        height: @(AppMeasures.Size.Px28)px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: @(AppMeasures.Font.Small)px;
        transition: all @(AppMeasures.Duration.Fast)s ease;
    }

        .core-modal-close:hover {
            color: @AppColors.Primary.ToRgbaHex(true);
            border-color: @AppColors.Primary.ToRgbaHex(true);
        }

    @@keyframes core-modal-fade-in {
        from { opacity: 0; }
        to   { opacity: 1; }
    }

    @@keyframes core-modal-pop-in {
        from {
            opacity: 0;
            transform: scale(0.94) translateY(@(AppMeasures.Space.Px8)px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }
</style>
