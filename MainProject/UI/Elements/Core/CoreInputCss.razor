@inherits ThemedComponentBase
<style>
    .@(CoreInputCssClasses.Group) {
        display: flex;
        align-items: center;
        padding: 0 @(AppMeasures.Space.Px16)px;
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
    }

    .@(CoreInputCssClasses.Icon) {
        font-size: @(AppMeasures.Font.Large)px;
        opacity: @(AppMeasures.Opacity.Muted);
        margin-right: @(AppMeasures.Space.Px8)px;
    }

    .@(CoreInputCssClasses.Element) {
        flex: 1;
        border: none;
        background: transparent;
        padding: @(AppMeasures.Space.Px20)px 0;
        font-size: @(AppMeasures.Font.Normal)px;
        color: inherit;
        outline: none;
    }

        /* outline:none above kills the browser ring; keyboard focus gets one back on the wrapper,
           so the field that is listening is visible without a box drawn inside a box. */
        .@(CoreInputCssClasses.Element):focus-visible {
            outline: @(AppMeasures.Border.Medium)px solid @AppColors.Accent.ToRgbaHex(true);
            outline-offset: @(AppMeasures.Space.Px4)px;
        }

        .@(CoreInputCssClasses.Element):disabled {
            opacity: @(AppMeasures.Opacity.Disabled);
            cursor: not-allowed;
        }

    .@(CoreInputCssClasses.Clear) {
        border: none;
        background: transparent;
        color: @AppColors.TextSecondary.ToRgbaHex(true);
        cursor: pointer;
        font-size: @(AppMeasures.Font.Medium)px;
        line-height: 1;
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px6)px;
        border-radius: @(AppMeasures.Radius.Small)px;
        margin-left: @(AppMeasures.Space.Px4)px;
        transition: color @(AppMeasures.Duration.Fast)s ease, background @(AppMeasures.Duration.Fast)s ease;
    }

        .@(CoreInputCssClasses.Clear):hover {
            color: @AppColors.Primary.ToRgbaHex(true);
            background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        }
</style>
