@inherits ThemedComponentBase
<style>
    .core-input-group {
        display: flex;
        align-items: center;
        padding: 0 @(AppMeasures.Space.Px16)px;
        border: @(AppMeasures.Border.Thin)px solid @AppColors.GlassBorderDefault.ToRgbaHex(true);
    }

    .core-input-icon {
        font-size: @(AppMeasures.Font.Large)px;
        opacity: @(AppMeasures.Opacity.Muted);
        margin-right: @(AppMeasures.Space.Px8)px;
    }

    .core-input-element {
        flex: 1;
        border: none;
        background: transparent;
        padding: @(AppMeasures.Space.Px20)px 0;
        font-size: @(AppMeasures.Font.Normal)px;
        color: inherit;
        outline: none;
    }

        /* outline:none above kills the browser ring; keyboard focus gets one back on the wrapper,
           so the field that is listening is visible without a box drawn inside a box. */
        .core-input-element:focus-visible {
            outline: @(AppMeasures.Border.Medium)px solid @AppColors.Accent.ToRgbaHex(true);
            outline-offset: @(AppMeasures.Space.Px4)px;
        }

        .core-input-element:disabled {
            opacity: @(AppMeasures.Opacity.Disabled);
            cursor: not-allowed;
        }
</style>