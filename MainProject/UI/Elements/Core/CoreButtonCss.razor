@inherits ThemedComponentBase
@using MyLovelyMail.MainProject.UI.Pages
@{
    string pillTextPrimary = AppColors.TextPrimary.ToRgbaHex(true);
    string pillTextSecondary = AppColors.TextSecondary.ToRgbaHex(true);
    string pillPrimary = AppColors.Primary.ToRgbaHex(true);
    string pillDanger = AppColors.TextDanger.ToRgbaHex(true);
    string pillSurfaceTint = AppColors.SurfaceTintPrimary.ToRgbaHex(true);
    string pillGlassBorder = AppColors.GlassBorderDefault.ToRgbaHex(true);
}
<style>
    .core-btn {
        border: none;
        /* box-sizing keeps padding INSIDE the declared width so a full-width button never overflows its parent. */
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        /* text-align guards against an inherited left/right alignment from the surrounding text container. */
        text-align: center;
        cursor: pointer;
        transition: transform @(AppMeasures.Duration.Fast)s, box-shadow @(AppMeasures.Duration.Fast)s, opacity @(AppMeasures.Duration.Fast)s;
        gap: @(AppMeasures.Space.Px6)px;
        min-width: 0;
        max-width: @(AppMeasures.Percent.Full)%;
        white-space: normal;
        overflow-wrap: break-word;
        flex-wrap: wrap;
    }

        /* Full-width variant: a block-level flex box filling 100% of the parent. inline-flex shrinks to content, so it must switch to flex to actually stretch. box-sizing above keeps it inside the parent. */
        .core-btn--full {
            display: flex;
            width: @(AppMeasures.Percent.Full)%;
        }

        .core-btn:active:not(:disabled) {
            transform: scale(0.95);
        }

        .core-btn:disabled {
            opacity: @(AppMeasures.Opacity.Dim);
            cursor: not-allowed;
            box-shadow: none !important;
        }

        /* Keyboard focus only — a clicked button should not keep a ring. */
        .core-btn:focus-visible {
            outline: @(AppMeasures.Border.Medium)px solid @AppColors.Accent.ToRgbaHex(true);
            outline-offset: @(AppMeasures.Border.Thin)px;
        }

    .@(MailCssClasses.SearchToggle) {
        border: @(AppMeasures.Border.Thin)px solid @pillGlassBorder;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @pillTextSecondary;
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        cursor: pointer;
        font-size: @(AppMeasures.Font.Small)px;
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
        white-space: nowrap;
        transition: all @(AppMeasures.Duration.Fast)s ease;
    }

        .@(MailCssClasses.SearchToggle):hover:not(:disabled) {
            background: @pillSurfaceTint;
            color: @pillTextPrimary;
        }

        .@(MailCssClasses.SearchToggle):disabled {
            opacity: @(AppMeasures.Opacity.Disabled);
            cursor: not-allowed;
        }

    .@(MailCssClasses.SearchToggleIcon) {
        padding: @(AppMeasures.Space.Px4)px @(AppMeasures.Space.Px8)px;
    }

    .@(MailCssClasses.SearchToggleCompact) {
        padding: @(AppMeasures.Space.Px2)px @(AppMeasures.Space.Px8)px;
        font-size: @(AppMeasures.Font.XSmall)px;
    }

    .@(MailCssClasses.SearchToggleOn) {
        background: linear-gradient(135deg, @pillPrimary, @AppColors.Accent.ToRgbaHex(true));
        color: @AppColors.TextOnAccent.ToRgbaHex(true);
        border-color: transparent;
    }

    .@(MailCssClasses.SearchToggleDanger) {
        color: @pillDanger;
        border-color: @AppColors.TextDanger.WithAlpha(0.35f).ToRgbaHex(true);
    }

        .@(MailCssClasses.SearchToggleDanger):hover:not(:disabled) {
            background: @AppColors.TextDanger.WithAlpha(0.14f).ToRgbaHex(true);
            color: @pillDanger;
            border-color: @pillDanger;
        }
</style>
