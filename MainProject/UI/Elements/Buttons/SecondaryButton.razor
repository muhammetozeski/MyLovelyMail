<CoreButton Background="@AppColors.SurfaceDark"
            TextColor="@AppColors.TextPrimary"
            Border="@($"{AppMeasures.Border.Thin}px solid {AppColors.TextSecondary.WithAlpha(0.2f).ToRgbaHex(true)}")"
            IsFullWidth="@IsFullWidth"
            Disabled="@Disabled"
            OnClick="@OnClick"
            CustomClass="@CustomClass">
    @ChildContent
</CoreButton>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IsFullWidth { get; set; }
    [Parameter] public string CustomClass { get; set; } = string.Empty;
}