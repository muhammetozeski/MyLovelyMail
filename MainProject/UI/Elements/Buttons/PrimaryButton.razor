<CoreButton Background="@Background"
            Gradient="@(Gradient ?? (AppColors.Primary, AppColors.Accent))"
            TextColor="@(TextColor ?? AppColors.TextOnAccent)"
            Shadow="@(Shadow ?? AppStyles.ShadowPrimaryGlow)"
            IsFullWidth="@IsFullWidth"
            Disabled="@Disabled"
            OnClick="@OnClick"
            CustomClass="@CustomClass">
    @ChildContent
</CoreButton>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IsFullWidth { get; set; }
    [Parameter] public string CustomClass { get; set; } = string.Empty;
    [Parameter] public Color? Background { get; set; }
    [Parameter] public Color? TextColor { get; set; }
    [Parameter] public (Color Start, Color End)? Gradient { get; set; }
    [Parameter] public string? Shadow { get; set; }
}
