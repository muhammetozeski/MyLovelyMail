@namespace MyLovelyMail.MainProject.UI.Elements.Buttons
@inherits ThemedComponentBase

<style>
    .@(ActionBarCssClasses.Bar) {
        display: flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
        min-width: 0;
        transition: outline-color @(AppMeasures.Duration.Instant)s ease, background @(AppMeasures.Duration.Instant)s ease;
        border-radius: @(AppMeasures.Radius.Small)px;
    }

    .@(ActionBarCssClasses.BarInline) {
        display: inline-flex;
        flex-wrap: nowrap;
    }

    .@(ActionBarCssClasses.BarWrap) {
        flex-wrap: wrap;
    }

    .@(ActionBarCssClasses.BarCompact) {
        gap: @(AppMeasures.Space.Px2)px;
    }

    .@(ActionBarCssClasses.BarDropReady) {
        outline: @(AppMeasures.Border.Thin)px dashed @AppColors.Primary.ToRgbaHex(true);
        outline-offset: @(AppMeasures.Space.Px2)px;
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
    }

    .@(ActionBarCssClasses.BarDropTargeted) {
        outline: @(AppMeasures.Border.Medium)px solid @AppColors.Accent.ToRgbaHex(true);
        outline-offset: @(AppMeasures.Space.Px2)px;
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
    }

    .@(ActionBarCssClasses.Slot) {
        position: relative;
        display: inline-flex;
        align-items: center;
        user-select: none;
        -webkit-user-select: none;
        touch-action: none;
    }

    .@(ActionBarCssClasses.SlotDragging) {
        opacity: @(AppMeasures.Opacity.Disabled);
    }

    .@(ActionBarCssClasses.SlotDropBefore)::before,
    .@(ActionBarCssClasses.SlotDropAfter)::after {
        content: "";
        position: absolute;
        top: -@(AppMeasures.Space.Px2)px;
        bottom: -@(AppMeasures.Space.Px2)px;
        width: @(AppMeasures.Size.Px4)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        background: @AppColors.Accent.ToRgbaHex(true);
        box-shadow: @AppStyles.GetGlow(AppColors.Accent, 0.45f);
        pointer-events: none;
        z-index: @(AppMeasures.ZLayer.Dropdown);
    }

    .@(ActionBarCssClasses.SlotDropBefore)::before {
        left: -@(AppMeasures.Space.Px4)px;
    }

    .@(ActionBarCssClasses.SlotDropAfter)::after {
        right: -@(AppMeasures.Space.Px4)px;
    }

    .@(ActionBarCssClasses.DockPill) {
        display: inline-flex;
        align-items: center;
        gap: @(AppMeasures.Space.Px4)px;
        padding: @(AppMeasures.Space.Px3)px @(AppMeasures.Space.Px8)px;
        border-radius: @(AppMeasures.Radius.Pill)px;
        border: @(AppMeasures.Border.Thin)px dashed @AppColors.Primary.ToRgbaHex(true);
        background: @AppColors.SurfaceSubtle.ToRgbaHex(true);
        color: @AppColors.Primary.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Bold);
        white-space: nowrap;
        user-select: none;
        transition: all @(AppMeasures.Duration.Instant)s ease;
    }

    .@(ActionBarCssClasses.DockPillActive) {
        border-style: solid;
        border-color: @AppColors.Accent.ToRgbaHex(true);
        background: @AppColors.SurfaceTintPrimary.ToRgbaHex(true);
        color: @AppColors.TextPrimary.ToRgbaHex(true);
        box-shadow: @AppStyles.GetGlow(AppColors.Accent, 0.3f);
    }

    .@(ActionBarCssClasses.DockPillDanger) {
        border-color: @AppColors.Error.ToRgbaHex(true);
        color: @AppColors.TextDanger.ToRgbaHex(true);
    }

    .@(ActionBarCssClasses.DockPillDangerActive) {
        border-style: solid;
        border-color: @AppColors.Error.ToRgbaHex(true);
        background: @AppColors.Error.WithAlpha(0.16f).ToRgbaHex(true);
        color: @AppColors.TextDanger.ToRgbaHex(true);
    }

    .@(ActionBarCssClasses.Ghost) {
        position: fixed;
        pointer-events: none;
        z-index: @(AppMeasures.ZLayer.Effect);
        display: inline-flex;
        flex-direction: column;
        gap: @(AppMeasures.Space.Px2)px;
        padding: @(AppMeasures.Space.Px6)px @(AppMeasures.Space.Px12)px;
        border-radius: @(AppMeasures.Radius.Medium)px;
        border: @(AppMeasures.Border.Thin)px solid @AppColors.Primary.ToRgbaHex(true);
        background: @AppColors.TooltipBackground.ToRgbaHex(true);
        color: @AppColors.TextPrimary.ToRgbaHex(true);
        font-size: @(AppMeasures.Font.Small)px;
        font-weight: @(AppMeasures.Weight.Bold);
        box-shadow: @AppStyles.ShadowHeavy;
        white-space: nowrap;
        transform: translate(@(AppMeasures.Space.Px12)px, @(AppMeasures.Space.Px12)px);
    }

    .@(ActionBarCssClasses.GhostHint) {
        font-size: @(AppMeasures.Font.XSmall)px;
        font-weight: @(AppMeasures.Weight.Normal);
        color: @AppColors.TextSecondary.ToRgbaHex(true);
    }
</style>
