<CoreButton Gradient="@((AppColors.Error, AppColors.ErrorDark))"
            TextColor="@AppColors.TextOnDanger"
            Shadow="@AppStyles.ShadowErrorGlow"
            IsFullWidth="@IsFullWidth"
            Disabled="@Disabled"
            OnClick="@OnClick"
            FontSize="@FontSize"
            Padding="@Padding"
            CustomClass="@CustomClass">
    @ChildContent
</CoreButton>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IsFullWidth { get; set; }
    [Parameter] public string CustomClass { get; set; } = string.Empty;
    [Parameter] public int FontSize { get; set; } = AppMeasures.Font.Medium;
    [Parameter] public string Padding { get; set; } = AppMeasures.Space.Medium + "px";
}