@namespace MyLovelyMail.MainProject.UI.Elements.Modals

<CoreModal IsOpen="@IsOpen"
           IsOpenChanged="@IsOpenChanged"
           OnClose="@OnClose"
           DismissOnBackdropTap="@DismissOnBackdropTap"
           MaxWidthPx="@AppMeasures.Size.Px640"
           PaddingPx="@AppMeasures.Space.Large"
           RadiusPx="@AppMeasures.Radius.XXLarge"
           Title="@Title"
           ShowCloseButton="@ShowCloseButton"
           CustomClass="@($"workspace-modal {CustomClass}".Trim())">
    @ChildContent
</CoreModal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool DismissOnBackdropTap { get; set; } = true;
    [Parameter] public string CustomClass { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public bool ShowCloseButton { get; set; }
}
